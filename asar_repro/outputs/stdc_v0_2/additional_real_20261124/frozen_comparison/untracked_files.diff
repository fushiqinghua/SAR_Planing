+    except Exception as exc:
+        pre.update(status='blocked', error=str(exc), traceback=traceback.format_exc())
+    finally:
+        pre['wall_s'] = perf_counter() - tic
+        save(run / 'preflight.json', pre)
+        update_summary(run)
