+def test_anchors_share_expansion_budget_and_advance_round_robin():
+    grid, cfg, initial = toy_case("static")
+    cfg["q"] = 0.0
+    result = midpoint.search_midpoint(grid, **cfg, initial_path=initial, anchor_depths=(0, 2),
