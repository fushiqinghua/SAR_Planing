+                delta_J=r['J']-b['J'],delta_Pd=r['Pd_T']-b['Pd_T'],J_reduction_percent=100*(b['J']-r['J'])/b['J'] if b['J'] else None,
+                time_ratio=r['search_wall_s']/b['search_wall_s']))
