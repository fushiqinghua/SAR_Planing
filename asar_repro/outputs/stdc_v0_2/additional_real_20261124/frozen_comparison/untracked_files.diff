+@pytest.mark.parametrize("mode", BOUND_MODES)
+@pytest.mark.parametrize("guide_weight", [1.0, 1.04, 1.1])
+def test_seed213_real_paper_order_can_improve_beyond_first_goal(mode, guide_weight):
