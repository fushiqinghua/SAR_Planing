+    assert h(0, 2, p) == math.inf  # Wrong endpoint at terminal depth.
+    assert h(1, 2, p) == 0.0
+    single = WindowHeuristic(GridGraph(1, 1), end_vertex=0, end_depth=1, q=0.0,
