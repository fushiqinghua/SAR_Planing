+    result = LookaheadBound(grid, budget=2, q=1, motion=motion).evaluate(0, 0, weights)
+    # No t0 observation: M1=.8, M2=.7; the four special bins retain .7.
+    assert result.value == pytest.approx(1.5, abs=1e-12, rel=0)
