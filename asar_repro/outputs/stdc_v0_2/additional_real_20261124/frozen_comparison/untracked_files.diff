+def cheap_bad_first_branch():
+    grid = GridGraph(2, 2)
+    cfg = dict(start=0, budget=2, p=np.array([0.0, 0.1, 0.8, 0.1]),
+               q=1.0, motion=MatrixMotion.identity(4))
+    return grid, cfg
