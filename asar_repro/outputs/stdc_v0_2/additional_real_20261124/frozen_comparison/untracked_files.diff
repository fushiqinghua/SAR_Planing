+    return SurfaceField('current',times,mesh,values,files,
+        dict(vector_basis='geographic_east_north',native_variables=['u_sur','v_sur'],
+             spatial_method='native two-face mean at rho; angle rotation at rho; native-topology triangular interpolation',
+             rotation='east=cos(angle)*u-sin(angle)*v; north=sin(angle)*u+cos(angle)*v',
+             rho_crop=[j0+1,j1-1,i0+1,i1-1],wet_policy='static AND dynamic masks on rho/u/v; mixed or unsupported stencil unknown',
+             original_parent_files_reverified_locally=False,roi_lon_lat=roi),max_gap_s=3600)
+
+
+def load_additional_forcing(root, name, *, window=None):
+    root=Path(root);case=checked_sources(root,name)
+    wind=wind_field(root,case)
+    current=hycom_field(root,case['current']['local_files']) if name=='arctic_ocean' else gomofs_field(root,case['current']['local_files'],case)
+    return HistoricalForcing(wind,current,case['requested_window_utc'] if window is None else window,'historical_real'),case

diff --git a/asar_repro/src/asar_repro/anytime_search.py b/asar_repro/src/asar_repro/anytime_search.py
new file mode 100644
index 0000000..c76f6b1
--- /dev/null
+++ b/asar_repro/src/asar_repro/anytime_search.py
@@ -0,0 +1,209 @@
+"""Paper-guided anytime search with a separate, lazy admissible pruning bound.
+
+The paper heuristic orders OPEN only. It never prunes or terminates search.
+Every path retains its own belief; no depth/vertex or exact-state merging is
+performed. Complete improving candidates are replayed before acceptance.
+Results deliberately carry no full-route epsilon certificate.
+"""
+from dataclasses import dataclass, field
+from heapq import heappop, heappush
+from itertools import count
+from math import inf, isfinite
+from time import perf_counter
+
+from .belief import initial_belief, sensor_probabilities
+from .grid import integer
+from .heuristic import Heuristic
+from .objective import score_path
+
+ATOL = 1e-10
+BOUND_MODES = ("zero", "mass_lb", "stdc_lb")
+
+
+@dataclass
+class AnytimeResult:
+    path: tuple | None
+    J: float | None
+    Pd: float | None
+    expanded: int
+    generated: int
+    pruned: int
+    peak_open: int
+    status: str
+    stop_reason: str | None
+    incumbent_source: str | None
+    guide_weight: float
+    bound_mode: str
+    theory_certified: bool = False
+    incumbent_history: list = field(default_factory=list)
+    stats: dict = field(default_factory=dict)
+    wall_s: float = 0.0
+    completion_reason: str | None = None
+
+
+def search_anytime(grid, *, start, budget, p, q, motion, initial_path=None,
+                   guide_weight=1.04, bound_mode="stdc_lb", max_expansions=None,
+                   max_seconds=None, max_open=None, trace=None):
+    """Continue past every goal; prune only with unweighted g + h_bound.
+
+    Limits cover initial/final replay, guides, lazy bounds and successor work.
+    Time is cooperative: replay a just-generated potential improvement even
+    at the deadline, then preserve it when stopping. Expanded counts actual
+    successor expansions, excluding popped nodes rejected by the bound.
+    """
+    started = perf_counter()
+    budget = integer(budget, "budget")
+    grid.coordinates(start)
+    if bound_mode not in BOUND_MODES:
+        raise ValueError("bound_mode must be zero, mass_lb or stdc_lb")
+    if not isfinite(guide_weight) or guide_weight < 1:
+        raise ValueError("guide_weight must be finite and >= 1")
+    for name, value in (("max_expansions", max_expansions), ("max_open", max_open)):
+        if value is not None:
+            integer(value, name)
+    if max_seconds is not None and (not isfinite(max_seconds) or max_seconds < 0):
+        raise ValueError("max_seconds must be finite and nonnegative")
+    deadline = inf if max_seconds is None else started + max_seconds
+    cfg = dict(start=start, budget=budget, p=p, q=q, motion=motion)
+    guide = Heuristic(grid, budget=budget, q=q, motion=motion, mode="paper_greedy")
+    bound = Heuristic(grid, budget=budget, q=q, motion=motion, mode=bound_mode)
+    sensor = sensor_probabilities(q, grid.size)
+    root_belief = initial_belief(p, motion.state_size)
+    queue, history, sequence = [], [], count()
+    expanded = generated = pruned = peak_open = 0
+    incumbent, incumbent_pd, best_path, source = inf, None, None, None
+    stats = dict(guide_calls=0, guide_wall_s=0.0, bound_calls=0, bound_wall_s=0.0,
+                 complete_candidates=0, candidate_replays=0, candidate_replay_wall_s=0.0,
+                 candidate_replay_error_J_max=0.0, candidate_replay_error_Pd_max=0.0,
+                 initial_replays=0, final_replays=0, replay_wall_s=0.0,
+                 accepted_improvements=0, popped=0, bound_pruned=0, cheap_pruned=0,
+                 max_generated_depth=0, max_expanded_depth=0,
+                 guide_used_for_pruning=False, guide_used_for_termination=False,
+                 state_merging=False, bound_is_unweighted=True,
+                 frontier_count_scope="physical queued nodes only; interrupted work is not enumerated")
+
+    def timed_out():
+        return "max_seconds" if perf_counter() >= deadline else None
+
+    def record(event, path, g, **extra):
+        if trace is not None:
+            trace(dict(event=event, vertex=path[-1], depth=len(path)-1, path=path,
+                       g=g, incumbent_J=None if best_path is None else incumbent, **extra))
+
+    def replay(path, kind):
+        tic = perf_counter()
+        result = score_path(grid, path, **cfg)
+        elapsed = perf_counter() - tic
+        stats[kind + "_replays"] += 1
+        stats["replay_wall_s"] += elapsed
+        if kind == "candidate":
+            stats["candidate_replay_wall_s"] += elapsed
+        return result
+
+    def accept(path, score, origin):
+        nonlocal incumbent, incumbent_pd, best_path, source
+        incumbent, incumbent_pd, best_path, source = score.J, score.pd_final, tuple(path), origin
+        history.append(dict(path=best_path, J=incumbent, Pd=incumbent_pd,
+                            expanded=expanded, generated=generated,
+                            elapsed_s=perf_counter()-started, source=origin))
+        record("incumbent", best_path, incumbent, source=origin)
+
+    def enqueue(path, belief, g):
+        nonlocal generated, pruned, peak_open
+        depth = len(path)-1
+        generated += int(depth > 0)
+        stats["max_generated_depth"] = max(stats["max_generated_depth"], depth)
+        if depth == budget:
+            stats["complete_candidates"] += 1
+            record("candidate", path, g)
+            # Conservative prediction guard; acceptance uses only replayed J.
+            if g < incumbent + ATOL:
+                score = replay(path, "candidate")
+                err_j, err_pd = abs(score.J-g), abs(score.pd_final-(1-float(belief.sum())))
+                if err_j > ATOL or err_pd > ATOL:
+                    raise AssertionError("complete candidate disagrees with independent replay")
+                stats["candidate_replay_error_J_max"] = max(stats["candidate_replay_error_J_max"], err_j)
+                stats["candidate_replay_error_Pd_max"] = max(stats["candidate_replay_error_Pd_max"], err_pd)
+                if score.J < incumbent - ATOL:
+                    stats["accepted_improvements"] += 1
+                    accept(path, score, "search")
+            return timed_out()  # Terminal candidates never enter OPEN.
+        if timed_out():
+            return "max_seconds"
+        if g >= incumbent + ATOL:
+            pruned += 1
+            stats["cheap_pruned"] += 1
+            record("cheap_prune", path, g)
+            return timed_out()
+        tic = perf_counter()
+        h_guide = guide(path[-1], depth, belief)
+        stats["guide_calls"] += 1
+        stats["guide_wall_s"] += perf_counter()-tic
+        priority = g + guide_weight*h_guide
+        if not isfinite(h_guide) or h_guide < -ATOL or not isfinite(priority):
+            raise ValueError("invalid or overflowing paper guide priority")
+        if timed_out():
+            return "max_seconds"
+        if max_open is not None and len(queue) >= max_open:
+            return "max_open"  # Stop the whole search; never drop a node and continue.
+        heappush(queue, (priority, next(sequence), path, belief, g))
+        peak_open = max(peak_open, len(queue))
+        record("push", path, g, h_guide=h_guide, f_guide=priority)
+        return timed_out()
+
+    if initial_path is not None:
+        initial_path = tuple(initial_path)
+        accept(initial_path, replay(initial_path, "initial"), "initial_path")
+    reason = enqueue((start,), root_belief, 0.0)
+    while queue and reason is None:
+        reason = timed_out()
+        if reason:
+            break
+        priority, _, path, belief, g = heappop(queue)
+        depth = len(path)-1
+        stats["popped"] += 1
+        record("pop", path, g, f_guide=priority)
+        reason = timed_out()
+        if reason:
+            break
+        tic = perf_counter()
+        h_bound = bound(path[-1], depth, belief)  # Lazy: never evaluate on enqueue.
+        stats["bound_calls"] += 1
+        stats["bound_wall_s"] += perf_counter()-tic
+        if not isfinite(h_bound) or h_bound < -ATOL:
+            raise ValueError("invalid admissible bound")
+        reason = timed_out()
+        if reason:
+            break
+        if g+h_bound >= incumbent+ATOL:
+            pruned += 1
+            stats["bound_pruned"] += 1
+            record("bound_prune", path, g, h_bound=h_bound, lower_bound=g+h_bound)
+            continue
+        if max_expansions is not None and expanded >= max_expansions:
+            reason = "max_expansions"
+            break
+        expanded += 1
+        stats["max_expanded_depth"] = max(stats["max_expanded_depth"], depth)
+        record("expand", path, g, h_bound=h_bound, lower_bound=g+h_bound)
+        prior = motion.propagate(belief, step=depth+1)
+        for vertex in grid.neighbors(path[-1]):
+            child = motion.sense(prior, vertex, sensor, depth+1)
+            reason = enqueue(path+(vertex,), child, g+float(child.sum()))
+            if reason:
+                break
+    if best_path is None and reason is None:
+        raise ValueError("no feasible path of the requested length")
+    if best_path is not None:
+        final = replay(best_path, "final")
+        if abs(final.J-incumbent) > ATOL or abs(final.pd_final-incumbent_pd) > ATOL:
+            raise AssertionError("final incumbent replay mismatch")
+        incumbent, incumbent_pd = final.J, final.pd_final
+    reason = reason or timed_out()
+    wall = perf_counter()-started
+    stats.update(frontier_remaining=len(queue), deadline_overshoot_s=max(0.0, started+wall-deadline))
+    return AnytimeResult(best_path, incumbent if best_path is not None else None, incumbent_pd,
+                         expanded, generated, pruned, peak_open,
+                         "budget_exceeded" if reason else "completed", reason, source,
+                         guide_weight, bound_mode, incumbent_history=history, stats=stats, wall_s=wall,
+                         completion_reason=None if reason else "frontier_exhausted_at_tolerance")

diff --git a/asar_repro/src/asar_repro/lookahead_bound.py b/asar_repro/src/asar_repro/lookahead_bound.py
new file mode 100644
index 0000000..94d3037
--- /dev/null
+++ b/asar_repro/src/asar_repro/lookahead_bound.py
@@ -0,0 +1,216 @@
+"""Budget-aware, admissible finite-prefix lifting of the existing STDC bound.
+
+For k=min(steps, T-depth), enumerate EVERY legal k-step continuation and let
+L_k be the minimum of its exact cost plus the unchanged STDC tail bound.
+max(H_STDC, L_k) is admissible. Partial enumeration is never a lower bound:
+an interruption discards its minimum and returns a previously completed bound.
+
+The mass/STDC/lookahead cascade may stop when an already safe bound reaches a
+caller-supplied cutoff. All auxiliary node expansions are reported separately;
+the caller must charge them to its shared work ledger. No result here grants
+a global epsilon certificate.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from math import inf, isfinite, isnan
+from time import perf_counter
+
+from .belief import sensor_probabilities, undetected_mass
+from .grid import GridGraph, integer
+from .heuristic import Heuristic
+from .motion import MatrixMotion, ParticleMotion
+
+
+@dataclass(frozen=True)
+class LookaheadEvaluation:
+    """A safe remaining-cost lower bound and the work used to obtain it.
+
+    value=inf with stage='infeasible' means no legal completion; it is not an
+    invalid numerical bound. lookahead_value is None unless every leaf was
+    evaluated. completed enumeration does not imply exact optimality unless
+    the lookahead reaches T, and never implies a full-route epsilon guarantee.
+    """
+
+    value: float
+    base_value: float
+    lookahead_value: float | None
+    stage: str
+    status: str
+    stop_reason: str | None
+    aux_expanded: int
+    aux_generated: int
+    leaf_evaluations: int
+    cutoff_reached: bool
+    lookahead_completed: bool
+    mass_evaluations: int
+    stdc_evaluations: int
+    wall_s: float
+
+
+class _Interrupted(Exception):
+    def __init__(self, reason):
+        self.reason = reason
+
+
+class LookaheadBound:
+    """Fixed discrete model with on-demand mass -> STDC -> exact-prefix stages.
+
+    Motion uses absolute depth+i; graph reachability uses actual legal moves.
+    Input beliefs are unnormalized undetected weights and are never modified.
+    Only existing STDC geometry is cached; no belief-dependent value is cached.
+
+    max_aux_expansions is a per-call cap supplied from the caller's remaining
+    shared work budget. It counts each auxiliary internal node whose successors
+    are evaluated, including the lookahead root. Terminal leaf tail-bound work
+    is timed and counted separately, and is not free in the wall-time budget.
+    The exact singleton/no-successor check needs no auxiliary tree expansion.
+    """
+
+    def __init__(self, grid: GridGraph, *, budget: int, q,
+                 motion: MatrixMotion | ParticleMotion, steps: int = 2):
+        if not isinstance(motion, (MatrixMotion, ParticleMotion)):
+            raise ValueError("lookahead requires MatrixMotion or ParticleMotion")
+        self.grid = grid
+        self.budget = integer(budget, "budget")
+        self.steps = integer(steps, "steps", minimum=1)
+        if grid.size != motion.size:
+            raise ValueError("motion grid size must match the search grid")
+        if isinstance(motion, ParticleMotion):
+            motion.check_horizon(self.budget)
+        elif not motion._repeat and self.budget > len(motion._matrices):
+            raise ValueError(f"missing P_t for step {self.budget}")
+        self.motion = motion
+        self.q = sensor_probabilities(q, grid.size).copy()
+        self.q.setflags(write=False)
+        self._mass = Heuristic(grid, budget=self.budget, q=self.q,
+                               motion=motion, mode="mass_lb")
+        self._stdc = Heuristic(grid, budget=self.budget, q=self.q,
+                               motion=motion, mode="stdc_lb")
+        self.stats = dict(calls=0, mass_evaluations=0, stdc_evaluations=0,
+                          aux_expanded=0, aux_generated=0, leaf_evaluations=0,
+                          lookahead_completed=0, lookahead_interrupted=0,
+                          mass_cutoffs=0, stdc_cutoffs=0, lookahead_cutoffs=0,
+                          deadline_interruptions=0, work_interruptions=0,
+                          terminal_calls=0, infeasible_calls=0, wall_s=0.0)
+
+    def evaluate(self, vertex: int, depth: int, belief, *, cutoff=inf,
+                 deadline=inf, max_aux_expansions=None) -> LookaheadEvaluation:
+        """Return a safe bound even when finite-prefix enumeration is interrupted.
+
+        deadline is an absolute perf_counter timestamp, not a duration.
+        cutoff is an already tolerance-adjusted remaining-cost threshold; this
+        class does not add a tolerance to any mathematical lower bound.
+        An expired call returns the cheap mass bound with an explicit stop.
+        """
+        started = perf_counter()
+        self.grid.coordinates(vertex)
+        vertex = int(vertex)
+        depth = integer(depth, "depth")
+        if depth > self.budget:
+            raise ValueError("depth exceeds search budget")
+        b = undetected_mass(belief, self.motion.state_size)
+        cutoff, deadline = float(cutoff), float(deadline)
+        if isnan(cutoff) or isnan(deadline):
+            raise ValueError("cutoff and deadline must not be NaN")
+        if max_aux_expansions is not None:
+            max_aux_expansions = integer(max_aux_expansions, "max_aux_expansions")
+        remaining = self.budget - depth
+        counts = dict(aux_expanded=0, aux_generated=0, leaf_evaluations=0,
+                      mass_evaluations=0, stdc_evaluations=0)
+        lookahead_started = False
+
+        def finish(value, base, *, stage, status="completed", reason=None,
+                   lifted=None, complete=False):
+            elapsed = perf_counter() - started
+            reached = value >= cutoff
+            result = LookaheadEvaluation(float(value), float(base), lifted, stage,
+                status, reason, counts["aux_expanded"], counts["aux_generated"],
+                counts["leaf_evaluations"], reached, complete,
+                counts["mass_evaluations"], counts["stdc_evaluations"], elapsed)
+            self.stats["calls"] += 1
+            for key, value in counts.items():
+                self.stats[key] += value
+            self.stats["wall_s"] += elapsed
+            if stage in ("terminal", "infeasible"):
+                self.stats[stage + "_calls"] += 1
+            if status == "cutoff":
+                self.stats[stage + "_cutoffs"] += 1
+            if complete:
+                self.stats["lookahead_completed"] += 1
+            if status == "interrupted":
+                self.stats["lookahead_interrupted"] += int(lookahead_started)
+                self.stats["deadline_interruptions" if reason == "max_seconds"
+                           else "work_interruptions"] += 1
+            return result
+
+        def time_check():
+            if perf_counter() >= deadline:
+                raise _Interrupted("max_seconds")
+
+        def checked_stdc(v, d, state):
+            counts["stdc_evaluations"] += 1
+            value = float(self._stdc(v, d, state))
+            if not isfinite(value) or value < 0:
+                raise ValueError("STDC returned an invalid bound on a feasible prefix")
+            return value
+
+        if remaining == 0:
+            return finish(0.0, 0.0, stage="terminal")
+        if not self.grid.neighbors(vertex):
+            # No-wait rectangular singleton: every positive-horizon completion
+            # is infeasible. Infinity is the exact remaining cost convention.
+            return finish(inf, inf, stage="infeasible")
+        counts["mass_evaluations"] += 1
+        base = float(self._mass(vertex, depth, b))
+        if not isfinite(base) or base < 0:
+            raise ValueError("mass bound must be finite and nonnegative")
+        stage = "mass"
+        try:
+            time_check()
+            if base >= cutoff:
+                return finish(base, base, stage=stage, status="cutoff")
+            base = max(base, checked_stdc(vertex, depth, b))
+            stage = "stdc"
+            time_check()
+            if base >= cutoff:
+                return finish(base, base, stage=stage, status="cutoff")
+            lookahead_started = True
+            limit = min(self.steps, remaining)
+            minimum = inf
+
+            def enumerate_prefix(v, d, state, cost, steps_left):
+                nonlocal minimum
+                time_check()
+                if steps_left == 0:
+                    counts["leaf_evaluations"] += 1
+                    tail = 0.0 if d == self.budget else checked_stdc(v, d, state)
+                    time_check()
+                    value = cost + tail
+                    if not isfinite(value):
+                        raise ValueError("lookahead cost overflow")
+                    minimum = min(minimum, value)
+                    return
+                if (max_aux_expansions is not None
+                        and counts["aux_expanded"] >= max_aux_expansions):
+                    raise _Interrupted("max_aux_expansions")
+                counts["aux_expanded"] += 1
+                t = d + 1
+                prior = self.motion.propagate(state, step=t)
+                for nxt in self.grid.neighbors(v):
+                    time_check()
+                    child = self.motion.sense(prior, nxt, self.q, t)
+                    counts["aux_generated"] += 1
+                    enumerate_prefix(nxt, t, child, cost + float(child.sum()), steps_left - 1)
+
+            enumerate_prefix(vertex, depth, b, 0.0, limit)
+            time_check()
+            value = max(base, minimum)
+            return finish(value, base, stage="lookahead",
+                          status="cutoff" if value >= cutoff else "completed",
+                          lifted=float(minimum), complete=True)
+        except _Interrupted as interrupted:
+            # Deliberately discard every partially enumerated leaf/minimum.
+            # The unexplored branch may be strictly cheaper than all seen ones.
+            return finish(base, base, stage=stage, status="interrupted",
+                          reason=interrupted.reason)

diff --git a/asar_repro/src/asar_repro/midpoint_rollout.py b/asar_repro/src/asar_repro/midpoint_rollout.py
new file mode 100644
index 0000000..d904eaa
--- /dev/null
+++ b/asar_repro/src/asar_repro/midpoint_rollout.py
@@ -0,0 +1,480 @@
+"""Uncertified, diverse beam suffix proposals from detection-event anchors.
+
+Every anchor fixes an incumbent prefix at its original absolute time, then
+regrows the entire remaining suffix with a free endpoint. Anchors advance one
+layer per round in deterministic round-robin order. A separate admissible
+bound may prune, while the paper guide and diversity keys only select beam
+proposals. Beam losses are reported separately from safe pruning.
+
+All accepted/final paths use the unchanged full-route scorer and min-J goal.
+Compression requires an exactly matching original replay model. Neither
+completion nor a wide beam creates a global epsilon certificate.
+"""
+
+from collections import deque
+from dataclasses import dataclass, field
+from itertools import count
+from math import inf, isfinite
+from time import perf_counter
+
+import numpy as np
+
+from .belief import sensor_probabilities
+from .grid import integer
+from .heuristic import Heuristic
+from .motion import MatrixMotion, ParticleMotion
+from .objective import score_path
+from .research_particle import FutureEquivalentMotion, ParticleGuide
+
+
+ATOL = 1e-10
+
+
+@dataclass
+class MidpointResult:
+    path: tuple
+    J: float
+    Pd: float
+    expanded: int
+    generated: int
+    pruned: int
+    peak_open: int
+    status: str
+    stop_reason: str | None
+    incumbent_source: str
+    bound_mode: str
+    guide_weight: float
+    theory_certified: bool = False
+    incumbent_history: list = field(default_factory=list)
+    stats: dict = field(default_factory=dict)
+    anchors: list = field(default_factory=list)
+    candidate_archive: list = field(default_factory=list)
+    wall_s: float = 0.0
+    completion_reason: str | None = None
+
+    @property
+    def history(self):
+        return self.incumbent_history
+
+
+@dataclass
+class _Node:
+    path: tuple
+    belief: np.ndarray
+    g: float
+    lower: float
+    priority: float
+    sequence: int
+    last_hit_vertex: int
+    last_hit_depth: int
+    direction: int
+
+    @property
+    def depth(self):
+        return len(self.path)-1
+
+
+class _FutureDetectable:
+    """Geometry/motion eligibility for a diversity representative only.
+
+    A particle is eligible iff at some future absolute frame it occupies a
+    positive-q searchable cell exactly reachable from the current vertex.
+    Permanent special-bin columns are excluded from the KEY, never from belief
+    or scoring. Matrix states use positive transition support backwards from
+    the same future searchable sets. No key merges or prunes a search state.
+    """
+
+    def __init__(self, grid, *, budget, q, motion):
+        self.grid, self.budget, self.motion = grid, budget, motion
+        self.q = sensor_probabilities(q, grid.size).copy()
+        self.cache, self.distances = {}, {}
+
+    def eligible(self, vertex, depth):
+        key = (vertex, depth)
+        if key in self.cache:
+            return self.cache[key]
+        if vertex not in self.distances:
+            self.distances[vertex] = self.grid.distances_from(vertex)
+        distances = self.distances[vertex]
+        if depth == self.budget or self.grid.size == 1:
+            mask = np.zeros(self.motion.state_size, dtype=bool)
+        elif isinstance(self.motion, ParticleMotion):
+            cells = self.motion.cell_ids[depth+1:self.budget+1]
+            searchable = cells < self.grid.size
+            safe_cells = np.minimum(cells, self.grid.size-1)
+            distance = distances[safe_cells]
+            steps = np.arange(1, len(cells)+1)[:, None]
+            mask = np.any(searchable & (self.q[safe_cells] > 0)
+                          & (distance <= steps) & ((steps-distance) % 2 == 0), axis=0)
+        elif isinstance(self.motion, MatrixMotion):
+            mask = np.zeros(self.grid.size, dtype=bool)
+            for t in range(self.budget, depth, -1):
+                k = t-depth
+                future_cell = (self.q > 0) & (distances <= k) & ((k-distances) % 2 == 0)
+                kernel = self.motion._matrices[0 if self.motion._repeat else t-1]
+                mask = np.asarray(kernel @ (future_cell | mask).astype(float)).ravel() > 0
+        else:
+            raise ValueError("diversity requires MatrixMotion or ParticleMotion")
+        mask.setflags(write=False)
+        self.cache[key] = mask
+        return mask
+
+    def representative(self, vertex, depth, belief):
+        eligible = self.eligible(vertex, depth) & (belief > 0)
+        if not np.any(eligible):
+            return -1
+        return int(np.argmax(np.where(eligible, belief, -1.0)))
+
+    def signatures(self, node):
+        representative = self.representative(node.path[-1], node.depth, node.belief)
+        primary = (representative, node.last_hit_vertex)
+        secondary = primary + (node.direction, min(4, node.depth-node.last_hit_depth))
+        return primary, secondary
+
+
+def _direction(grid, previous, vertex):
+    r0, c0 = grid.coordinates(previous)
+    r1, c1 = grid.coordinates(vertex)
+    return {(-1, 0): 0, (0, 1): 1, (1, 0): 2, (0, -1): 3}[(r1-r0, c1-c0)]
+
+
+def _choose_anchors(initial, horizon, anchor_depths):
+    if anchor_depths is not None:
+        depths = tuple(integer(a, "anchor depth") for a in anchor_depths)
+        if not depths or len(set(depths)) != len(depths) or any(a > horizon for a in depths):
+            raise ValueError("anchor_depths must be nonempty, unique, and within [0,T]")
+        return depths, [dict(a=a, policy="explicit") for a in depths]
+    # The final detected mass is observed under the initial route, not inferred
+    # from a particular real scenario. Record every selected event/threshold.
+    detected = np.maximum(0.0, initial.survival[0]-initial.survival)
+    final_detected = float(detected[-1])
+    if horizon == 0 or final_detected <= ATOL:
+        return (0,), [dict(a=0, policy="zero_detection_or_zero_horizon_fallback")]
+    records, depths = [], []
+    for fraction in (0.25, 0.5, 0.75):
+        event = int(np.searchsorted(detected, fraction*final_detected, side="left"))
+        event = min(horizon, max(1, event))
+        a = event-1
+        records.append(dict(a=a, policy="initial_detected_mass_quantile", fraction=fraction,
+                            event_depth=event, threshold=fraction*final_detected,
+                            final_detected_mass=final_detected, duplicate=a in depths))
+        if a not in depths:
+            depths.append(a)
+    return tuple(depths), records
+
+
+def search_midpoint(grid, *, start, budget, p, q, motion, initial_path,
+                    bound=None, bound_mode="stdc_lb", guide_weight=1.04,
+                    beam_width=24, diversity=True, anchor_depths=None,
+                    max_expansions=None, max_seconds=None, max_open=None,
+                    replay_cfg=None, trace=None):
+    """Return the best original-J route found by scheduled beam proposals.
+
+    `bound(v, absolute_depth, unnormalised_belief)` may supply a validated DP
+    or max(STDC,DP) lower bound. Its preparation/seed work must be paid by the
+    enclosing experiment; callback time is included here. It must not perform
+    unreported search expansions. A missing callback selects zero/mass/STDC.
+
+    beam_width=0 is the documented one-route greedy control (effective width
+    one, diversity disabled). All controls otherwise use the same generation,
+    original scoring and global budgets. OPEN includes retained anchor
+    frontiers AND pending next-layer buffers, including other active anchors.
+    """
+    started = perf_counter()
+    budget = integer(budget, "budget")
+    beam_width = integer(beam_width, "beam_width")
+    if not isinstance(diversity, bool):
+        raise ValueError("diversity must be bool")
+    if not isfinite(guide_weight) or guide_weight < 1:
+        raise ValueError("guide_weight must be finite and >=1")
+    for name, value in (("max_expansions", max_expansions), ("max_open", max_open)):
+        if value is not None:
+            integer(value, name)
+    if max_seconds is not None and (not isfinite(max_seconds) or max_seconds < 0):
+        raise ValueError("max_seconds must be finite and nonnegative")
+    if bound is None and bound_mode not in ("zero", "mass_lb", "stdc_lb"):
+        raise ValueError("without a callback, bound_mode must be zero, mass_lb or stdc_lb")
+    if bound is not None and not callable(bound):
+        raise ValueError("bound must be callable")
+    if bound is not None and hasattr(bound, "validate_compatibility"):
+        bound.validate_compatibility(grid, budget=budget, q=q, motion=motion)
+    if replay_cfg is not None:
+        if (not isinstance(motion, FutureEquivalentMotion)
+                or replay_cfg.get("motion") is not motion.original_motion
+                or replay_cfg.get("start") != start or replay_cfg.get("budget") != budget
+                or not np.array_equal(replay_cfg.get("p"), motion.original_initial_weights)
+                or not np.array_equal(p, motion.initial_weights)
+                or not np.array_equal(sensor_probabilities(replay_cfg.get("q"), grid.size),
+                                      sensor_probabilities(q, grid.size))):
+            raise ValueError("alternate replay requires the exact original compressed model")
+    elif isinstance(motion, FutureEquivalentMotion):
+        raise ValueError("compressed midpoint search requires the exact original replay model")
+    cfg = dict(start=start, budget=budget, p=p, q=q, motion=motion)
+    scoring = cfg if replay_cfg is None else replay_cfg
+    deadline = inf if max_seconds is None else started+max_seconds
+    effective_width = max(1, beam_width)
+    use_diversity = diversity and beam_width > 1
+    stats = dict(initial_replays=0, model_replays=0, candidate_replays=0, final_replays=0,
+                 replay_wall_s=0.0, complete_candidates=0, accepted_improvements=0,
+                 candidate_replay_error_J_max=0.0, candidate_replay_error_Pd_max=0.0,
+                 guide_calls=0, guide_wall_s=0.0, bound_calls=0, bound_wall_s=0.0,
+                 beam_discarded=0, diversity_selections_outside_quality_beam=0,
+                 diversity_wall_s=0.0, beam_width=beam_width, effective_beam_width=effective_width,
+                 diversity=use_diversity, state_merging=False, guide_used_for_pruning=False,
+                 guide_used_for_termination=False, bound_is_unweighted=True,
+                 endpoint_free=True, seed_search_run=False, objective="sum M[1:T+1]",
+                 scheduler="one full layer per active anchor in deterministic round-robin order",
+                 budget_scope="shared expansions/time/physical frontier plus next-layer buffers",
+                 diversity_key_scope="future-detectable representative and past detection; proposal only")
+    stats["candidate_archive_scope"] = "nondominated replayed accepted incumbents only; not a global Pareto frontier"
+    expanded = generated = pruned = peak_open = physical_open = 0
+    sequence = count()
+    history, tasks = [], []
+    path = tuple(initial_path)
+    original_path = path
+    source = "initial_path"
+
+    def timeout():
+        return "max_seconds" if perf_counter() >= deadline else None
+
+    def replay(route, kind, *, model=False, record_beliefs=False):
+        tic = perf_counter()
+        value = score_path(grid, route, **(cfg if model else scoring), record_beliefs=record_beliefs)
+        stats[kind+"_replays"] += 1
+        stats["replay_wall_s"] += perf_counter()-tic
+        return value
+
+    score = replay(path, "initial", record_beliefs=replay_cfg is None)
+    initial_model = (score if replay_cfg is None else
+                     replay(path, "model", model=True, record_beliefs=True))
+    if abs(initial_model.J-score.J) > ATOL or abs(initial_model.pd_final-score.pd_final) > ATOL:
+        raise AssertionError("compressed initial route disagrees with original replay")
+    starts, anchor_selection = _choose_anchors(score, budget, anchor_depths)
+    stats.update(anchor_selection=anchor_selection, anchor_depths=list(starts))
+    sensor = sensor_probabilities(q, grid.size)
+    guide = ParticleGuide(grid, budget=budget, q=q, motion=motion)
+    estimate = bound if bound is not None else Heuristic(grid, budget=budget, q=q, motion=motion, mode=bound_mode)
+    keys = _FutureDetectable(grid, budget=budget, q=q, motion=motion)
+
+    def record(event, route, g, **extra):
+        if trace is not None:
+            trace(dict(event=event, path=tuple(route), vertex=route[-1], depth=len(route)-1,
+                       g=g, incumbent_J=score.J, **extra))
+
+    def remember(origin, anchor=None):
+        history.append(dict(path=path, J=score.J, Pd=score.pd_final, source=origin,
+                            anchor=anchor, expanded=expanded, generated=generated,
+                            work_expanded=expanded,
+                            elapsed_s=perf_counter()-started))
+        record("incumbent", path, score.J, source=origin, anchor=anchor)
+
+    remember(source)
+
+    def materialize(task, route, belief, g, last_hit_vertex, last_hit_depth, direction,
+                    *, root=False):
+        nonlocal path, score, source, generated, pruned, physical_open, peak_open
+        depth = len(route)-1
+        if not root:
+            generated += 1
+            task["generated"] += 1
+        if depth == budget:
+            stats["complete_candidates"] += 1
+            task["complete_candidates"] += 1
+            record("candidate", route, g, anchor=task["a"])
+            if g < score.J+ATOL:
+                candidate = replay(route, "candidate")
+                err_j, err_pd = abs(candidate.J-g), abs(candidate.pd_final-(1.0-float(belief.sum())))
+                if err_j > ATOL or err_pd > ATOL:
+                    raise AssertionError("midpoint candidate disagrees with original full replay")
+                stats["candidate_replay_error_J_max"] = max(stats["candidate_replay_error_J_max"], err_j)
+                stats["candidate_replay_error_Pd_max"] = max(stats["candidate_replay_error_Pd_max"], err_pd)
+                if candidate.J < score.J-ATOL:
+                    path, score = tuple(route), candidate
+                    source = f"midpoint_anchor[{task['a']}]"
+                    stats["accepted_improvements"] += 1
+                    task["accepted_improvements"] += 1
+                    remember(source, task["a"])
+            return timeout()
+        if timeout():
+            return "max_seconds"
+        tic = perf_counter()
+        h = float(estimate(route[-1], depth, belief))
+        stats["bound_calls"] += 1
+        stats["bound_wall_s"] += perf_counter()-tic
+        lower = g+h
+        if not isfinite(lower) or h < -ATOL:
+            raise ValueError("invalid remaining-cost bound")
+        if timeout():
+            return "max_seconds"
+        if lower >= score.J+ATOL:
+            pruned += 1
+            task["pruned"] += 1
+            record("bound_prune", route, g, anchor=task["a"], lower_bound=lower)
+            return None
+        tic = perf_counter()
+        h_guide = float(guide(route[-1], depth, belief))
+        stats["guide_calls"] += 1
+        stats["guide_wall_s"] += perf_counter()-tic
+        priority = g+guide_weight*h_guide
+        if not isfinite(priority) or h_guide < -ATOL:
+            raise ValueError("invalid paper ordering guide")
+        if timeout():
+            return "max_seconds"
+        if max_open is not None and physical_open >= max_open:
+            return "max_open"
+        node = _Node(tuple(route), belief, g, lower, priority, next(sequence),
+                     last_hit_vertex, last_hit_depth, direction)
+        (task["frontier"] if root else task["next"]).append(node)
+        physical_open += 1
+        peak_open = max(peak_open, physical_open)
+        record("push", route, g, anchor=task["a"], lower_bound=lower, f_guide=priority)
+        return timeout()
+
+    def select_layer(task):
+        nonlocal physical_open, pruned
+        candidates = []
+        for node in task["next"]:
+            if node.lower >= score.J+ATOL:
+                physical_open -= 1
+                pruned += 1
+                task["pruned"] += 1
+            else:
+                candidates.append(node)
+        task["next"] = []
+        candidates.sort(key=lambda node: (node.priority, node.sequence))
+        if len(candidates) <= effective_width:
+            selected = candidates
+        elif not use_diversity:
+            selected = candidates[:effective_width]
+        else:
+            tic = perf_counter()
+            signatures = {node.sequence: keys.signatures(node) for node in candidates}
+            selected = candidates[:max(1, effective_width//2)]
+            selected_ids = {node.sequence for node in selected}
+            primary_seen = {signatures[node.sequence][0] for node in selected}
+            secondary_seen = {signatures[node.sequence][1] for node in selected}
+            # First reserve remaining slots for genuinely different eligible
+            # belief/detection families; direction alone must not fill them.
+            for level, seen in ((0, primary_seen), (1, secondary_seen)):
+                for node in candidates:
+                    if len(selected) == effective_width:
+                        break
+                    signature = signatures[node.sequence][level]
+                    if node.sequence not in selected_ids and signature not in seen:
+                        selected.append(node)
+                        selected_ids.add(node.sequence)
+                        primary_seen.add(signatures[node.sequence][0])
+                        secondary_seen.add(signatures[node.sequence][1])
+            for node in candidates:
+                if len(selected) == effective_width:
+                    break
+                if node.sequence not in selected_ids:
+                    selected.append(node)
+                    selected_ids.add(node.sequence)
+            top_ids = {node.sequence for node in candidates[:effective_width]}
+            stats["diversity_selections_outside_quality_beam"] += len(selected_ids-top_ids)
+            stats["diversity_wall_s"] += perf_counter()-tic
+        discarded = len(candidates)-len(selected)
+        physical_open -= discarded
+        task["beam_discarded"] += discarded
+        stats["beam_discarded"] += discarded
+        selected.sort(key=lambda node: (node.priority, node.sequence))
+        task["frontier"].extend(selected)
+        task["layers"] += 1
+        task["active"] = bool(task["frontier"])
+        if trace is not None:
+            trace(dict(event="beam_select", anchor=task["a"], candidate_count=len(candidates),
+                       retained_paths=[node.path for node in selected], discarded=discarded))
+        return timeout()
+
+    reason = timeout()
+    if reason is None and any(a < budget for a in starts) and max_expansions == 0:
+        reason = "max_expansions"
+    for index, a in enumerate(starts):
+        task = dict(index=index, a=a, fixed_prefix=list(original_path[:a+1]),
+                    frontier=deque(), next=[], active=False, initialized=False, finished=False,
+                    expanded=0, generated=0, pruned=0, beam_discarded=0,
+                    complete_candidates=0, accepted_improvements=0, layers=0)
+        tasks.append(task)
+        if reason:
+            continue
+        hit_steps = np.flatnonzero(initial_model.delta_pd[:a] > ATOL)+1
+        hit_depth = int(hit_steps[-1]) if len(hit_steps) else 0
+        hit_vertex = int(original_path[hit_depth]) if len(hit_steps) else -1
+        prefix = original_path[:a+1]
+        direction = _direction(grid, prefix[-2], prefix[-1]) if a else -1
+        task["initialized"] = True
+        reason = materialize(task, prefix, initial_model.beliefs[a].copy(),
+                             float(initial_model.g[a]), hit_vertex, hit_depth, direction, root=True)
+        task["active"] = bool(task["frontier"])
+        task["finished"] = reason is None and not task["active"]
+    while any(task["active"] for task in tasks) and reason is None:
+        for task in tasks:
+            if not task["active"]:
+                continue
+            count_this_layer = len(task["frontier"])
+            for _ in range(count_this_layer):
+                reason = timeout()
+                if reason is None and max_expansions is not None and expanded >= max_expansions:
+                    reason = "max_expansions"
+                if reason:
+                    break
+                node = task["frontier"].popleft()
+                physical_open -= 1
+                if node.lower >= score.J+ATOL:
+                    pruned += 1
+                    task["pruned"] += 1
+                    continue
+                expanded += 1
+                task["expanded"] += 1
+                record("expand", node.path, node.g, anchor=task["a"], lower_bound=node.lower)
+                t = node.depth+1
+                prior = motion.propagate(node.belief, step=t)
+                prior_mass = float(prior.sum())
+                for vertex in grid.neighbors(node.path[-1]):
+                    detected = motion.sense(prior, vertex, sensor, step=t)
+                    remaining_mass = float(detected.sum())
+                    hit = prior_mass-remaining_mass > ATOL
+                    reason = materialize(task, node.path+(vertex,), detected, node.g+remaining_mass,
+                                         vertex if hit else node.last_hit_vertex,
+                                         t if hit else node.last_hit_depth,
+                                         _direction(grid, node.path[-1], vertex))
+                    if reason:
+                        break
+                if reason:
+                    break
+            if reason:
+                break
+            reason = select_layer(task)
+            task["finished"] = reason is None and not task["active"]
+            if reason:
+                break
+    final = replay(path, "final")
+    if abs(final.J-score.J) > ATOL or abs(final.pd_final-score.pd_final) > ATOL:
+        raise AssertionError("final midpoint incumbent replay mismatch")
+    reason = reason or timeout()
+    wall = perf_counter()-started
+    anchor_records = []
+    for task in tasks:
+        pending = len(task["frontier"])+len(task["next"])
+        row = {key: value for key, value in task.items() if key not in ("frontier", "next", "active")}
+        row.update(frontier_remaining=pending,
+                   status="completed" if task["finished"] else "budget_exceeded",
+                   stop_reason=None if task["finished"] else reason)
+        anchor_records.append(row)
+    stats.update(work_expanded=expanded, physical_frontier_remaining=physical_open,
+                 beam_discard=stats["beam_discarded"], proposal_discarded=stats["beam_discarded"],
+                 diversity_geometry_entries=len(keys.cache),
+                 deadline_overshoot_s=max(0.0, started+wall-deadline))
+    archive = []
+    for entry in history:
+        if any(old["J"] <= entry["J"] and old["Pd"] >= entry["Pd"] for old in archive):
+            continue
+        archive = [old for old in archive
+                   if not (entry["J"] <= old["J"] and entry["Pd"] >= old["Pd"])]
+        archive.append(dict(entry))
+    return MidpointResult(path, final.J, final.pd_final, expanded, generated, pruned, peak_open,
+                          "budget_exceeded" if reason else "completed", reason, source,
+                          bound_mode, guide_weight, incumbent_history=history, stats=stats,
+                          anchors=anchor_records, candidate_archive=archive, wall_s=wall,
+                          completion_reason=None if reason else "scheduled_beam_rollouts_completed")

diff --git a/asar_repro/src/asar_repro/particle_diagnostic.py b/asar_repro/src/asar_repro/particle_diagnostic.py
new file mode 100644
index 0000000..25bcf5b
--- /dev/null
+++ b/asar_repro/src/asar_repro/particle_diagnostic.py
@@ -0,0 +1,364 @@
+"""Independent fixed-particle LP/MILP diagnostic; never a search certificate.
+
+The minimization LP keeps one time-expanded searcher flow and relaxes binary
+positions in exact bounded-product constraints. Only a checked dual/box lower
+bound is exposed as ``lower_bound``; a primal LP objective is not a lower bound.
+All time indices refer to the original archive, including at a fixed prefix.
+"""
+
+from dataclasses import dataclass, field
+from math import inf, isfinite, nextafter
+from time import perf_counter
+
+import numpy as np
+import scipy
+from scipy import sparse
+from scipy.optimize import Bounds, LinearConstraint, linprog, milp
+
+from .belief import initial_belief, sensor_probabilities
+from .grid import integer
+from .motion import ParticleMotion
+from .objective import score_path
+
+
+@dataclass
+class DiagnosticResult:
+    method: str
+    status: str
+    stop_reason: str | None
+    path: tuple | None = None
+    J: float | None = None
+    Pd: float | None = None
+    incumbent_source: str | None = None
+    lower_bound: float = 0.0
+    lower_bound_source: str = "nonnegative_remaining_objective"
+    solver_primal_objective: float | None = None
+    solver_dual_bound_estimate: float | None = None
+    gap: float | None = None
+    solver_status: int | None = None
+    solver_message: str | None = None
+    theory_certified: bool = False
+    model_size: dict = field(default_factory=dict)
+    timings: dict = field(default_factory=dict)
+    dual_verification: dict = field(default_factory=dict)
+    metadata: dict = field(default_factory=dict)
+
+
+@dataclass
+class _Model:
+    c: np.ndarray
+    A_ub: object
+    b_ub: np.ndarray
+    A_eq: object
+    b_eq: np.ndarray
+    upper: np.ndarray
+    lower: np.ndarray
+    integrality: np.ndarray
+    position_count: int
+    size: dict
+
+
+class _TimeLimit(Exception):
+    pass
+
+
+def _check_time(deadline):
+    if perf_counter() >= deadline:
+        raise _TimeLimit
+
+
+def _build_model(grid, *, budget, prefix, p, belief, sensor, motion, deadline):
+    """Build with fixed original p bounds, not belief-dependent big-M values."""
+    depth, n, vertices = len(prefix) - 1, motion.state_size, grid.size
+    remaining = budget - depth
+    edges = [(v, u) for v in range(vertices) for u in grid.neighbors(v)]
+    outgoing, incoming = [[] for _ in range(vertices)], [[] for _ in range(vertices)]
+    for index, (v, u) in enumerate(edges):
+        outgoing[v].append(index)
+        incoming[u].append(index)
+    nx, ny = (remaining + 1) * vertices, remaining * len(edges)
+    nw, nz = (remaining + 1) * n, remaining * n
+    wbase, zbase, count = nx + ny, nx + ny + nw, nx + ny + nw + nz
+    c = np.zeros(count)
+    c[wbase + n:zbase] = 1.0
+    upper = np.r_[np.ones(nx + ny), np.tile(p, remaining + 1), np.tile(p, remaining)]
+    lower = np.zeros(count)
+    upper[:vertices] = 0.0
+    lower[prefix[-1]] = upper[prefix[-1]] = 1.0
+    integrality = np.zeros(count, dtype=np.uint8)
+    integrality[:nx] = 1
+    er, ec, ev, eb, ur, uc, uv, ub = [], [], [], [], [], [], [], []
+
+    def eq(items, rhs=0.0):
+        row = len(eb)
+        for col, value in items:
+            if value:
+                er.append(row); ec.append(col); ev.append(value)
+        eb.append(rhs)
+
+    def le(items, rhs=0.0):
+        row = len(ub)
+        for col, value in items:
+            if value:
+                ur.append(row); uc.append(col); uv.append(value)
+        ub.append(rhs)
+
+    for i in range(n):
+        eq(((wbase + i, 1.0),), float(belief[i]))
+    active_products = 0
+    for k in range(1, remaining + 1):
+        _check_time(deadline)
+        ybase = nx + (k - 1) * len(edges)
+        for v in range(vertices):
+            eq([(ybase + e, 1.0) for e in outgoing[v]] + [((k - 1) * vertices + v, -1.0)])
+            eq([(ybase + e, 1.0) for e in incoming[v]] + [(k * vertices + v, -1.0)])
+        for i, cell in enumerate(motion.cell_ids[depth + k]):
+            previous, current = wbase + (k - 1) * n + i, wbase + k * n + i
+            z = zbase + (k - 1) * n + i
+            detection = float(sensor[cell]) if cell < vertices else 0.0
+            eq(((current, 1.0), (previous, -1.0), (z, detection)))
+            if detection == 0.0:
+                upper[z] = 0.0  # Includes every special bin; its mass survives.
+                continue
+            x, maximum = k * vertices + int(cell), float(p[i])
+            le(((z, 1.0), (previous, -1.0)))
+            le(((z, 1.0), (x, -maximum)))
+            le(((z, -1.0), (previous, 1.0), (x, maximum)), maximum)
+            active_products += 1
+    Aeq = sparse.coo_matrix((ev, (er, ec)), shape=(len(eb), count)).tocsr()
+    Aub = sparse.coo_matrix((uv, (ur, uc)), shape=(len(ub), count)).tocsr()
+    return _Model(c, Aub, np.asarray(ub), Aeq, np.asarray(eb), upper, lower,
+                  integrality, nx, dict(variables=count, position_variables=nx,
+                  flow_variables=ny, weight_variables=nw, product_variables=nz,
+                  binary_variables=nx, equalities=len(eb), inequalities=len(ub),
+                  nonzeros=Aeq.nnz + Aub.nnz, active_products=active_products,
+                  particles=n, vertices=vertices, directed_edges=len(edges),
+                  remaining_steps=remaining, absolute_depth=depth))
+
+
+def _dot_interval(a, b):
+    """Outward-rounded dot interval for finite IEEE-754 input coefficients."""
+    low = high = 0.0
+    for left, right in zip(a, b):
+        product = float(left) * float(right)
+        if not isfinite(product):
+            raise ValueError("nonfinite product during dual verification")
+        # Exact zero needs no widening and avoids artificial subnormal terms.
+        if left == 0 or right == 0:
+            continue
+        low = nextafter(low + nextafter(product, -inf), -inf)
+        high = nextafter(high + nextafter(product, inf), inf)
+    if not isfinite(low) or not isfinite(high):
+        raise ValueError("nonfinite sum during dual verification")
+    return low, high
+
+
+def _verified_dual_bound(model, equality_dual, inequality_dual, *, deadline=inf):
+    """Verify a box-corrected dual bound, including stationarity residuals.
+
+    With y <= 0 for A_ub s <= b_ub and free eta, let
+    r = c - A_ub.T y - A_eq.T eta. Every feasible s in [l,u] obeys
+    c.s >= y.b_ub + eta.b_eq + sum(min(r*l, r*u)).
+    Outward rounding encloses each dot/subtraction/product/sum. Thus even
+    approximate multipliers remain usable after the box residual correction.
+    This checks the stored floating-coefficient LP, not a global SAR guarantee.
+    """
+    eta = np.asarray(equality_dual, dtype=float)
+    raw_y = np.asarray(inequality_dual, dtype=float)
+    if (eta.shape != model.b_eq.shape or raw_y.shape != model.b_ub.shape
+            or not np.all(np.isfinite(eta)) or not np.all(np.isfinite(raw_y))):
+        raise ValueError("missing or nonfinite LP dual multipliers")
+    y = np.minimum(raw_y, 0.0)  # Enforce the mathematical inequality sign.
+    ae, au = model.A_eq.tocsc(), model.A_ub.tocsc()
+    eq_low, _ = _dot_interval(eta, model.b_eq)
+    ub_low, _ = _dot_interval(y, model.b_ub)
+    base = nextafter(eq_low + ub_low, -inf)
+    corrected, correction = base, 0.0
+    max_residual = 0.0
+    for j in range(len(model.c)):
+        if j % 2048 == 0:
+            _check_time(deadline)
+        es = slice(ae.indptr[j], ae.indptr[j + 1])
+        us = slice(au.indptr[j], au.indptr[j + 1])
+        el, eh = _dot_interval(ae.data[es], eta[ae.indices[es]])
+        ul, uh = _dot_interval(au.data[us], y[au.indices[us]])
+        rlow = nextafter(nextafter(float(model.c[j]) - eh, -inf) - uh, -inf)
+        rhigh = nextafter(nextafter(float(model.c[j]) - el, inf) - ul, inf)
+        max_residual = max(max_residual, abs(rlow), abs(rhigh))
+        term = min(nextafter(rlow * float(model.lower[j]), -inf),
+                   nextafter(rlow * float(model.upper[j]), -inf))
+        correction = nextafter(correction + term, -inf)
+        corrected = nextafter(corrected + term, -inf)
+    if not isfinite(corrected):
+        raise ValueError("nonfinite corrected dual bound")
+    return corrected, dict(verified=True, scheme="outward_rounded_box_residual",
+        dual_objective_lower=base, box_correction_lower=correction,
+        corrected_lower_bound=corrected, max_stationarity_residual=max_residual,
+        inequality_sign_projection=float(np.maximum(raw_y, 0).max(initial=0.0)),
+        scope="stored floating-coefficient LP; no global search certification")
+
+
+def _finite(value):
+    return float(value) if value is not None and np.isfinite(value) else None
+
+
+def solve_diagnostic(grid, *, start, budget, p, q, motion, method="lp",
+                     max_seconds=30.0, prefix_path=None, initial_path=None,
+                     mip_rel_gap=0.0):
+    """Diagnose the unchanged J objective; time caps include all local work.
+
+    ``prefix_path`` fixes history and derives its belief by the old scorer.
+    LP positions are fractional and never presented as a feasible path.
+    MILP paths and provided incumbents are independently replayed. When using
+    FutureEquivalentMotion, accepted routes also replay the original archive.
+    Solver work is limited by remaining wall time; cooperative build/dual
+    checks and mandatory candidate replay can overrun, explicitly reported.
+    """
+    started = perf_counter()
+    budget = integer(budget, "budget")
+    grid.coordinates(start)
+    if not isinstance(motion, ParticleMotion) or motion.size != grid.size:
+        raise ValueError("diagnostic requires ParticleMotion matching the grid")
+    motion.check_horizon(budget)
+    p = initial_belief(p, motion.state_size)
+    sensor = sensor_probabilities(q, grid.size).copy()
+    if method not in ("lp", "milp"):
+        raise ValueError("method must be lp or milp")
+    if not isfinite(max_seconds) or max_seconds < 0:
+        raise ValueError("max_seconds must be finite and nonnegative")
+    if not isfinite(mip_rel_gap) or mip_rel_gap < 0:
+        raise ValueError("mip_rel_gap must be finite and nonnegative")
+    prefix = (start,) if prefix_path is None else tuple(prefix_path)
+    grid.validate_path(prefix, start=start, budget=len(prefix) - 1)
+    if len(prefix) > budget + 1:
+        raise ValueError("prefix exceeds budget")
+    deadline = started + max_seconds
+    out = DiagnosticResult(method, "not_started", None)
+    out.timings = dict(model_s=0.0, solver_s=0.0, dual_verification_s=0.0,
+                       replay_s=0.0, wall_s=0.0)
+    out.metadata = dict(scipy_version=scipy.__version__, absolute_depth=len(prefix)-1,
+        horizon=budget, initial_mass=float(p.sum()), archive_frames=len(motion.cell_ids),
+        particles=motion.state_size, special_bins_retained=True, t0_detection=False,
+        fixed_original_big_m=True, objective="sum M_t, t=1..T", replay_count=0,
+        max_seconds=float(max_seconds), prefix=list(prefix),
+        lp_primal_used_as_lower_bound=False, solver_bound_is_numerical_estimate=True,
+        stop_is_cooperative=True, original_archive_replay_count=0)
+
+    def replay(path, horizon):
+        mark = perf_counter()
+        try:
+            score = score_path(grid, path, start=start, budget=horizon,
+                               p=p, q=sensor, motion=motion)
+            out.metadata["replay_count"] += 1
+            if hasattr(motion, "original_motion"):
+                if not np.array_equal(p, motion.initial_weights):
+                    raise ValueError("compressed replay requires its original initial weights")
+                original = score_path(grid, path, start=start, budget=horizon,
+                    p=motion.original_initial_weights, q=sensor, motion=motion.original_motion)
+                out.metadata["original_archive_replay_count"] += 1
+                if abs(score.J-original.J) > 1e-10 or abs(score.pd_final-original.pd_final) > 1e-10:
+                    raise RuntimeError("blocked: compressed/original replay mismatch")
+            return score
+        finally:
+            out.timings["replay_s"] += perf_counter() - mark
+
+    prefix_score = replay(prefix, len(prefix)-1)
+    out.lower_bound = prefix_score.J  # Remaining mass is nonnegative.
+    if initial_path is not None:
+        initial_path = tuple(initial_path)
+        if initial_path[:len(prefix)] != prefix:
+            raise ValueError("initial path must extend prefix")
+        incumbent = replay(initial_path, budget)
+        out.path, out.J, out.Pd = initial_path, incumbent.J, incumbent.pd_final
+        out.incumbent_source = "initial_path"
+
+    def finish():
+        out.timings["wall_s"] = perf_counter() - started
+        out.metadata["budget_overrun_s"] = max(0.0, out.timings["wall_s"] - max_seconds)
+        if out.J is not None:
+            if out.lower_bound > out.J + 1e-8:
+                raise RuntimeError("blocked: checked LP lower bound exceeds replayed incumbent")
+            out.gap = max(0.0, out.J - out.lower_bound)
+        if out.timings["wall_s"] >= max_seconds and out.status == "completed":
+            out.status, out.stop_reason = "budget_exhausted", "wall_time_during_finalization"
+        return out
+
+    if len(prefix) == budget + 1:
+        out.path, out.J, out.Pd = prefix, prefix_score.J, prefix_score.pd_final
+        out.incumbent_source = "terminal_prefix"
+        out.lower_bound_source = "terminal_prefix_replay"
+        out.status = "completed"
+        return finish()
+    mark = perf_counter()
+    try:
+        _check_time(deadline)
+        model = _build_model(grid, budget=budget, prefix=prefix, p=p,
+            belief=prefix_score.final_belief, sensor=sensor, motion=motion, deadline=deadline)
+        out.model_size = model.size
+        _check_time(deadline)
+    except _TimeLimit:
+        out.status, out.stop_reason = "budget_exhausted", "wall_time_during_model"
+        return finish()
+    finally:
+        out.timings["model_s"] = perf_counter() - mark
+
+    remaining = deadline - perf_counter()
+    mark = perf_counter()
+    if method == "lp":
+        solved = linprog(model.c, A_ub=model.A_ub, b_ub=model.b_ub,
+            A_eq=model.A_eq, b_eq=model.b_eq, bounds=np.c_[model.lower, model.upper],
+            method="highs", options={"time_limit": max(1e-9, remaining)})
+    else:
+        matrix = sparse.vstack((model.A_eq, model.A_ub), format="csc")
+        constraints = LinearConstraint(matrix, np.r_[model.b_eq, np.full(len(model.b_ub), -inf)],
+                                       np.r_[model.b_eq, model.b_ub])
+        solved = milp(model.c, integrality=model.integrality,
+            bounds=Bounds(model.lower, model.upper), constraints=constraints,
+            options={"time_limit": max(1e-9, deadline-perf_counter()), "mip_rel_gap": mip_rel_gap})
+    out.timings["solver_s"] = perf_counter() - mark
+    out.solver_status, out.solver_message = int(solved.status), str(solved.message)
+    out.status = {0: "completed", 1: "budget_exhausted", 2: "infeasible"}.get(solved.status, "solver_error")
+    out.stop_reason = None if solved.status == 0 else str(solved.message)
+    primal = _finite(getattr(solved, "fun", None))
+    out.solver_primal_objective = None if primal is None else prefix_score.J + primal
+    if method == "lp":
+        mark = perf_counter()
+        try:
+            _check_time(deadline)
+            bound, report = _verified_dual_bound(model,
+                solved.eqlin.marginals, solved.ineqlin.marginals, deadline=deadline)
+            out.lower_bound = max(prefix_score.J, nextafter(prefix_score.J + bound, -inf))
+            out.lower_bound_source = "verified_box_corrected_lp_dual"
+            out.dual_verification = report
+        except _TimeLimit:
+            out.status, out.stop_reason = "budget_exhausted", "wall_time_during_dual_verification"
+            out.dual_verification = dict(verified=False, reason="verification_time_limit")
+        except (AttributeError, TypeError, ValueError) as error:
+            out.dual_verification = dict(verified=False, reason=str(error))
+        finally:
+            out.timings["dual_verification_s"] = perf_counter() - mark
+    else:
+        estimate = _finite(getattr(solved, "mip_dual_bound", None))
+        out.solver_dual_bound_estimate = None if estimate is None else prefix_score.J + estimate
+        out.metadata["solver_mip_gap"] = _finite(getattr(solved, "mip_gap", None))
+        out.metadata["solver_node_count"] = _finite(getattr(solved, "mip_node_count", None))
+        values = getattr(solved, "x", None)
+        if values is not None:
+            positions = np.asarray(values[:model.position_count]).reshape(-1, grid.size)
+            integer_error = float(np.max(np.abs(positions - np.rint(positions))))
+            out.metadata["position_integrality_error"] = integer_error
+            if integer_error <= 1e-5 and np.all(np.abs(positions.sum(axis=1)-1) <= 1e-5):
+                candidate = prefix[:-1] + tuple(int(v) for v in positions.argmax(axis=1))
+                candidate_score = replay(candidate, budget)
+                out.metadata["milp_replayed_J"] = candidate_score.J
+                out.metadata["objective_replay_error"] = (None if primal is None else
+                    abs(candidate_score.J-prefix_score.J-primal))
+                if (primal is not None and solved.status == 0
+                        and out.metadata["objective_replay_error"] > 1e-6):
+                    raise RuntimeError("blocked: optimal MILP objective disagrees with independent replay")
+                if out.J is None or candidate_score.J < out.J:
+                    out.path, out.J, out.Pd = candidate, candidate_score.J, candidate_score.pd_final
+                    out.incumbent_source = "milp_independent_replay"
+            else:
+                out.metadata["candidate_rejected"] = "fractional_positions"
+    return finish()

diff --git a/asar_repro/src/asar_repro/particle_dp.py b/asar_repro/src/asar_repro/particle_dp.py
new file mode 100644
index 0000000..5c2cb6b
--- /dev/null
+++ b/asar_repro/src/asar_repro/particle_dp.py
@@ -0,0 +1,243 @@
+"""Independent-particle dynamic-programming relaxation on absolute frames.
+
+Each supplied motion column may choose its own legal search route. For an
+undetected particle i, V_i(t,v) is the minimum remaining cumulative survival
+cost. Thus sum_i b_i V_i(t,v) lower-bounds the cost of one common search route.
+An optional, SEPARATE table minimizes terminal survival and supplies only a
+diagnostic Pd upper bound. The two optima need not use the same route.
+
+No partial table is published after a build budget stop. These numerical
+bounds do not by themselves confer a full-search epsilon certificate.
+"""
+from __future__ import annotations
+
+from math import inf, isfinite, isnan
+from time import perf_counter
+
+import numpy as np
+
+from .belief import sensor_probabilities, undetected_mass
+from .grid import GridGraph, integer
+from .motion import ParticleMotion
+
+
+class _BuildInterrupted(Exception):
+    def __init__(self, reason):
+        self.reason = reason
+
+
+class ParticleDP:
+    """Build V_i(t,v)=min_u a_i(t+1,u)*(1+V_i(t+1,u)) backwards.
+
+    u must be a legal neighbour with a feasible remaining suffix. V_i(T,v)=0.
+    a is 1-q[u] when cell_ids[t+1,i]==u and 1 otherwise; special bins cannot
+    match a legal vertex. Columns, including compressed-column ID mappings,
+    retain the order of the supplied ParticleMotion (or its subclass).
+
+    max_memory_bytes caps the estimated peak of this builder's managed NumPy
+    arrays. It is not an operating-system RSS cap: caller-owned motion arrays,
+    input-conversion temporaries, interpreter and Python object overhead are
+    excluded. max_seconds and deadline cover the whole cooperative build.
+    A caller must include preprocessing time/memory in its experiment budget.
+    """
+
+    def __init__(self, grid: GridGraph, *, budget: int, q, motion: ParticleMotion,
+                 with_pd_bound: bool = False, max_seconds=None, deadline=inf,
+                 max_memory_bytes=None):
+        started = perf_counter()
+        if not isinstance(grid, GridGraph):
+            raise ValueError("ParticleDP requires the fixed four-neighbour GridGraph")
+        if not isinstance(motion, ParticleMotion):
+            raise ValueError("ParticleDP requires ParticleMotion or a compatible subclass")
+        if not isinstance(with_pd_bound, bool):
+            raise ValueError("with_pd_bound must be a bool")
+        self.grid = grid
+        self.budget = integer(budget, "budget")
+        if grid.size != motion.size:
+            raise ValueError("motion grid size must match the search grid")
+        motion.check_horizon(self.budget)
+        sensor = sensor_probabilities(q, grid.size)
+        deadline = float(deadline)
+        if isnan(deadline):
+            raise ValueError("deadline must not be NaN")
+        if max_seconds is not None:
+            if not isfinite(max_seconds) or max_seconds < 0:
+                raise ValueError("max_seconds must be finite and nonnegative")
+            deadline = min(deadline, started + max_seconds)
+        if max_memory_bytes is not None:
+            max_memory_bytes = integer(max_memory_bytes, "max_memory_bytes")
+        self.motion = motion
+        self.state_size = motion.state_size
+        self.trajectory_ids = motion.trajectory_ids
+        self._cells = motion.cell_ids
+        self.with_pd_bound = with_pd_bound
+        self.q = None
+        self.ready = False
+        self.status = "building"
+        self.stop_reason = None
+        self._cost = self._survival = self._feasible = None
+
+        shape = (self.budget + 1, grid.size, self.state_size)
+        table_bytes = int(np.prod(shape, dtype=object)) * np.dtype(np.float64).itemsize
+        feasible_bytes = (self.budget + 1) * grid.size * np.dtype(np.bool_).itemsize
+        sensor_bytes = grid.size * np.dtype(np.float64).itemsize
+        scratch_bytes = (self.state_size * (np.dtype(np.float64).itemsize
+                         + np.dtype(np.bool_).itemsize)) if self.budget else 0
+        required = table_bytes * (1 + int(with_pd_bound)) + feasible_bytes + sensor_bytes + scratch_bytes
+        info = dict(status="building", stop_reason=None, wall_s=0.0,
+                    budget=self.budget, vertices=grid.size, particle_columns=self.state_size,
+                    with_pd_bound=with_pd_bound, cost_table_bytes=table_bytes,
+                    survival_table_bytes=table_bytes if with_pd_bound else 0,
+                    feasible_table_bytes=feasible_bytes, sensor_bytes=sensor_bytes,
+                    scratch_bytes=scratch_bytes, required_peak_managed_bytes=required,
+                    allocated_peak_managed_bytes=0, published_table_bytes=0,
+                    max_memory_bytes=max_memory_bytes, max_seconds=max_seconds,
+                    completed_time_layers=0, completed_vertex_backups=0,
+                    edge_backups=0, particle_edge_backups=0,
+                    deadline_overshoot_s=0.0,
+                    memory_scope="managed DP NumPy buffers; excludes caller motion, input conversion, interpreter and Python object overhead",
+                    work_scope="preprocessing DP backups, not search-tree expansions; include build wall time in the shared budget",
+                    column_order="supplied motion ID order; compressed motion retains its original-ID mapping",
+                    pd_scope="independent terminal-survival optimum, not the min-J route",
+                    global_epsilon_certified=False)
+        cost = survival = feasible = work = hit = None
+        allocated = 0
+
+        def time_check():
+            if perf_counter() >= deadline:
+                raise _BuildInterrupted("max_seconds")
+
+        def charge(array):
+            nonlocal allocated
+            allocated += array.nbytes
+            info["allocated_peak_managed_bytes"] = max(info["allocated_peak_managed_bytes"], allocated)
+            return array
+
+        try:
+            time_check()
+            if max_memory_bytes is not None and required > max_memory_bytes:
+                raise _BuildInterrupted("max_memory_bytes")
+            self.q = charge(sensor.copy())
+            self.q.setflags(write=False)
+            cost = charge(np.full(shape, inf, dtype=np.float64))
+            time_check()
+            if with_pd_bound:
+                survival = charge(np.full(shape, inf, dtype=np.float64))
+                time_check()
+            feasible = charge(np.zeros(shape[:2], dtype=np.bool_))
+            feasible[self.budget] = True
+            cost[self.budget] = 0.0
+            if survival is not None:
+                survival[self.budget] = 1.0
+            if self.budget:
+                work = charge(np.empty(self.state_size, dtype=np.float64))
+                hit = charge(np.empty(self.state_size, dtype=np.bool_))
+            for t in range(self.budget - 1, -1, -1):
+                cells = self._cells[t + 1]  # Absolute frame, never relative to a query.
+                for vertex in range(grid.size):
+                    time_check()
+                    for nxt in grid.neighbors(vertex):
+                        # Feasibility is independent of the particle or its
+                        # weight. Excluding infeasible suffixes FIRST avoids
+                        # the invalid 0*inf case when q[nxt]==1.
+                        if not feasible[t + 1, nxt]:
+                            continue
+                        time_check()
+                        feasible[t, vertex] = True
+                        np.equal(cells, nxt, out=hit)
+                        np.add(cost[t + 1, nxt], 1.0, out=work)
+                        np.multiply(work, 1.0 - self.q[nxt], out=work, where=hit)
+                        np.minimum(cost[t, vertex], work, out=cost[t, vertex])
+                        if survival is not None:
+                            np.copyto(work, survival[t + 1, nxt])
+                            np.multiply(work, 1.0 - self.q[nxt], out=work, where=hit)
+                            np.minimum(survival[t, vertex], work, out=survival[t, vertex])
+                        info["edge_backups"] += 1
+                        info["particle_edge_backups"] += self.state_size
+                    time_check()
+                    info["completed_vertex_backups"] += 1
+                info["completed_time_layers"] += 1
+            time_check()
+            for array in (cost, survival, feasible):
+                if array is not None:
+                    array.setflags(write=False)
+            # Publish atomically only after the entire horizon is complete.
+            self._cost, self._survival, self._feasible = cost, survival, feasible
+            self.ready = True
+            self.status = "completed"
+            info["published_table_bytes"] = cost.nbytes + feasible.nbytes + (
+                survival.nbytes if survival is not None else 0)
+        except _BuildInterrupted as interrupted:
+            self.status = "budget_exceeded"
+            self.stop_reason = interrupted.reason
+            self._cost = self._survival = self._feasible = None
+            # No caller can retain a view into a partially built table.
+            cost = survival = feasible = work = hit = None
+        finally:
+            ended = perf_counter()
+            info.update(status=self.status, stop_reason=self.stop_reason,
+                        wall_s=ended-started, deadline_overshoot_s=max(0.0, ended-deadline))
+            self.build_info = info
+
+    @property
+    def stats(self):
+        """A copy of construction diagnostics; no state-dependent query cache."""
+        return dict(self.build_info)
+
+    @property
+    def cost_table(self):
+        return self._cost
+
+    @property
+    def survival_table(self):
+        return self._survival
+
+    @property
+    def feasible_table(self):
+        return self._feasible
+
+    def validate_compatibility(self, grid, *, budget, q, motion):
+        """Reject reuse across models, including equally sized motion archives."""
+        if not self.ready:
+            raise ValueError("ParticleDP build is not ready")
+        if not isinstance(grid, GridGraph) or grid != self.grid:
+            raise ValueError("ParticleDP grid mismatch")
+        if integer(budget, "budget") != self.budget:
+            raise ValueError("ParticleDP budget mismatch")
+        if (motion is not self.motion or motion.cell_ids is not self._cells
+                or motion.trajectory_ids is not self.trajectory_ids):
+            raise ValueError("ParticleDP motion identity or immutable archive changed")
+        if not np.array_equal(sensor_probabilities(q, grid.size), self.q):
+            raise ValueError("ParticleDP sensor mismatch")
+        return True
+
+    def _query(self, vertex, depth, belief):
+        if not self.ready:
+            raise RuntimeError("ParticleDP build is incomplete; partial tables cannot be used")
+        self.grid.coordinates(vertex)
+        vertex = int(vertex)
+        depth = integer(depth, "depth")
+        if depth > self.budget:
+            raise ValueError("depth exceeds ParticleDP budget")
+        b = undetected_mass(belief, self.state_size)
+        return vertex, depth, b
+
+    def __call__(self, vertex, depth, belief):
+        vertex, depth, b = self._query(vertex, depth, belief)
+        if not self._feasible[depth, vertex]:
+            return inf  # A legal T-length route is required even for zero mass.
+        return float(b @ self._cost[depth, vertex])
+
+    def pd_upper_bound(self, vertex, depth, belief):
+        """Optimistic TOTAL Pd, including earlier detection; None if infeasible.
+
+        This uses a different per-particle optimization from the J table. It
+        must not be reported as the Pd of a route attaining this object's J
+        lower bound, or as an achieved detection probability.
+        """
+        vertex, depth, b = self._query(vertex, depth, belief)
+        if not self.with_pd_bound:
+            raise RuntimeError("terminal-survival table was not requested")
+        if not self._feasible[depth, vertex]:
+            return None
+        return 1.0 - float(b @ self._survival[depth, vertex])

diff --git a/asar_repro/src/asar_repro/research_particle.py b/asar_repro/src/asar_repro/research_particle.py
new file mode 100644
index 0000000..a1cc0d1
--- /dev/null
+++ b/asar_repro/src/asar_repro/research_particle.py
@@ -0,0 +1,168 @@
+"""Opt-in particle execution and exact future-signature state compression.
+
+The archived ParticleMotion, objective and particle IDs are never modified.
+Aggregation is lossless in the real-arithmetic discrete model; different
+floating summation order still requires comparison with the original scorer.
+"""
+from __future__ import annotations
+
+import numpy as np
+
+from .belief import MASS_ATOL, initial_belief, sensor_probabilities, undetected_mass
+from .grid import integer
+from .heuristic import Heuristic
+from .motion import ParticleMotion
+
+
+class ParticleGuide:
+    """Paper Algorithm 2 with one private weight copy per nonterminal call.
+
+    Reachability is the paper's distance-radius superset, not a continuity
+    constraint between greedily selected cells. Frames are absolute and ties
+    use the first ascending cell ID, exactly as Heuristic(paper_greedy).
+    Non-particle motion conservatively delegates to the unchanged heuristic.
+    This guide is an ordering device, never an admissible pruning certificate.
+    """
+
+    def __init__(self, grid, *, budget, q, motion):
+        self.grid = grid
+        self.budget = integer(budget, "budget")
+        self.motion = motion
+        self.mode = "paper_greedy"
+        if grid.size != motion.size:
+            raise ValueError("motion grid size must match the search grid")
+        self.q = sensor_probabilities(q, grid.size).copy()
+        self.q.setflags(write=False)
+        self.used_fallback = not isinstance(motion, ParticleMotion)
+        self._fallback = (Heuristic(grid, budget=budget, q=self.q, motion=motion,
+                                   mode="paper_greedy") if self.used_fallback else None)
+        if not self.used_fallback:
+            motion.check_horizon(self.budget)
+        self._reachable = {}
+
+    def __call__(self, vertex, depth, belief, *, choices=None):
+        if self._fallback is not None:
+            return self._fallback(vertex, depth, belief, choices=choices)
+        self.grid.coordinates(vertex)
+        depth = integer(depth, "depth")
+        if depth > self.budget:
+            raise ValueError("depth exceeds search budget")
+        if depth == self.budget:
+            return 0.0
+        weights = undetected_mass(belief, self.motion.state_size).copy()
+        if vertex not in self._reachable:
+            distances = self.grid.distances_from(vertex)
+            self._reachable[vertex] = [np.flatnonzero(distances <= k)
+                for k in range(min(self.budget, int(distances.max())) + 1)]
+        rings = self._reachable[vertex]
+        total = 0.0
+        for t in range(depth + 1, self.budget + 1):
+            reach = rings[min(t-depth, len(rings)-1)]
+            mass = np.bincount(self.motion.cell_ids[t], weights=weights,
+                               minlength=self.motion.bin_count)
+            best = int(reach[np.argmax(self.q[reach] * mass[reach])])
+            offsets = self.motion._offsets[t]
+            members = self.motion._order[t, offsets[best]:offsets[best+1]]
+            weights[members] *= 1.0 - self.q[best]
+            # Preserve the reference reduction, rather than subtracting a
+            # detection gain from a recursively maintained scalar mass.
+            total += float(weights.sum())
+            if choices is not None:
+                choices.append(best)
+        return total
+
+
+class FutureEquivalentMotion(ParticleMotion):
+    """Conservatively aggregate identical complete cell-ID columns.
+
+    All archived frames, including t=0 and exact special-bin labels, are part
+    of the signature. Thus every grouped particle has the same detection
+    factor for any future path and any scalar/cell-vector q. This fixed
+    partition may compress poorly; it does not claim minimal group count.
+
+    `groups` contains original COLUMN indices, `group_trajectory_ids` their
+    actual archived IDs, and inherited `trajectory_ids` representative IDs.
+    A grouped state is NOT an original-ID state. Final independent replay
+    uses original_motion, original_initial_weights and the unchanged path.
+
+    expand_weights restores the initial within-group proportions. It applies
+    to states evolved from the supplied initial weights under common group
+    factors, not to arbitrary original-ID beliefs after information loss.
+    """
+
+    def __init__(self, original: ParticleMotion, initial_weights):
+        if not isinstance(original, ParticleMotion):
+            raise ValueError("FutureEquivalentMotion requires ParticleMotion")
+        if isinstance(original, FutureEquivalentMotion):
+            raise ValueError("nested compression would obscure original particle IDs")
+        weights = initial_belief(initial_weights, original.state_size)
+        _, first, inverse = np.unique(original.cell_ids.T, axis=0,
+                                      return_index=True, return_inverse=True)
+        order = np.argsort(first, kind="stable")
+        remap = np.empty(len(order), dtype=np.intp)
+        remap[order] = np.arange(len(order), dtype=np.intp)
+        mapping = remap[inverse]
+        representatives = first[order]
+        super().__init__(original.cell_ids[:, representatives], original.size,
+                         original.trajectory_ids[representatives],
+                         special_bins=original.bin_count-original.size)
+        self.original_motion = original
+        self.original_initial_weights = weights
+        self.original_trajectory_ids = original.trajectory_ids.copy()
+        self.particle_to_group = mapping
+        self.representative_columns = representatives
+        self.groups = tuple(np.flatnonzero(mapping == group) for group in range(self.state_size))
+        self.group_trajectory_ids = tuple(original.trajectory_ids[group].copy() for group in self.groups)
+        self.initial_weights = self.aggregate_weights(weights)
+        for array in (self.original_initial_weights, self.original_trajectory_ids,
+                      self.particle_to_group, self.representative_columns, self.initial_weights,
+                      *self.groups, *self.group_trajectory_ids):
+            array.setflags(write=False)
+        original_n, grouped_n = original.state_size, self.state_size
+        self.compression_stats = dict(
+            original_particles=original_n, grouped_particles=grouped_n,
+            retained_fraction=grouped_n/original_n, reduction_fraction=1-grouped_n/original_n,
+            compression_ratio=original_n/grouped_n,
+            original_state_bytes=original_n*np.dtype(np.float64).itemsize,
+            grouped_state_bytes=grouped_n*np.dtype(np.float64).itemsize,
+            signature_frames=len(original.cell_ids),
+            signature="all absolute frames; exact cell IDs including frame 0 and special-bin labels",
+            grouping="fixed conservative full-column equivalence; not depth-adaptive",
+            floating_order="group aggregation may change rounding; original-ID replay remains required")
+
+    def aggregate_weights(self, original_weights):
+        """Sum current original-ID weights; no normalization or mass removal."""
+        weights = undetected_mass(original_weights, self.original_motion.state_size)
+        result = np.bincount(self.particle_to_group, weights=weights, minlength=self.state_size)
+        result.setflags(write=False)
+        return result
+
+    def expand_weights(self, grouped_weights):
+        """Restore reachable grouped states in the archived original-ID order."""
+        weights = undetected_mass(grouped_weights, self.state_size)
+        initial = self.initial_weights
+        if (np.any(weights > initial + MASS_ATOL)
+                or np.any((initial == 0) & (weights != 0))):
+            raise ValueError("group weights cannot arise from the supplied initial proportions")
+        factors = np.zeros(self.state_size, dtype=np.float64)
+        np.divide(weights, initial, out=factors, where=initial > 0)
+        result = self.original_initial_weights * factors[self.particle_to_group]
+        result.setflags(write=False)
+        return result
+
+    def sense(self, prior, vertex, sensor, step):
+        """Share only an already read-only no-change state; otherwise copy.
+
+        The caller owns immutable search states. No input write flag is ever
+        changed. A writable no-op input is copied to avoid mutable aliases.
+        """
+        offsets = self._offsets[step]
+        members = self._order[step, offsets[vertex]:offsets[vertex+1]]
+        unchanged = not members.size or sensor[vertex] == 0 or not np.any(prior[members])
+        if unchanged and not prior.flags.writeable:
+            return prior
+        posterior = prior.copy()
+        if not unchanged:
+            posterior[members] *= 1.0-sensor[vertex]
+        posterior.setflags(write=False)
+        return posterior

diff --git a/asar_repro/src/asar_repro/research_search.py b/asar_repro/src/asar_repro/research_search.py
new file mode 100644
index 0000000..2489b38
--- /dev/null
+++ b/asar_repro/src/asar_repro/research_search.py
@@ -0,0 +1,245 @@
+"""Opt-in research search; frozen search/scoring implementations stay unchanged.
+
+Paper/terminal-interception estimates only order nodes. Pruning uses an
+unweighted validated bound. No path states are merged. Auxiliary lookahead
+expansions count against the same work cap as actual successor expansions.
+"""
+from dataclasses import dataclass, field
+from heapq import heappop, heappush
+from itertools import count
+from math import inf, isfinite
+from time import perf_counter
+
+import numpy as np
+
+from .anytime_search import AnytimeResult, ATOL
+from .belief import initial_belief, sensor_probabilities
+from .grid import integer
+from .heuristic import Heuristic
+from .objective import score_path
+from .research_particle import ParticleGuide, FutureEquivalentMotion
+from .lookahead_bound import LookaheadBound
+
+
+@dataclass
+class ResearchResult(AnytimeResult):
+    candidate_archive: list = field(default_factory=list)
+
+
+def search_research(grid, *, start, budget, p, q, motion, initial_path=None,
+                    guide_weight=1.04, bound_mode="stdc_lb", fast_guide=True,
+                    portfolio=False, archive_candidates=True, cascade=False,
+                    lookahead_horizon=8,
+                    max_expansions=None, max_seconds=None, max_open=None,
+                    replay_cfg=None):
+    started = perf_counter()
+    budget = integer(budget, "budget")
+    lookahead_horizon = integer(lookahead_horizon, "lookahead_horizon", 1)
+    grid.coordinates(start)
+    if bound_mode not in ("zero", "mass_lb", "stdc_lb", "lookahead"):
+        raise ValueError("unsupported bound")
+    if not isfinite(guide_weight) or guide_weight < 1:
+        raise ValueError("guide weight must be finite and >=1")
+    for key, val in (("max_expansions", max_expansions), ("max_open", max_open)):
+        if val is not None:
+            integer(val, key)
+    if max_seconds is not None and (not isfinite(max_seconds) or max_seconds < 0):
+        raise ValueError("invalid time budget")
+    deadline = inf if max_seconds is None else started + max_seconds
+    cfg = dict(start=start, budget=budget, p=p, q=q, motion=motion)
+    if replay_cfg is not None:
+        if (not isinstance(motion, FutureEquivalentMotion)
+                or replay_cfg.get("motion") is not motion.original_motion
+                or replay_cfg.get("start") != start or replay_cfg.get("budget") != budget
+                or not np.array_equal(replay_cfg.get("p"), motion.original_initial_weights)
+                or not np.array_equal(p, motion.initial_weights)
+                or not np.array_equal(sensor_probabilities(replay_cfg.get("q"), grid.size),
+                                      sensor_probabilities(q, grid.size))):
+            raise ValueError("alternate replay requires the exact original compressed model")
+    scoring = cfg if replay_cfg is None else replay_cfg
+    sensor = sensor_probabilities(q, grid.size)
+    belief0 = initial_belief(p, motion.state_size)
+    guide = (ParticleGuide(grid, budget=budget, q=q, motion=motion) if fast_guide else
+             Heuristic(grid, budget=budget, q=q, motion=motion, mode="paper_greedy"))
+    bound = (LookaheadBound(grid, budget=budget, q=q, motion=motion, steps=2)
+             if bound_mode == "lookahead" else
+             Heuristic(grid, budget=budget, q=q, motion=motion, mode=bound_mode))
+    cheap = Heuristic(grid, budget=budget, q=q, motion=motion, mode="mass_lb")
+    base_bound = Heuristic(grid, budget=budget, q=q, motion=motion, mode="stdc_lb") if bound_mode == "lookahead" else None
+    primary, secondary, live, sequence = [], [], {}, count()
+    history, archive = [], []
+    expanded = generated = pruned = peak_open = 0
+    incumbent, incumbent_pd, best, source = inf, None, None, None
+    stats = dict(guide_calls=0, guide_wall_s=0., bound_calls=0, bound_wall_s=0.,
+                 aux_expanded=0, aux_generated=0, work_expanded=0,
+                 complete_candidates=0, candidate_replays=0, candidate_replay_wall_s=0.,
+                 accepted_improvements=0, bound_pruned=0, cheap_pruned=0, popped=0,
+                 secondary_pops=0, secondary_guide_wall_s=0., stale_entries=0,
+                 guide_used_for_pruning=False, guide_used_for_termination=False,
+                 state_merging=False, bound_is_unweighted=True, candidate_archive_scope=
+                 "nondominated replayed complete candidates encountered, not global Pareto frontier")
+
+    def timeout():
+        return "max_seconds" if perf_counter() >= deadline else None
+
+    def score(route):
+        return score_path(grid, route, **scoring)
+
+    def accept(route, replay, origin):
+        nonlocal incumbent, incumbent_pd, best, source
+        incumbent, incumbent_pd, best, source = replay.J, replay.pd_final, tuple(route), origin
+        history.append(dict(path=best, J=incumbent, Pd=incumbent_pd, expanded=expanded,
+                            work_expanded=expanded+stats["aux_expanded"], generated=generated,
+                            elapsed_s=perf_counter()-started, source=origin))
+
+    def dominated(j, pd):
+        return any(a["J"] <= j and a["Pd"] >= pd for a in archive)
+
+    def archive_add(route, replay):
+        if not archive_candidates or dominated(replay.J, replay.pd_final):
+            return
+        archive[:] = [a for a in archive
+                      if not (replay.J <= a["J"] and replay.pd_final >= a["Pd"])]
+        archive.append(dict(path=tuple(route), J=replay.J, Pd=replay.pd_final,
+                            elapsed_s=perf_counter()-started, expanded=expanded))
+
+    def terminal_guide(vertex, depth, belief):
+        # No-search target distribution at the final absolute frame. This
+        # interception estimate is deliberately NOT a bound or return objective.
+        prior = belief
+        for t in range(depth+1, budget+1):
+            prior = motion.propagate(prior, step=t)
+        distance = grid.distances_from(vertex)
+        remaining = budget-depth
+        reachable = np.flatnonzero((distance <= remaining) & ((distance-remaining) % 2 == 0))
+        mass = motion.cell_mass(prior, budget)
+        gain = float(np.max(sensor[reachable]*mass[reachable], initial=0.))
+        return remaining*max(0., float(belief.sum())-gain)
+
+    def enqueue(path, belief, g):
+        nonlocal generated, pruned, peak_open
+        depth = len(path)-1
+        generated += int(depth > 0)
+        if depth == budget:
+            stats["complete_candidates"] += 1
+            pd = 1-float(belief.sum())
+            if g < incumbent+ATOL or (archive_candidates and not dominated(g, pd)):
+                tic = perf_counter()
+                replay = score(path)
+                stats["candidate_replays"] += 1
+                stats["candidate_replay_wall_s"] += perf_counter()-tic
+                if abs(replay.J-g)>ATOL or abs(replay.pd_final-pd)>ATOL:
+                    raise AssertionError("candidate original replay mismatch")
+                archive_add(path, replay)
+                if replay.J < incumbent-ATOL:
+                    stats["accepted_improvements"] += 1
+                    accept(path, replay, "search")
+            return timeout()
+        if timeout():
+            return "max_seconds"
+        if g >= incumbent+ATOL:
+            stats["cheap_pruned"] += 1
+            pruned += 1
+            return None
+        tic = perf_counter()
+        h = guide(path[-1], depth, belief)
+        stats["guide_wall_s"] += perf_counter()-tic
+        stats["guide_calls"] += 1
+        priority = g+guide_weight*h
+        if not isfinite(priority) or not isfinite(h) or h < -ATOL:
+            raise ValueError("invalid guide")
+        alt = None
+        if portfolio:
+            tic = perf_counter()
+            alt = g+guide_weight*terminal_guide(path[-1], depth, belief)
+            stats["secondary_guide_wall_s"] += perf_counter()-tic
+        if timeout():
+            return "max_seconds"
+        needed = 2 if portfolio else 1
+        if max_open is not None and len(primary)+len(secondary)+needed > max_open:
+            return "max_open"
+        uid = next(sequence)
+        live[uid] = (path, belief, g)
+        heappush(primary, (priority, uid))
+        if portfolio:
+            heappush(secondary, (alt, uid))
+        peak_open = max(peak_open, len(primary)+len(secondary))
+        return timeout()
+
+    if initial_path is not None:
+        replay = score(initial_path)
+        accept(initial_path, replay, "initial_path")
+        archive_add(initial_path, replay)
+    reason = enqueue((start,), belief0, 0.)
+    while live and reason is None:
+        if timeout():
+            reason = "max_seconds"
+            break
+        use_secondary = portfolio and (stats["popped"]+1) % 8 == 0
+        heap = secondary if use_secondary else primary
+        while heap and heap[0][1] not in live:
+            heappop(heap)
+            stats["stale_entries"] += 1
+        if not heap:
+            raise AssertionError("live node missing from ordering queue")
+        _, uid = heappop(heap)
+        path, belief, g = live.pop(uid)
+        depth = len(path)-1
+        stats["popped"] += 1
+        stats["secondary_pops"] += int(use_secondary)
+        tic = perf_counter()
+        if cascade and g+cheap(path[-1], depth, belief) >= incumbent+ATOL:
+            h = cheap(path[-1], depth, belief)
+        elif bound_mode == "lookahead" and budget-depth <= lookahead_horizon:
+            left = None if max_expansions is None else max(0, max_expansions-expanded-stats["aux_expanded"])
+            ev = bound.evaluate(path[-1], depth, belief, cutoff=incumbent+ATOL-g,
+                                deadline=deadline, max_aux_expansions=left)
+            h = ev.value
+            stats["aux_expanded"] += ev.aux_expanded
+            stats["aux_generated"] += ev.aux_generated
+            if ev.status == "interrupted":
+                reason = "max_seconds" if ev.stop_reason == "max_seconds" else "max_expansions"
+        else:
+            h = (base_bound if bound_mode == "lookahead" else bound)(path[-1], depth, belief)
+        stats["bound_calls"] += 1
+        stats["bound_wall_s"] += perf_counter()-tic
+        if np.isnan(h) or h < -ATOL:
+            raise ValueError("invalid bound")
+        reason = reason or timeout()
+        if reason:
+            break
+        if g+h >= incumbent+ATOL:
+            pruned += 1
+            stats["bound_pruned"] += 1
+            continue
+        if max_expansions is not None and expanded+stats["aux_expanded"] >= max_expansions:
+            reason = "max_expansions"
+            break
+        expanded += 1
+        prior = motion.propagate(belief, step=depth+1)
+        for vertex in grid.neighbors(path[-1]):
+            child = motion.sense(prior, vertex, sensor, depth+1)
+            reason = enqueue(path+(vertex,), child, g+float(child.sum()))
+            if reason:
+                break
+    if best is None and reason is None:
+        raise ValueError("no feasible path")
+    if best is not None:
+        replay = score(best)
+        if abs(replay.J-incumbent)>ATOL or abs(replay.pd_final-incumbent_pd)>ATOL:
+            raise AssertionError("final original replay mismatch")
+    reason = reason or timeout()
+    wall = perf_counter()-started
+    stats.update(work_expanded=expanded+stats["aux_expanded"], frontier_remaining=len(live),
+                 physical_frontier_remaining=len(primary)+len(secondary),
+                 deadline_overshoot_s=max(0., started+wall-deadline),
+                 fast_guide=fast_guide, portfolio=portfolio, cascade=cascade)
+    if bound_mode == "lookahead":
+        stats["lookahead"] = dict(bound.stats)
+    return ResearchResult(path=best, J=None if best is None else incumbent, Pd=incumbent_pd,
+                          expanded=expanded, generated=generated, pruned=pruned, peak_open=peak_open,
+                          status="budget_exceeded" if reason else "completed", stop_reason=reason,
+                          incumbent_source=source, guide_weight=guide_weight, bound_mode=bound_mode,
+                          incumbent_history=history, stats=stats, wall_s=wall,
+                          completion_reason=None if reason else "frontier_exhausted_at_tolerance",
+                          candidate_archive=archive)

diff --git a/asar_repro/src/asar_repro/tail_repair.py b/asar_repro/src/asar_repro/tail_repair.py
new file mode 100644
index 0000000..e4ee931
--- /dev/null
+++ b/asar_repro/src/asar_repro/tail_repair.py
@@ -0,0 +1,274 @@
+"""Free-endpoint suffix repair under the unchanged full-route objective.
+
+Each phase fixes the route through absolute time a and searches every legal
+continuation through T, subject only to admissible bound pruning and explicit
+budgets. Terminal position is free. The original unnormalised prefix belief
+and its accumulated cost are retained; there is no observation at time zero.
+All accepted routes are independently replayed by the original scorer.
+
+This module neither runs a seed planner nor changes the original window
+implementation. Completion concerns the requested suffix neighbourhoods,
+and results deliberately carry no global epsilon certificate.
+"""
+
+from dataclasses import dataclass, field
+from heapq import heappop, heappush
+from itertools import count
+from math import inf, isfinite
+from time import perf_counter
+
+from .belief import sensor_probabilities
+from .grid import integer
+from .heuristic import Heuristic
+from .objective import score_path
+
+
+ATOL = 1e-10
+BOUND_MODES = ("zero", "mass_lb", "stdc_lb")
+
+
+@dataclass
+class TailRepairResult:
+    path: tuple
+    J: float
+    Pd: float
+    expanded: int
+    generated: int
+    pruned: int
+    peak_open: int
+    status: str
+    stop_reason: str | None
+    incumbent_source: str
+    bound_mode: str
+    theory_certified: bool = False
+    incumbent_history: list = field(default_factory=list)
+    stats: dict = field(default_factory=dict)
+    phases: list = field(default_factory=list)
+    wall_s: float = 0.0
+    completion_reason: str | None = None
+
+    @property
+    def history(self):
+        return self.incumbent_history
+
+
+class _Budget:
+    """One ledger for all suffix phases, preprocessing and required replay."""
+
+    def __init__(self, max_expansions, max_seconds, max_open):
+        self.started = perf_counter()
+        for name, value in (("max_expansions", max_expansions), ("max_open", max_open)):
+            if value is not None:
+                integer(value, name)
+        if max_seconds is not None and (not isfinite(max_seconds) or max_seconds < 0):
+            raise ValueError("max_seconds must be finite and nonnegative")
+        self.deadline = inf if max_seconds is None else self.started + max_seconds
+        self.cap, self.open_cap = max_expansions, max_open
+        self.expanded = self.generated = self.pruned = self.peak_open = 0
+        self.stats = dict(initial_replays=0, phase_replays=0, candidate_replays=0,
+                          final_replays=0, replay_wall_s=0.0, bound_calls=0,
+                          bound_wall_s=0.0, complete_candidates=0, accepted_improvements=0,
+                          candidate_replay_error_J_max=0.0, candidate_replay_error_Pd_max=0.0,
+                          state_merging=False, endpoint_free=True, seed_search_run=False,
+                          bound_is_unweighted=True, objective="sum M[1:T+1]",
+                          budget_scope="one shared ledger including preprocessing and full replay")
+
+    def time_stop(self):
+        return "max_seconds" if perf_counter() >= self.deadline else None
+
+    def expansion_stop(self):
+        return self.time_stop() or ("max_expansions" if self.cap is not None
+                                    and self.expanded >= self.cap else None)
+
+
+def _settings(budget, bound_mode):
+    budget = integer(budget, "budget")
+    if bound_mode not in BOUND_MODES:
+        raise ValueError("bound_mode must be zero, mass_lb or stdc_lb")
+    return budget
+
+
+def _run(grid, cfg, initial_path, starts, bound_mode, ledger, trace, requested_lengths):
+    path = tuple(initial_path)
+    history, phases = [], []
+    sensor = sensor_probabilities(cfg["q"], grid.size)
+    estimate = None
+    source = "initial_path"
+
+    def replay(route, kind, *, record_beliefs=False):
+        tic = perf_counter()
+        result = score_path(grid, route, **cfg, record_beliefs=record_beliefs)
+        ledger.stats[kind + "_replays"] += 1
+        ledger.stats["replay_wall_s"] += perf_counter() - tic
+        return result
+
+    score = replay(path, "initial")
+
+    def record(event, route, g, **extra):
+        if trace is not None:
+            trace(dict(event=event, path=tuple(route), vertex=route[-1],
+                       depth=len(route)-1, g=g, incumbent_J=score.J, **extra))
+
+    def remember(origin, a=None):
+        history.append(dict(path=path, J=score.J, Pd=score.pd_final, source=origin,
+                            a=a, expanded=ledger.expanded, generated=ledger.generated,
+                            elapsed_s=perf_counter()-ledger.started))
+        record("incumbent", path, score.J, source=origin, a=a)
+
+    remember(source)
+    reason = ledger.time_stop()
+    for phase_index, a in enumerate(starts):
+        if reason:
+            break
+        # A zero-length suffix needs no expansion and remains a valid no-op.
+        if a < cfg["budget"]:
+            reason = ledger.expansion_stop()
+            if reason:
+                break
+        tic = perf_counter()
+        before = (ledger.expanded, ledger.generated, ledger.pruned,
+                  ledger.stats["accepted_improvements"])
+        original = path
+        prefix_score = replay(original, "phase", record_beliefs=True)
+        initial_J = score.J
+        if abs(prefix_score.J-score.J) > ATOL or abs(prefix_score.pd_final-score.pd_final) > ATOL:
+            raise AssertionError("phase incumbent replay mismatch")
+        prefix = original[:a+1]
+        queue = []
+        sequence = count()
+        local_peak = 0
+        reason = ledger.time_stop()
+        if estimate is None and a < cfg["budget"] and reason is None:
+            # Horizon is always the full absolute T, not the suffix length.
+            estimate = Heuristic(grid, budget=cfg["budget"], q=cfg["q"],
+                                 motion=cfg["motion"], mode=bound_mode)
+
+        def enqueue(route, belief, g):
+            nonlocal path, score, source, local_peak
+            depth = len(route)-1
+            ledger.generated += int(depth > a)
+            if depth == cfg["budget"]:
+                ledger.stats["complete_candidates"] += 1
+                record("candidate", route, g, a=a)
+                # A just-generated improving route is replayed before stopping
+                # at a cooperative deadline, so its valid incumbent is kept.
+                if g < score.J + ATOL:
+                    candidate = replay(route, "candidate")
+                    err_j = abs(candidate.J-g)
+                    err_pd = abs(candidate.pd_final-(1.0-float(belief.sum())))
+                    if err_j > ATOL or err_pd > ATOL:
+                        raise AssertionError("tail prediction disagrees with complete replay")
+                    ledger.stats["candidate_replay_error_J_max"] = max(
+                        ledger.stats["candidate_replay_error_J_max"], err_j)
+                    ledger.stats["candidate_replay_error_Pd_max"] = max(
+                        ledger.stats["candidate_replay_error_Pd_max"], err_pd)
+                    if candidate.J < score.J - ATOL:
+                        path, score = tuple(route), candidate
+                        source = f"free_tail[{a}:{cfg['budget']}]"
+                        ledger.stats["accepted_improvements"] += 1
+                        remember(source, a)
+                return ledger.time_stop()
+            if ledger.time_stop():
+                return "max_seconds"
+            bound_started = perf_counter()
+            h = float(estimate(route[-1], depth, belief))
+            ledger.stats["bound_calls"] += 1
+            ledger.stats["bound_wall_s"] += perf_counter()-bound_started
+            lower = g+h
+            if not isfinite(lower) or h < -ATOL:
+                raise AssertionError("invalid suffix lower bound")
+            if ledger.time_stop():
+                return "max_seconds"
+            # g already contains the fixed prefix cost. Do not add it twice.
+            if lower >= score.J + ATOL:
+                ledger.pruned += 1
+                record("bound_prune", route, g, a=a, h_bound=h, lower_bound=lower)
+                return None
+            if ledger.open_cap is not None and len(queue) >= ledger.open_cap:
+                return "max_open"  # Never silently drop nodes and claim completion.
+            heappush(queue, (lower, next(sequence), tuple(route), belief, g))
+            ledger.peak_open = max(ledger.peak_open, len(queue))
+            local_peak = max(local_peak, len(queue))
+            record("push", route, g, a=a, h_bound=h, lower_bound=lower)
+            return ledger.time_stop()
+
+        if reason is None:
+            reason = enqueue(prefix, prefix_score.beliefs[a].copy(), float(prefix_score.g[a]))
+        while queue and reason is None:
+            lower, _, route, belief, g = heappop(queue)
+            record("pop", route, g, a=a, lower_bound=lower)
+            if lower >= score.J + ATOL:
+                ledger.pruned += 1
+                continue
+            reason = ledger.expansion_stop()
+            if reason:
+                break
+            ledger.expanded += 1
+            record("expand", route, g, a=a, lower_bound=lower)
+            # Prefix belief already includes the observation at a. The next
+            # motion/observation is at absolute a+1, never at local step 1.
+            t = len(route)
+            prior = cfg["motion"].propagate(belief, step=t)
+            for vertex in grid.neighbors(route[-1]):
+                detected = cfg["motion"].sense(prior, vertex, sensor, step=t)
+                reason = enqueue(route+(vertex,), detected, g+float(detected.sum()))
+                if reason:
+                    break
+        reason = reason or ledger.time_stop()
+        phases.append(dict(index=phase_index, a=a, b=cfg["budget"],
+                           length=cfg["budget"]-a, endpoint_free=True,
+                           fixed_prefix=list(prefix), initial_J=initial_J, final_J=score.J,
+                           status="budget_exceeded" if reason else "completed", stop_reason=reason,
+                           expanded=ledger.expanded-before[0], generated=ledger.generated-before[1],
+                           pruned=ledger.pruned-before[2], peak_open=local_peak,
+                           accepted_improvements=ledger.stats["accepted_improvements"]-before[3],
+                           frontier_remaining=len(queue), wall_s=perf_counter()-tic))
+
+    final = replay(path, "final")
+    if abs(final.J-score.J) > ATOL or abs(final.pd_final-score.pd_final) > ATOL:
+        raise AssertionError("final tail incumbent replay mismatch")
+    reason = reason or ledger.time_stop()
+    wall = perf_counter()-ledger.started
+    ledger.stats.update(requested_lengths=requested_lengths, requested_starts=list(starts),
+                        completed_phases=sum(row["status"] == "completed" for row in phases),
+                        started_phases=len(phases), unstarted_phases=len(starts)-len(phases),
+                        deadline_overshoot_s=max(0.0, ledger.started+wall-ledger.deadline))
+    return TailRepairResult(path, final.J, final.pd_final, ledger.expanded, ledger.generated,
+                            ledger.pruned, ledger.peak_open,
+                            "budget_exceeded" if reason else "completed", reason,
+                            source, bound_mode, incumbent_history=history, stats=ledger.stats,
+                            phases=phases, wall_s=wall,
+                            completion_reason=None if reason else "requested_free_tails_exhausted_at_tolerance")
+
+
+def repair_suffix(grid, *, start, budget, p, q, motion, initial_path, a,
+                  bound_mode="stdc_lb", max_expansions=None, max_seconds=None,
+                  max_open=None, trace=None):
+    """Optimise one free-endpoint suffix [a,T] while retaining path[:a+1]."""
+    ledger = _Budget(max_expansions, max_seconds, max_open)
+    budget = _settings(budget, bound_mode)
+    a = integer(a, "a")
+    if a > budget:
+        raise ValueError("a must satisfy 0 <= a <= budget")
+    cfg = dict(start=start, budget=budget, p=p, q=q, motion=motion)
+    return _run(grid, cfg, initial_path, (a,), bound_mode, ledger, trace, [budget-a])
+
+
+def repair_tail(grid, *, start, budget, p, q, motion, initial_path,
+                bound_mode="stdc_lb", lengths=(6, 10), max_expansions=None,
+                max_seconds=None, max_open=None, trace=None):
+    """Try deterministic suffix lengths with one shared total resource budget.
+
+    Lengths larger than T are capped at T; duplicate resulting start times are
+    searched once in first-occurrence order. Caller supplies the initial route
+    and is responsible for including any preceding planner's cost in a larger
+    experiment budget. This function performs no unreported seed search.
+    """
+    ledger = _Budget(max_expansions, max_seconds, max_open)
+    budget = _settings(budget, bound_mode)
+    lengths = tuple(integer(length, "length", 1) for length in lengths)
+    if not lengths or len(set(lengths)) != len(lengths):
+        raise ValueError("lengths must be nonempty and unique positive integers")
+    starts = tuple(dict.fromkeys(max(0, budget-length) for length in lengths))
+    cfg = dict(start=start, budget=budget, p=p, q=q, motion=motion)
+    return _run(grid, cfg, initial_path, starts, bound_mode, ledger, trace, list(lengths))

diff --git a/asar_repro/src/asar_repro/trajectory_search.py b/asar_repro/src/asar_repro/trajectory_search.py
new file mode 100644
index 0000000..97c4443
--- /dev/null
+++ b/asar_repro/src/asar_repro/trajectory_search.py
@@ -0,0 +1,240 @@
+"""Particle-DP bound controls with the frozen single-heap research ordering.
+
+Paper greedy values only order nodes. The three pruning controls use STDC,
+independent-particle legal-path DP, or their maximum. Complete routes always
+replay the unchanged objective, and histories are never merged by location.
+"""
+
+from heapq import heappop, heappush
+from itertools import count
+from math import inf, isfinite
+from time import perf_counter
+
+import numpy as np
+
+from .anytime_search import ATOL
+from .belief import initial_belief, sensor_probabilities
+from .grid import integer
+from .heuristic import Heuristic
+from .objective import score_path
+from .particle_dp import ParticleDP
+from .research_particle import FutureEquivalentMotion, ParticleGuide
+from .research_search import ResearchResult
+
+
+def search_trajectory(grid, *, start, budget, p, q, motion, initial_path=None,
+                      guide_weight=1.04, bound_mode="stdc_dp", dp=None,
+                      fast_guide=True, archive_candidates=True,
+                      max_expansions=None, max_seconds=None, max_open=None,
+                      replay_cfg=None):
+    """Run a single heap with globally paid DP construction when dp is absent.
+
+    A prebuilt DP is permitted only after compatibility/ready checks. Its
+    caller must count construction in the common invocation wall/memory scope
+    and pass the remaining ``max_seconds``; this function explicitly labels
+    the external preprocessing instead of treating it as measured local work.
+    An interrupted automatic construction preserves a replayed initial route.
+    """
+    started = perf_counter()
+    budget = integer(budget, "budget")
+    grid.coordinates(start)
+    if bound_mode not in ("stdc_lb", "dp_only", "stdc_dp"):
+        raise ValueError("unsupported trajectory bound")
+    if not isfinite(guide_weight) or guide_weight < 1:
+        raise ValueError("guide weight must be finite and >=1")
+    for key, value in (("max_expansions", max_expansions), ("max_open", max_open)):
+        if value is not None:
+            integer(value, key)
+    if max_seconds is not None and (not isfinite(max_seconds) or max_seconds < 0):
+        raise ValueError("invalid time budget")
+    deadline = inf if max_seconds is None else started + max_seconds
+    needs_dp = bound_mode != "stdc_lb"
+    supplied_dp = dp is not None
+    if supplied_dp:
+        if not needs_dp or not isinstance(dp, ParticleDP):
+            raise ValueError("prebuilt dp requires a DP bound and ParticleDP instance")
+        dp.validate_compatibility(grid, budget=budget, q=q, motion=motion)
+        if not dp.ready:
+            raise ValueError("prebuilt ParticleDP must be ready")
+    cfg = dict(start=start, budget=budget, p=p, q=q, motion=motion)
+    if replay_cfg is not None:
+        if (not isinstance(motion, FutureEquivalentMotion)
+                or replay_cfg.get("motion") is not motion.original_motion
+                or replay_cfg.get("start") != start or replay_cfg.get("budget") != budget
+                or not np.array_equal(replay_cfg.get("p"), motion.original_initial_weights)
+                or not np.array_equal(p, motion.initial_weights)
+                or not np.array_equal(sensor_probabilities(replay_cfg.get("q"), grid.size),
+                                      sensor_probabilities(q, grid.size))):
+            raise ValueError("alternate replay requires the exact original compressed model")
+    scoring = cfg if replay_cfg is None else replay_cfg
+    sensor = sensor_probabilities(q, grid.size)
+    belief0 = initial_belief(p, motion.state_size)
+    guide = (ParticleGuide(grid, budget=budget, q=q, motion=motion) if fast_guide else
+             Heuristic(grid, budget=budget, q=q, motion=motion, mode="paper_greedy"))
+    stdc = (Heuristic(grid, budget=budget, q=q, motion=motion, mode="stdc_lb")
+            if bound_mode != "dp_only" else None)
+    primary, live, sequence = [], {}, count()
+    history, archive = [], []
+    expanded = generated = pruned = peak_open = 0
+    incumbent, incumbent_pd, best, source = inf, None, None, None
+    stats = dict(guide_calls=0, guide_wall_s=0., bound_calls=0, bound_wall_s=0.,
+                 aux_expanded=0, aux_generated=0, work_expanded=0,
+                 complete_candidates=0, candidate_replays=0, candidate_replay_wall_s=0.,
+                 accepted_improvements=0, bound_pruned=0, cheap_pruned=0, popped=0,
+                 secondary_pops=0, secondary_guide_wall_s=0., stale_entries=0,
+                 guide_used_for_pruning=False, guide_used_for_termination=False,
+                 state_merging=False, bound_is_unweighted=True,
+                 dp_prebuilt=supplied_dp, dp_build_wall_s=0., dp_calls=0, dp_wall_s=0.,
+                 stdc_calls=0, stdc_wall_s=0.,
+                 preprocessing_scope=("external invocation must include prebuilt DP time/memory"
+                                      if supplied_dp else "automatic DP construction inside local deadline"),
+                 candidate_archive_scope="nondominated replayed encountered candidates, not global Pareto frontier")
+
+    def timeout():
+        return "max_seconds" if perf_counter() >= deadline else None
+
+    def score(route):
+        return score_path(grid, route, **scoring)
+
+    def accept(route, replay, origin):
+        nonlocal incumbent, incumbent_pd, best, source
+        incumbent, incumbent_pd, best, source = replay.J, replay.pd_final, tuple(route), origin
+        history.append(dict(path=best, J=incumbent, Pd=incumbent_pd, expanded=expanded,
+                            work_expanded=expanded, generated=generated,
+                            elapsed_s=perf_counter()-started, source=origin))
+
+    def dominated(j, pd):
+        return any(a["J"] <= j and a["Pd"] >= pd for a in archive)
+
+    def archive_add(route, replay):
+        if not archive_candidates or dominated(replay.J, replay.pd_final):
+            return
+        archive[:] = [a for a in archive
+                      if not (replay.J <= a["J"] and replay.pd_final >= a["Pd"])]
+        archive.append(dict(path=tuple(route), J=replay.J, Pd=replay.pd_final,
+                            elapsed_s=perf_counter()-started, expanded=expanded))
+
+    def enqueue(path, belief, g):
+        nonlocal generated, pruned, peak_open
+        depth = len(path)-1
+        generated += int(depth > 0)
+        if depth == budget:
+            stats["complete_candidates"] += 1
+            pd = 1-float(belief.sum())
+            if g < incumbent+ATOL or (archive_candidates and not dominated(g, pd)):
+                tic = perf_counter()
+                replay = score(path)
+                stats["candidate_replays"] += 1
+                stats["candidate_replay_wall_s"] += perf_counter()-tic
+                if abs(replay.J-g)>ATOL or abs(replay.pd_final-pd)>ATOL:
+                    raise AssertionError("candidate original replay mismatch")
+                archive_add(path, replay)
+                if replay.J < incumbent-ATOL:
+                    stats["accepted_improvements"] += 1
+                    accept(path, replay, "search")
+            return timeout()
+        if timeout():
+            return "max_seconds"
+        if g >= incumbent+ATOL:
+            stats["cheap_pruned"] += 1
+            pruned += 1
+            return None
+        tic = perf_counter()
+        h = guide(path[-1], depth, belief)
+        stats["guide_wall_s"] += perf_counter()-tic
+        stats["guide_calls"] += 1
+        priority = g+guide_weight*h
+        if not isfinite(priority) or not isfinite(h) or h < -ATOL:
+            raise ValueError("invalid guide")
+        if timeout():
+            return "max_seconds"
+        if max_open is not None and len(primary)+1 > max_open:
+            return "max_open"
+        uid = next(sequence)
+        live[uid] = (path, belief, g)
+        heappush(primary, (priority, uid))
+        peak_open = max(peak_open, len(primary))
+        return timeout()
+
+    if initial_path is not None:
+        replay = score(initial_path)
+        accept(initial_path, replay, "initial_path")
+        archive_add(initial_path, replay)
+    reason = None
+    if needs_dp and dp is None and budget > 0:
+        reason = timeout()
+        if reason is None:
+            tic = perf_counter()
+            dp = ParticleDP(grid, budget=budget, q=q, motion=motion, deadline=deadline)
+            stats["dp_build_wall_s"] = perf_counter()-tic
+            if not dp.ready:
+                reason = dp.stop_reason or "dp_preprocessing_incomplete"
+    if dp is not None:
+        stats["dp_build"] = dict(dp.build_info)
+        stats["dp_ready"] = bool(dp.ready)
+    else:
+        stats["dp_ready"] = False
+    reason = reason or enqueue((start,), belief0, 0.)
+    while live and reason is None:
+        if timeout():
+            reason = "max_seconds"
+            break
+        _, uid = heappop(primary)
+        path, belief, g = live.pop(uid)
+        depth = len(path)-1
+        stats["popped"] += 1
+        tic = perf_counter()
+        h = 0.0
+        if stdc is not None:
+            call_started = perf_counter()
+            h = stdc(path[-1], depth, belief)
+            stats["stdc_calls"] += 1
+            stats["stdc_wall_s"] += perf_counter()-call_started
+        if needs_dp:
+            call_started = perf_counter()
+            particle_h = dp(path[-1], depth, belief)
+            if np.isnan(particle_h) or particle_h < -ATOL:
+                raise ValueError("invalid particle DP bound")
+            h = max(h, particle_h)
+            stats["dp_calls"] += 1
+            stats["dp_wall_s"] += perf_counter()-call_started
+        stats["bound_calls"] += 1
+        stats["bound_wall_s"] += perf_counter()-tic
+        if np.isnan(h) or h < -ATOL:
+            raise ValueError("invalid bound")
+        reason = timeout()
+        if reason:
+            break
+        if g+h >= incumbent+ATOL:
+            pruned += 1
+            stats["bound_pruned"] += 1
+            continue
+        if max_expansions is not None and expanded >= max_expansions:
+            reason = "max_expansions"
+            break
+        expanded += 1
+        prior = motion.propagate(belief, step=depth+1)
+        for vertex in grid.neighbors(path[-1]):
+            child = motion.sense(prior, vertex, sensor, depth+1)
+            reason = enqueue(path+(vertex,), child, g+float(child.sum()))
+            if reason:
+                break
+    if best is None and reason is None:
+        raise ValueError("no feasible path")
+    if best is not None:
+        replay = score(best)
+        if abs(replay.J-incumbent)>ATOL or abs(replay.pd_final-incumbent_pd)>ATOL:
+            raise AssertionError("final original replay mismatch")
+    reason = reason or timeout()
+    wall = perf_counter()-started
+    stats.update(work_expanded=expanded, frontier_remaining=len(live),
+                 physical_frontier_remaining=len(primary),
+                 deadline_overshoot_s=max(0., started+wall-deadline),
+                 fast_guide=fast_guide, portfolio=False, cascade=False)
+    return ResearchResult(path=best, J=None if best is None else incumbent, Pd=incumbent_pd,
+        expanded=expanded, generated=generated, pruned=pruned, peak_open=peak_open,
+        status="budget_exceeded" if reason else "completed", stop_reason=reason,
+        incumbent_source=source, guide_weight=guide_weight, bound_mode=bound_mode,
+        incumbent_history=history, stats=stats, wall_s=wall,
+        completion_reason=None if reason else "frontier_exhausted_at_tolerance",
+        candidate_archive=archive)

diff --git a/asar_repro/src/asar_repro/window_bounds.py b/asar_repro/src/asar_repro/window_bounds.py
new file mode 100644
index 0000000..a2aeb6a
--- /dev/null
+++ b/asar_repro/src/asar_repro/window_bounds.py
@@ -0,0 +1,227 @@
+"""Fixed-suffix coefficients and lower bounds for a fixed-time path window.
+
+These bounds apply to the chosen endpoint, end time and fixed suffix only.
+They do not certify global optimality of the full search-and-rescue route.
+All times are absolute frames: frame zero is before any observation.
+"""
+
+from dataclasses import dataclass
+from math import inf
+
+import numpy as np
+
+from .belief import float_array, sensor_probabilities, undetected_mass
+from .grid import GridGraph, integer
+from .motion import MatrixMotion, ParticleMotion
+
+
+WINDOW_MODES = ("zero", "mass_lb", "stdc_lb", "stdc_endpoint_lb")
+
+
+def _check_motion(grid, motion, horizon):
+    if not isinstance(motion, (MatrixMotion, ParticleMotion)):
+        raise ValueError("window bounds require MatrixMotion or ParticleMotion")
+    if grid.size != motion.size:
+        raise ValueError("motion grid size must match the search grid")
+    if isinstance(motion, ParticleMotion):
+        motion.check_horizon(horizon)
+    elif not motion._repeat and horizon > len(motion._matrices):
+        raise ValueError(f"missing P_t for step {horizon}")
+
+
+def _distances(grid, source):
+    row, col = grid.coordinates(source)
+    vertices = np.arange(grid.size, dtype=np.intp)
+    return np.abs(vertices // grid.cols - row) + np.abs(vertices % grid.cols - col)
+
+
+def _exact_mask(distances, steps, grid_size):
+    if steps == 0:
+        return distances == 0
+    if grid_size == 1:
+        return np.zeros(1, dtype=bool)  # A no-wait single vertex has no edges.
+    return (distances <= steps) & ((steps - distances) % 2 == 0)
+
+
+def exact_reachable(grid: GridGraph, source: int, steps: int) -> np.ndarray:
+    """Sorted vertex IDs after exactly ``steps`` four-neighbour, no-wait moves.
+
+    Unlike the original STDC helper, zero steps is defined and returns source.
+    A one-vertex graph has an empty reachable set at every positive step.
+    """
+    steps = integer(steps, "steps")
+    result = np.flatnonzero(_exact_mask(_distances(grid, source), steps, grid.size))
+    result.setflags(write=False)
+    return result
+
+
+@dataclass(frozen=True)
+class SuffixCoefficients:
+    """Nonnegative linear coefficients for an immutable path snapshot.
+
+    cost[d] excludes observations at or before d. Thus a complete candidate's
+    objective equals its accumulated g[d] plus cost[d] @ belief[d]. Its final
+    remaining mass is survival[d] @ belief[d]. Arrays are read-only.
+    """
+
+    cost: np.ndarray
+    survival: np.ndarray
+
+
+def suffix_coefficients(grid: GridGraph, path, *, q,
+                        motion: MatrixMotion | ParticleMotion) -> SuffixCoefficients:
+    """Build exact fixed-suffix cost and terminal-mass coefficients backwards.
+
+    With row-stochastic P_t, forward beliefs use D_t P_t.T b; its adjoint is
+    P_t D_t. This distinction is essential for non-symmetric dynamic kernels.
+    Particle weights retain their ID columns and use the supplied absolute
+    cell_ids[t]. Special bins never match a legal searched vertex.
+    """
+    path = tuple(path)
+    if not path:
+        raise ValueError("path must contain at least its starting vertex")
+    horizon = len(path) - 1
+    grid.validate_path(path, start=path[0], budget=horizon)
+    _check_motion(grid, motion, horizon)
+    sensor = sensor_probabilities(q, grid.size)
+    cost = np.zeros((horizon + 1, motion.state_size), dtype=np.float64)
+    survival = np.ones_like(cost)
+    for t in range(horizon, 0, -1):
+        vertex = path[t]
+        factors = np.ones(motion.state_size, dtype=np.float64)
+        if isinstance(motion, ParticleMotion):
+            factors[motion.cell_ids[t] == vertex] = 1.0 - sensor[vertex]
+            cost[t - 1] = factors * (1.0 + cost[t])
+            survival[t - 1] = factors * survival[t]
+        else:
+            factors[vertex] = 1.0 - sensor[vertex]
+            kernel = motion._matrices[0 if motion._repeat else t - 1]
+            cost[t - 1] = kernel @ (factors * (1.0 + cost[t]))
+            survival[t - 1] = kernel @ (factors * survival[t])
+    cost.setflags(write=False)
+    survival.setflags(write=False)
+    return SuffixCoefficients(cost=cost, survival=survival)
+
+
+class WindowHeuristic:
+    """Remaining window cost plus a fixed suffix's nonnegative terminal cost.
+
+    One instance fixes the endpoint, absolute end time, sensor and tail_cost.
+    Geometry is reused only within that instance; no belief-dependent estimate
+    is cached. If a caller changes the suffix, it must make a new instance.
+
+    In endpoint mode, every legal completion's kth vertex belongs to the
+    intersection of exact-k reachability from the current vertex and exact
+    (R-k) reachability from the fixed endpoint. Simultaneously sensing this
+    entire intersection gives a componentwise lower undetected belief. The
+    STDC mass recurrence lower-bounds each window cost, and tail_cost dotted
+    with the relaxed endpoint belief lower-bounds the unchanged suffix cost.
+    """
+
+    def __init__(self, grid: GridGraph, *, end_vertex: int, end_depth: int, q,
+                 motion: MatrixMotion | ParticleMotion, tail_cost,
+                 mode: str = "stdc_endpoint_lb"):
+        if mode not in WINDOW_MODES:
+            raise ValueError(f"unknown window heuristic: {mode}")
+        grid.coordinates(end_vertex)
+        self.grid = grid
+        self.end_vertex = int(end_vertex)
+        self.end_depth = integer(end_depth, "end_depth")
+        _check_motion(grid, motion, self.end_depth)
+        self.motion = motion
+        self.mode = mode
+        self.q = sensor_probabilities(q, grid.size).copy()
+        self.q.setflags(write=False)
+        tail = float_array(tail_cost, "tail_cost")
+        if (tail.shape != (motion.state_size,) or not np.all(np.isfinite(tail))
+                or np.any(tail < 0)):
+            raise ValueError("tail_cost must be a finite nonnegative state-sized vector")
+        self.tail_cost = tail.copy()
+        self.tail_cost.setflags(write=False)
+        self._tail_min = float(self.tail_cost.min())
+        self._end_distances = _distances(grid, self.end_vertex)
+        self._distances = {self.end_vertex: self._end_distances}
+        self._geometry = {}
+        # Avoid a division by q and retain the q=0/q=1 edge cases.
+        a = 1.0 - float(self.q.max())
+        self._mass_factors = [0.0]
+        self._mass_powers = [1.0]
+        for _ in range(self.end_depth):
+            self._mass_factors.append(a * (1.0 + self._mass_factors[-1]))
+            self._mass_powers.append(a * self._mass_powers[-1])
+
+    def _feasible(self, vertex, remaining):
+        if remaining == 0:
+            return vertex == self.end_vertex
+        if self.grid.size == 1:
+            return False
+        distance = int(self._end_distances[vertex])
+        return distance <= remaining and (remaining - distance) % 2 == 0
+
+    def _step_geometry(self, vertex, remaining, k):
+        key = (vertex, remaining if self.mode == "stdc_endpoint_lb" else None, k)
+        cached = self._geometry.get(key)
+        if cached is not None:
+            return cached
+        if vertex not in self._distances:
+            self._distances[vertex] = _distances(self.grid, vertex)
+        mask = _exact_mask(self._distances[vertex], k, self.grid.size)
+        if self.mode == "stdc_endpoint_lb":
+            mask &= _exact_mask(self._end_distances, remaining - k, self.grid.size)
+        reach = np.flatnonzero(mask)
+        # _feasible ensures a complete path exists, hence each intersection is
+        # nonempty. Treat an empty set as a model inconsistency, not zero cost.
+        if not reach.size:
+            raise ValueError("empty reachable set for a feasible window")
+        qr = self.q[reach]
+        miss = 1.0 - qr
+        factors = None
+        if isinstance(self.motion, ParticleMotion):
+            factors = np.ones(self.motion.bin_count, dtype=np.float64)
+            factors[reach] = miss
+            factors.setflags(write=False)
+        for array in (reach, qr, miss):
+            array.setflags(write=False)
+        value = (reach, qr, miss, float(qr.max()), factors)
+        self._geometry[key] = value
+        return value
+
+    def __call__(self, vertex: int, depth: int, belief) -> float:
+        self.grid.coordinates(vertex)
+        vertex = int(vertex)
+        depth = integer(depth, "depth")
+        if depth > self.end_depth:
+            raise ValueError("depth exceeds window end_depth")
+        b = undetected_mass(belief, self.motion.state_size)
+        remaining = self.end_depth - depth
+        if not self._feasible(vertex, remaining):
+            return inf
+        if remaining == 0:
+            return float(self.tail_cost @ b)
+        if self.mode == "zero":
+            return 0.0
+        mass = float(b.sum())
+        if self.mode == "mass_lb":
+            return float(mass * self._mass_factors[remaining]
+                         + self._tail_min * mass * self._mass_powers[remaining])
+
+        relaxed = b.copy()
+        no_search = b.copy()
+        ell = mass
+        total = 0.0
+        particles = isinstance(self.motion, ParticleMotion)
+        for k in range(1, remaining + 1):
+            t = depth + k
+            reach, qr, miss, qmax, factors = self._step_geometry(vertex, remaining, k)
+            if particles:
+                relaxed *= factors[self.motion.cell_ids[t]]
+            else:
+                relaxed = self.motion.propagate(relaxed, step=t)
+                relaxed[reach] *= miss
+                no_search = self.motion.propagate(no_search, step=t)
+            a = float(relaxed.sum())
+            mu = self.motion.cell_mass(no_search, t)
+            u = float(np.max(qr * mu[reach]))
+            ell = max(a, (1.0 - qmax) * ell, ell - u)
+            total += ell
+        return float(total + self.tail_cost @ relaxed)

diff --git a/asar_repro/src/asar_repro/window_search.py b/asar_repro/src/asar_repro/window_search.py
new file mode 100644
index 0000000..cf15b5b
--- /dev/null
+++ b/asar_repro/src/asar_repro/window_search.py
@@ -0,0 +1,279 @@
+"""Research-only, fixed-time endpoint-preserving route improvement.
+
+The objective/evaluator and global A^SAR remain unchanged. Local completion
+certifies neither a globally optimal route nor a global epsilon bound.
+"""
+from dataclasses import asdict, dataclass, field
+from heapq import heappop, heappush
+from itertools import count
+from math import inf, isfinite
+from time import perf_counter
+
+from .belief import sensor_probabilities
+from .grid import integer
+from .objective import score_path
+from .search import search_asar
+from .window_bounds import WINDOW_MODES, WindowHeuristic, suffix_coefficients
+
+ATOL = 1e-10
+
+
+@dataclass
+class WindowResult:
+    path: tuple
+    J: float
+    Pd: float
+    expanded: int
+    generated: int
+    pruned: int
+    peak_open: int
+    status: str
+    stop_reason: str | None
+    incumbent_source: str
+    theory_certified: bool = False
+    seed: dict = field(default_factory=dict)
+    windows: list = field(default_factory=list)
+    improvements: list = field(default_factory=list)
+    wall_s: float = 0.0
+    completion_reason: str | None = None
+    heuristic_evaluations: int = 0
+    complete_candidates: int = 0
+    accepted_replays: int = 0
+    deadline_overshoot_s: float = 0.0
+
+
+class _Budget:
+    def __init__(self, max_expansions, max_seconds, max_open):
+        self.started = perf_counter()
+        for name, value in (("max_expansions", max_expansions), ("max_open", max_open)):
+            if value is not None:
+                integer(value, name)
+        if max_seconds is not None and (not isfinite(max_seconds) or max_seconds < 0):
+            raise ValueError("max_seconds must be finite and nonnegative")
+        self.deadline = inf if max_seconds is None else self.started + max_seconds
+        self.cap = max_expansions
+        self.open_cap = max_open
+        self.expanded = self.generated = self.pruned = self.peak_open = 0
+        self.heuristic_evaluations = self.complete_candidates = self.accepted_replays = 0
+
+    def time_stop(self):
+        return "max_seconds" if perf_counter() >= self.deadline else None
+
+    def expansion_stop(self):
+        return self.time_stop() or ("max_expansions" if self.cap is not None
+                                    and self.expanded >= self.cap else None)
+
+
+def _settings(mode, lengths=None):
+    if mode not in WINDOW_MODES:
+        raise ValueError(f"unknown window mode: {mode}")
+    if lengths is not None:
+        lengths = tuple(integer(x, "window_length", minimum=1) for x in lengths)
+        if not lengths or len(set(lengths)) != len(lengths):
+            raise ValueError("window_lengths must be nonempty and unique")
+        return lengths
+
+
+def _finish(grid, cfg, path, expected, ledger, reason, source, seed, windows,
+            improvements, completion_reason):
+    # Mandatory full replay is included in wall time, even at a cooperative stop.
+    replay = score_path(grid, path, **cfg)
+    if abs(replay.J - expected.J) > ATOL or abs(replay.pd_final - expected.pd_final) > ATOL:
+        raise AssertionError("final independent replay mismatch")
+    reason = reason or ledger.time_stop()
+    wall = perf_counter() - ledger.started
+    return WindowResult(tuple(path), replay.J, replay.pd_final, ledger.expanded,
+        ledger.generated, ledger.pruned, ledger.peak_open,
+        "budget_exceeded" if reason else "completed", reason, source,
+        seed=seed, windows=windows, improvements=improvements, wall_s=wall,
+        completion_reason=None if reason else completion_reason,
+        heuristic_evaluations=ledger.heuristic_evaluations,
+        complete_candidates=ledger.complete_candidates,
+        accepted_replays=ledger.accepted_replays,
+        deadline_overshoot_s=max(0.0, ledger.started + wall - ledger.deadline))
+
+
+def _window(grid, cfg, path, a, b, mode, ledger, improvements):
+    """No state merging: every heap entry retains its full conditional belief."""
+    tic = perf_counter()
+    before = (ledger.expanded, ledger.generated, ledger.pruned)
+    original = tuple(path)
+    initial = score_path(grid, original, **cfg, record_beliefs=True)
+    current = initial
+    coeff = suffix_coefficients(grid, original, q=cfg['q'], motion=cfg['motion'])
+    estimate = WindowHeuristic(grid, end_vertex=original[b], end_depth=b,
+        q=cfg['q'], motion=cfg['motion'], tail_cost=coeff.cost[b], mode=mode)
+    sensor = sensor_probabilities(cfg['q'], grid.size)
+    prefix_g = float(initial.g[a])
+    seq = count()
+    queue = []
+    local_peak_open = 0
+    accepted_start = len(improvements)
+    reason = ledger.time_stop()
+
+    def enqueue(vertex, depth, belief, g, route):
+        nonlocal local_peak_open
+        # Match legacy A^SAR: generated materialized child states exclude roots.
+        ledger.generated += int(depth > a)
+        if depth == b:
+            if vertex != original[b]:
+                raise AssertionError("infeasible endpoint reached")
+            ledger.complete_candidates += 1
+            predicted_j = prefix_g + g + float(coeff.cost[b] @ belief)
+            predicted_pd = 1.0 - float(coeff.survival[b] @ belief)
+            if not isfinite(predicted_j) or not isfinite(predicted_pd):
+                raise AssertionError("non-finite exact suffix score")
+            # Replay possible improvements before a cooperative deadline stop;
+            # preserve every fully generated, validated improving incumbent.
+            nonlocal path, current
+            if predicted_j < current.J + ATOL:
+                candidate = original[:a] + route + original[b+1:]
+                replay = score_path(grid, candidate, **cfg)
+                err_j, err_pd = abs(replay.J-predicted_j), abs(replay.pd_final-predicted_pd)
+                if err_j > ATOL or err_pd > ATOL:
+                    raise AssertionError("exact suffix prediction disagrees with full replay")
+                if replay.J < current.J - ATOL:
+                    improvements.append(dict(a=a, b=b, old_J=current.J, J=replay.J,
+                        old_Pd=current.pd_final, Pd=replay.pd_final,
+                        prediction_error_J=err_j, prediction_error_Pd=err_pd,
+                        expanded_total=ledger.expanded, elapsed_s=perf_counter()-ledger.started,
+                        path=list(candidate), source=f"window[{a}:{b}]"))
+                    path, current = candidate, replay
+                    ledger.accepted_replays += 1
+            return ledger.time_stop()
+        if ledger.time_stop():
+            return "max_seconds"
+        ledger.heuristic_evaluations += 1
+        h = estimate(vertex, depth, belief)
+        if not isfinite(h) or h < -ATOL:
+            raise AssertionError("invalid bound on a feasible window prefix")
+        lower = prefix_g + g + h
+        if ledger.time_stop():
+            return "max_seconds"
+        # Conservative rounding guard: never prune using incumbent minus tol.
+        if lower >= current.J + ATOL:
+            ledger.pruned += 1
+            return None
+        if ledger.open_cap is not None and len(queue) >= ledger.open_cap:
+            return "max_open"
+        heappush(queue, (lower, next(seq), vertex, depth, belief, g, route))
+        ledger.peak_open = max(ledger.peak_open, len(queue))
+        local_peak_open = max(local_peak_open, len(queue))
+        return None
+
+    if reason is None:
+        reason = enqueue(original[a], a, initial.beliefs[a].copy(), 0.0, (original[a],))
+    while queue and reason is None:
+        lower, _, vertex, depth, belief, g, route = heappop(queue)
+        if lower >= current.J + ATOL:
+            ledger.pruned += 1
+            continue
+        reason = ledger.expansion_stop()
+        if reason:
+            break
+        ledger.expanded += 1
+        t = depth + 1
+        moved = cfg['motion'].propagate(belief, step=t)
+        for nxt in grid.neighbors(vertex):
+            # Common exact endpoint feasibility is independent of heuristic.
+            if not estimate._feasible(nxt, b-t):
+                ledger.pruned += 1
+                continue
+            detected = cfg['motion'].sense(moved, nxt, sensor, step=t)
+            reason = enqueue(nxt, t, detected, g+float(detected.sum()), route+(nxt,))
+            if reason:
+                break
+    reason = reason or ledger.time_stop()
+    record = dict(a=a, b=b, mode=mode, initial_J=initial.J, final_J=current.J,
+        status="budget_exceeded" if reason else "completed", stop_reason=reason,
+        expanded=ledger.expanded-before[0], generated=ledger.generated-before[1],
+        pruned=ledger.pruned-before[2], improvements=len(improvements)-accepted_start,
+        peak_open=local_peak_open, wall_s=perf_counter()-tic, neighborhood_only=True)
+    return tuple(path), current, reason, record
+
+
+def solve_window(grid, *, start, budget, p, q, motion, path, a, b,
+                 mode="stdc_endpoint_lb", max_expansions=None, max_seconds=None,
+                 max_open=None):
+    """Solve one fixed window with an exact unchanged suffix; useful for Oracle checks."""
+    ledger = _Budget(max_expansions, max_seconds, max_open)
+    _settings(mode)
+    a, b = integer(a, "a"), integer(b, "b")
+    if not 0 <= a < b <= budget:
+        raise ValueError("window must satisfy 0 <= a < b <= budget")
+    cfg = dict(start=start, budget=budget, p=p, q=q, motion=motion)
+    improvements = []
+    path, score, reason, record = _window(grid, cfg, tuple(path), a, b, mode, ledger, improvements)
+    source = improvements[-1]['source'] if improvements else "initial_path"
+    return _finish(grid, cfg, path, score, ledger, reason, source, {}, [record],
+                   improvements, "fixed_window_exhausted_at_tolerance")
+
+
+def improve_with_windows(grid, *, start, budget, p, q, motion, initial_path,
+                         epsilon=1.1, mode="stdc_endpoint_lb", window_lengths=(4, 6),
+                         seed_max_expansions=1500, max_expansions=5000,
+                         max_open=20000, max_seconds=30):
+    """Pay for a paper seed, then perform deterministic local improvement sweeps.
+
+    Seed expansion subquota is an explicit method allocation. Seed time/OPEN
+    stops remain global stops. All queues share one total expansion/time cap;
+    OPEN is the peak physical queue size across the sequential search phases.
+    Acceptance minimizes the original full J, without adding a Pd constraint.
+    """
+    ledger = _Budget(max_expansions, max_seconds, max_open)
+    lengths = _settings(mode, window_lengths)
+    seed_max_expansions = integer(seed_max_expansions, "seed_max_expansions")
+    cfg = dict(start=start, budget=budget, p=p, q=q, motion=motion)
+    path = tuple(initial_path)
+    score = score_path(grid, path, **cfg)
+    reason = ledger.time_stop()
+    source, seed, windows, improvements = "initial_path", {}, [], []
+    if reason is None:
+        seed_cap = seed_max_expansions if ledger.cap is None else min(seed_max_expansions, ledger.cap)
+        tic = perf_counter()
+        seeded = search_asar(grid, **cfg, initial_path=path, heuristic="paper_greedy",
+            epsilon=epsilon, max_expansions=seed_cap, max_open=max_open,
+            max_seconds=None if ledger.deadline == inf else max(0., ledger.deadline-perf_counter()))
+        seed = dict(**asdict(seeded), cap_kind="method_subbudget", expansion_quota=seed_cap,
+                    wall_s=perf_counter()-tic, phase_budget_exceeded=seeded.status=="budget_exceeded")
+        ledger.expanded, ledger.generated, ledger.pruned = seeded.expanded, seeded.generated, seeded.pruned
+        ledger.peak_open = seeded.peak_open
+        path = tuple(seeded.path)
+        score = score_path(grid, path, **cfg)
+        if abs(score.J-seeded.J) > ATOL:
+            raise AssertionError("seed replay mismatch")
+        source = "seed_search" if seeded.incumbent_source == "search" else "initial_path"
+        if seeded.stop_reason and seeded.stop_reason != "max_expansions":
+            reason = seeded.stop_reason
+        reason = reason or ledger.expansion_stop()
+        seed['remaining_global_expansions'] = None if ledger.cap is None else ledger.cap-ledger.expanded
+        seed['continuing_after_subquota'] = seeded.stop_reason == "max_expansions" and reason is None
+    stalled = False
+    sweep = 0
+    while reason is None:
+        changed = False
+        for length in lengths:
+            for a in range(max(0, budget-length+1)):
+                reason = ledger.expansion_stop()
+                if reason:
+                    break
+                before = len(improvements)
+                path, score, reason, row = _window(grid, cfg, path, a, a+length,
+                                                  mode, ledger, improvements)
+                row['sweep'] = sweep
+                windows.append(row)
+                if len(improvements) > before:
+                    changed = True
+                    source = improvements[-1]['source']
+                if reason:
+                    break
+            if reason:
+                break
+        if reason:
+            break
+        if not changed:
+            stalled = True
+            break
+        sweep += 1
+    return _finish(grid, cfg, path, score, ledger, reason, source, seed, windows,
+                   improvements, "local_stalled_at_tolerance" if stalled else None)

