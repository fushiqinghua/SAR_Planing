+def test_custom_bound_receives_absolute_depth_and_unnormalised_prefix():
+    grid, cfg, initial = toy_case("dynamic")
+    estimate = Heuristic(grid, budget=cfg["budget"], q=cfg["q"], motion=cfg["motion"], mode="stdc_lb")
+    calls = []
