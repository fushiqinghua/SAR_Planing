+        update_summary(run)
+        (run / 'stdout.txt').write_text('Initialization status: ' + pre['status'] + '\n', encoding='utf-8')
+        (run / 'stderr.txt').write_text(pre.get('traceback', ''), encoding='utf-8')
+    print(json.dumps(dict(action='init', status=pre['status'], wall_s=pre['wall_s']), ensure_ascii=False))
+    return 0 if pre['status'] == 'passed' else 2
+
+
+def child_environment():
+    env = os.environ.copy()
+    for key in ('OMP_NUM_THREADS', 'OPENBLAS_NUM_THREADS', 'MKL_NUM_THREADS', 'NUMEXPR_NUM_THREADS'):
+        env[key] = '1'
+    env['PROJ_NETWORK'] = 'OFF'
+    env['PYTHONDONTWRITEBYTECODE'] = '1'
+    env['PYTHONPATH'] = str(ROOT / 'src') + (os.pathsep + env['PYTHONPATH'] if env.get('PYTHONPATH') else '')
+    return env
+
+
+def stage(run, name):
+    folder = run / name
+    folder.mkdir(exist_ok=False)
+    tic = perf_counter()
+    record = dict(status='running', stage=name, started_utc=datetime.now(timezone.utc).isoformat(),
+                  driver_command=[sys.executable, *sys.argv], cwd=str(ROOT), timeout_s=1200)
+    try:
+        require(read(run / 'validation_summary.json')['status'] != 'blocked', 'run already blocked: stop')
+        for prior in ORDER[:ORDER.index(name)] if name in ORDER else ORDER:
+            require(read(run / prior / 'stage.json')['status'] == 'passed', 'prior stage not passed: ' + prior)
+        record['preservation_before'] = preserve(run)
+        snapshot(folder, run)
+        if name == 'final_preservation':
+            record.update(command=None, seeds=None, test_counts=None,
+                          preservation_after=preserve(run), status='passed')
+            (folder / 'stdout.txt').write_text('All frozen baseline, research inputs/results and source fingerprints preserved.\n', encoding='utf-8')
+            (folder / 'stderr.txt').write_text('', encoding='utf-8')
+        else:
+            env = child_environment()
+            record['child_environment'] = {key: env[key] for key in (
+                'OMP_NUM_THREADS', 'OPENBLAS_NUM_THREADS', 'MKL_NUM_THREADS', 'NUMEXPR_NUM_THREADS',
+                'PROJ_NETWORK', 'PYTHONDONTWRITEBYTECODE', 'PYTHONPATH')}
+            if name in ('new_tests', 'full_tests'):
+                command = [sys.executable, '-m', 'pytest', '-x', '-q', '-p', 'no:cacheprovider']
+                command += ['tests/test_window_bounds.py', 'tests/test_window_search.py'] if name == 'new_tests' else ['tests']
+                # Avoid Unicode NetCDF temp paths and pytest's nonrecursive leaf creation.
+                ascii_id = hashlib.sha256(str(run).encode('utf-8')).hexdigest()[:12]
+                temp = TEMP_ROOT / ascii_id / name
+                temp.parent.mkdir(parents=True, exist_ok=True)
+                command += ['--junitxml', str(folder / 'pytest.xml'), '--basetemp', str(temp)]
+                record['seeds'] = [100, 101, 102, 103] if name == 'new_tests' else 'Explicit fixed seeds/fixtures in frozen source_sha256.json; includes particle seed 41'
+            else:
+                script = 'audit_window_bounds.py' if name == 'random_audit' else 'audit_window_search.py'
+                command = [sys.executable, 'scripts/' + script, '--output-dir', str(folder / 'audit')]
+                record['seeds'] = list(range(100, 180)) if name == 'random_audit' else dict(
+                    historical=list(range(15000, 15035)), derived=list(range(15000, 15005)))
+                record['test_counts'] = None
+            record['command'] = command
+            save(folder / 'command.json', dict(command=command, cwd=str(ROOT), seeds=record['seeds'],
+                                              environment=record['child_environment'], timeout_s=1200))
+            save(folder / 'stage.json', record)
+            with (folder / 'stdout.txt').open('w', encoding='utf-8') as stdout, (folder / 'stderr.txt').open('w', encoding='utf-8') as stderr:
+                proc = subprocess.run(command, cwd=ROOT, stdout=stdout, stderr=stderr, env=env, timeout=1200)
+            record['exit_code'] = proc.returncode
+            if name in ('new_tests', 'full_tests'):
+                require((folder / 'pytest.xml').is_file(), 'pytest JUnit report missing')
+                suites = ET.parse(folder / 'pytest.xml').getroot()
+                counts = {key: sum(int(s.get(key, 0)) for s in suites.iter('testsuite'))
+                          for key in ('tests', 'errors', 'failures', 'skipped')}
+                record['test_counts'] = counts
+                require(counts['tests'] > 0, 'empty pytest collection')
+                require(counts['errors'] == counts['failures'] == counts['skipped'] == 0,
+                        'pytest failure/error/skip: STOP')
+                if name == 'full_tests':
+                    require(counts['tests'] > read(run / 'new_tests/stage.json')['test_counts']['tests'],
+                            'full tests did not include additional historical tests')
+            require(proc.returncode == 0, 'stage failed: STOP; inspect stdout/stderr')
+            if name in ('random_audit', 'small_search'):
+                audit = read(folder / 'audit/summary.json')
+                require(audit['status'] == 'passed', 'Oracle audit did not pass')
+                if name == 'random_audit':
+                    require(audit['case_count'] == 160, 'incomplete random audit')
+                else:
+                    require(audit['cases'] == 45 and audit['searches'] == 360, 'incomplete small search audit')
+                record['audit_summary'] = audit
+            record['preservation_after'] = preserve(run)
+            record['status'] = 'passed'
+    except Exception as exc:
+        record.update(status='blocked', error=str(exc), traceback=traceback.format_exc())
+        if isinstance(exc, subprocess.TimeoutExpired):
+            record.update(stop_reason='validation_watchdog', timeout_s=exc.timeout)
+        with (folder / 'stderr.txt').open('a', encoding='utf-8') as stream:
+            stream.write('\n' + record['traceback'])
+        if not (folder / 'stdout.txt').exists():
+            (folder / 'stdout.txt').write_text('', encoding='utf-8')
+    finally:
+        record['wall_s'] = perf_counter() - tic
+        save(folder / 'stage.json', record)
+        # Real runs pin the passed four-stage evidence by SHA. A successful
+        # final preservation check is separate evidence and must not rewrite it.
+        if name != 'final_preservation' or record['status'] != 'passed':
+            update_summary(run)
+    print(json.dumps(dict(action=name, status=record['status'], wall_s=record['wall_s'],
+                          test_counts=record.get('test_counts'), error=record.get('error')), ensure_ascii=False), flush=True)
+    return 0 if record['status'] == 'passed' else 2
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('action', choices=['init', *ORDER, 'final_preservation'])
+    parser.add_argument('--run-dir', type=Path, required=True)
+    args = parser.parse_args()
+    run = args.run_dir.resolve()
+    output_root = (ROOT / 'outputs/stdc_v0_2').resolve()
+    require(run != output_root and run.is_relative_to(output_root), 'new research output subdirectory required')
+    return init(run) if args.action == 'init' else stage(run, args.action)
+
+
+if __name__ == '__main__':
+    sys.exit(main())

diff --git a/asar_repro/src/asar_repro/adaptive_search.py b/asar_repro/src/asar_repro/adaptive_search.py
new file mode 100644
index 0000000..ffa25a1
--- /dev/null
+++ b/asar_repro/src/asar_repro/adaptive_search.py
@@ -0,0 +1,184 @@
+"""Opt-in shared-budget orchestration; frozen planners and scorer stay unchanged."""
+from dataclasses import asdict
+from math import inf, isfinite
+from time import perf_counter
+
+from .grid import integer
+from .heuristic import Heuristic
+from .particle_dp import ParticleDP
+from .resumable_search import SearchSession
+
+ATOL = 1e-10
+
+def search_adaptive(grid, *, start, budget, p, q, motion, initial_path,
+                    schedule="direct", dp_kind="none", dp_mode="max",
+                    efficient_guide=False, lazy_rollout=True, diversity_slots=0,
+                    max_expansions=None, max_seconds=None, max_open=None,
+                    dp_memory_bytes=128*2**20, global_chunk=512, burst_work=128,
+                    local_fraction=.1, trace=None):
+    """All preprocessing/global/local work shares one absolute deadline.
+
+    direct: resumable STDC control; recycle: old midpoint then resume global;
+    bursts: opt-in short windows, interleaved with retained global frontier.
+    Partial/local completion never certifies the global result.
+    """
+    if schedule not in ("direct", "recycle", "bursts"):
+        raise ValueError("unsupported schedule")
+    if dp_kind not in ("none", "dense", "compact") or dp_mode not in ("max", "only"):
+        raise ValueError("unsupported DP mode")
+    for name, value in (("max_expansions", max_expansions), ("max_open", max_open)):
+        if value is not None: integer(value, name)
+    integer(global_chunk, "global_chunk", 1); integer(burst_work, "burst_work", 1)
+    if not 0 <= local_fraction < 1: raise ValueError("invalid local fraction")
+    if max_seconds is not None and (max_seconds < 0 or not isfinite(max_seconds)):
+        raise ValueError("invalid time budget")
+    started=perf_counter()
+    deadline=inf if max_seconds is None else started+max_seconds
+    cfg=dict(start=start,budget=budget,p=p,q=q,motion=motion)
+    phases=[];prep={};local_work=local_generated=local_pruned=0;peak=0
+    dp=None;guide=None;roll=None;attempted_old=False;resumed=False
+    next_local_global=0;local_stalls=0
+    bound=Heuristic(grid,budget=budget,q=q,motion=motion,mode="stdc_lb")
+    stdc_component=bound
+    if dp_kind != "none":
+        if dp_kind=="compact":
+            from .compact_particle_dp import CompactParticleDP
+            dp=CompactParticleDP(grid,start=start,budget=budget,q=q,motion=motion,
+                deadline=deadline,max_memory_bytes=dp_memory_bytes)
+        else:
+            dp=ParticleDP(grid,budget=budget,q=q,motion=motion,
+                deadline=deadline,max_memory_bytes=dp_memory_bytes)
+        prep["dp"]=dict(dp.build_info)
+        prep["dp_fallback"]=not dp.ready
+        prep["fallback_policy"]="unfinished DP uses STDC under the unchanged remaining global deadline"
+        if dp.ready:
+            stdc=bound
+            bound=dp if dp_mode=="only" else lambda v,d,b:max(stdc(v,d,b),dp(v,d,b))
+        else: dp=None
+    if efficient_guide:
+        from .sparse_particle_guide import SparseParticleGuide
+        guide=SparseParticleGuide(grid,budget=budget,q=q,motion=motion)
+    prep["method_preprocessing_s"]=perf_counter()-started
+    session=SearchSession(grid,**cfg,initial_path=initial_path,guide_weight=1.04,
+        bound=bound,guide=guide,max_open=max_open,deadline=deadline,
+        bound_mode=('dp_only' if dp_mode=='only' else 'stdc_dp') if dp is not None else 'stdc_lb')
+    session_offset=session.started-started
+    def remaining_work():
+        return None if max_expansions is None else max(0,max_expansions-session.expanded-local_work)
+    def quota(wanted):
+        rem=remaining_work()
+        return wanted if rem is None else min(wanted,rem)
+    def record(kind,before,after,tic):
+        phases.append(dict(name=kind,expanded=after.expanded-before,
+            total_work=session.expanded+local_work,wall_s=perf_counter()-tic,
+            J=after.J,Pd=after.Pd,status=after.status,stop_reason=after.stop_reason,
+            frontier=session.frontier_count))
+    def annotate_events():
+        for event in session.incumbent_history+session.candidate_archive:
+            if 'global_expanded_at_accept' not in event:
+                event['global_expanded_at_accept']=event['expanded']
+                event['expanded']+=local_work
+                event['work_expanded']=event['expanded']
+    def global_step(work,until):
+        nonlocal resumed,peak
+        held=0 if roll is None else roll.frontier_count
+        session.max_open=None if max_open is None else max(0,max_open-held)
+        before=session.expanded;tic=perf_counter()
+        result=session.advance(max_expansions=work,deadline=until)
+        peak=max(peak,held+result.stats.get('advance_peak_open',0))
+        annotate_events()
+        record("global_stdc",before,result,tic)
+        if attempted_old and result.expanded>before:resumed=True
+        return result
+    result=session.finish()
+    while True:
+        if perf_counter()>=deadline:
+            result=session.finish(stop_reason="max_seconds");break
+        rem=remaining_work()
+        if rem==0:
+            result=session.finish(stop_reason="max_expansions");break
+        if result.status in ("completed","budget_exceeded"):break
+        if schedule=="recycle" and not attempted_old:
+            seed_quota=None if max_expansions is None else int(.4*max_expansions)
+            seed_deadline=started+(.4*max_seconds) if max_seconds is not None else inf
+            result=global_step(seed_quota,min(deadline,seed_deadline))
+            attempted_old=True
+            if result.status in ("completed","budget_exceeded"):continue
+            available=None if max_open is None else max(0,max_open-session.frontier_count)
+            if available==0:continue
+            from .midpoint_rollout import search_midpoint
+            tic=perf_counter()
+            local=search_midpoint(grid,**cfg,initial_path=session.path,bound=bound,
+                beam_width=24,diversity=False,max_expansions=remaining_work(),
+                max_seconds=max(0,deadline-perf_counter()) if deadline!=inf else None,
+                max_open=available)
+            local_work+=local.expanded;local_generated+=local.generated;local_pruned+=local.pruned
+            peak=max(peak,session.frontier_count+local.peak_open)
+            session.inject_incumbent(local.path,source="midpoint_rollout")
+            annotate_events()
+            phases.append(dict(name="old_midpoint",expanded=local.expanded,
+                total_work=session.expanded+local_work,wall_s=perf_counter()-tic,
+                J=local.J,Pd=local.Pd,status=local.status,stop_reason=local.stop_reason,
+                stats=local.stats,incumbent_history=local.incumbent_history))
+            continue
+        result=global_step(quota(global_chunk),deadline)
+        if schedule!="bursts" or result.status in ("completed","budget_exceeded"):
+            continue
+        if session.expanded<next_local_global:continue
+        # Limit local work to a fraction of already paid global work; no free seed.
+        allowance=int(session.expanded*local_fraction/(1-local_fraction))-local_work
+        if allowance<=0 or quota(min(burst_work,allowance))==0:continue
+        if session.incumbent_source=="initial_path":continue
+        available=None if max_open is None else max(0,max_open-session.frontier_count)
+        if available==0:continue
+        from .short_window_rollout import BurstRollout
+        if roll is None:
+            roll=BurstRollout(grid,**cfg,initial_path=session.path,
+                quality_width=24,diversity_slots=diversity_slots,
+                lazy_bound=lazy_rollout,trace=trace)
+        else:roll.set_incumbent(session.path)
+        before=roll.expanded;before_generated=roll.generated;before_pruned=roll.pruned;tic=perf_counter()
+        windows_before=roll.stats['windows_completed'];previous_J=session.J
+        local=roll.advance(max_expansions=quota(min(burst_work,allowance)),
+            deadline=min(deadline,perf_counter()+.1),max_open=available)
+        used=local.expanded-before;local_work+=used
+        local_generated+=local.generated-before_generated;local_pruned+=local.pruned-before_pruned
+        peak=max(peak,session.frontier_count+local.stats.get('advance_peak_open',local.peak_open))
+        session.inject_incumbent(local.path,source="short_window_rollout")
+        annotate_events()
+        if session.J<previous_J-ATOL:
+            local_stalls=0
+            next_local_global=session.expanded+global_chunk
+        elif roll.stats['windows_completed']>windows_before or roll.done:
+            local_stalls+=1
+            next_local_global=session.expanded+global_chunk*min(4,2**min(local_stalls,2))
+        phases.append(dict(name="short_window",expanded=used,total_work=session.expanded+local_work,
+            wall_s=perf_counter()-tic,J=local.J,Pd=local.Pd,status=local.status,
+            stop_reason=local.stop_reason,stats=dict(local.stats),incumbent_history=local.incumbent_history))
+    annotate_events()
+    result=session.finish(stop_reason=result.stop_reason if result.status=="budget_exceeded" else None)
+    result.expanded+=local_work;result.generated+=local_generated;result.pruned+=local_pruned
+    result.peak_open=max(result.peak_open,peak)
+    for e in result.incumbent_history+result.candidate_archive:
+        e["elapsed_s"]+=session_offset
+    result.stats.update(work_expanded=result.expanded,global_expanded=session.expanded,
+        local_expanded=local_work,global_resumed_after_rollout=resumed,
+        dp_fallback=prep.get("dp_fallback",False),dp_kind=dp_kind,
+        physical_open_scope="simultaneously retained global and local states",
+        original_goal_unchanged=True,global_epsilon_certified=False,
+        local_stalls=local_stalls,local_fraction_cap=local_fraction,
+        phase_count=len(phases),method_preprocessing_s=prep["method_preprocessing_s"])
+    if roll is not None:result.stats["rollout"]=dict(roll.stats)
+    if guide is not None:result.stats["guide_memory"]=guide.cache_info()
+    elif hasattr(session.guide,'_reachable'):
+        rings=session.guide._reachable
+        result.stats['guide_memory']=dict(reach_array_bytes=sum(a.nbytes for rows in rings.values() for a in rows),
+            vertices=len(rings),scope='reference retained integer reach arrays; Python objects excluded')
+    stdc_impl=getattr(stdc_component,'_stdc',None)
+    if stdc_impl is not None:
+        result.stats['stdc_geometry_memory']=dict(stdc_impl.geometry_cache_info(),
+            distance_array_bytes=sum(a.nbytes for a in stdc_impl._distances.values()))
+    result.wall_s=perf_counter()-started
+    result.stats["deadline_overshoot_s"]=max(0,started+result.wall_s-deadline)
+    return result,phases,prep,result.wall_s
+

diff --git a/asar_repro/src/asar_repro/additional_forcing.py b/asar_repro/src/asar_repro/additional_forcing.py
new file mode 100644
index 0000000..3616f73
--- /dev/null
+++ b/asar_repro/src/asar_repro/additional_forcing.py
@@ -0,0 +1,202 @@
+"""Audited additional historical surface forcing. Frozen readers stay unchanged.
+
+ROMS: arithmetic two-face collocation on interior rho nodes, rotate xi/eta
+to east/north at those nodes, then interpolate on native-topology triangles.
+No extrapolation, coastal fill, hidden velocity fallback, or ice drift.
+"""
+from datetime import datetime, timezone
+import json
+from pathlib import Path
+
+from netCDF4 import Dataset, num2date
+import numpy as np
+from pyproj import Proj
+from shapely import STRtree, points, polygons
+
+from .forcing import SurfaceField, Rectilinear, HistoricalForcing, numeric, longitude
+from .hrrr import f00_wind, require
+from .opendrift_adapter import utc_datetime
+from .scenarios import digest
+
+MANIFEST_SHA='2d306909585ffd95992634ddc1e939d64d9af15c50f94547aadc55ca01f3d8fa'
+SCENARIOS=('arctic_ocean','bay_of_fundy')
+
+
+def checked_sources(root, name):
+    root=Path(root);path=root/'data/manifests/historical_sources_additional_b1.json'
+    require(digest(path)==MANIFEST_SHA,'additional B1 manifest fingerprint changed')
+    doc=json.loads(path.read_text(encoding='utf-8'))
+    require(digest(root/'configs/stage7_scenarios.yaml')==doc['config_sha256'],'mission fingerprint changed')
+    require(name in SCENARIOS,'unsupported additional scenario')
+    case=next(c for c in doc['scenarios'] if c['scenario']==name)
+    require(case['pair_status']=='verified' and case['verification_scope']=='B1_delivered_files_local'
+            and case['forcing_kind']=='historical_real','B1 pair not verified')
+    for role in ('wind','current'):
+        for row in case[role]['local_files']:
+            require(digest(root/row['local_path'])==row['sha256'],'forcing SHA mismatch: '+row['local_path'])
+    return case
+
+
+def cf_times(var, expected):
+    require(getattr(var,'calendar','standard') in ('standard','gregorian','proleptic_gregorian'),'calendar')
+    values=numeric(var[:]);require(np.isfinite(values).all(),'missing times')
+    # CF time units without an explicit zone default to UTC; verify against B1 UTC records.
+    converted=num2date(values,var.units,calendar=getattr(var,'calendar','standard'))
+    result=tuple(datetime(t.year,t.month,t.day,t.hour,t.minute,t.second,t.microsecond,tzinfo=timezone.utc) for t in converted)
+    require(result==tuple(map(utc_datetime,expected)),'decoded UTC differs from B1 valid times')
+    return result
+
+
+def mission_roi(case, buffer_m=150000):
+    xy=np.asarray([case['mission'][k] for k in ('lkp_lon_lat','csp_lon_lat')])
+    dy=buffer_m/110000;dx=buffer_m/(110000*np.cos(np.deg2rad(xy[:,1].mean())))
+    return [float(xy[:,0].min()-dx),float(xy[:,0].max()+dx),float(xy[:,1].min()-dy),float(xy[:,1].max()+dy)]
+
+
+def wind_field(root, case):
+    files=sorted(case['wind']['local_files'],key=lambda r:r['valid_utc'])
+    times=[];frames=[];geometry=None;roi=mission_roi(case)
+    for row in files:
+        data=(root/row['local_path']).read_bytes()
+        if case['scenario']=='arctic_ocean':
+            from b1_gfs import decode
+            d=decode(data);time=d['valid'];proj=None
+            ox=np.argsort(longitude(d['lon']));oy=np.argsort(d['lat'])
+            x=longitude(d['lon'])[ox];y=d['lat'][oy];raw=d['uv']
+            full=raw[oy][:,ox];basis='geographic_east_north'
+            require(d['cycle']==utc_datetime(row['run_cycle_utc']) and d['lead_hours']==row['lead_hours'],'GFS cycle/lead')
+        else:
+            time,_,proj,x,y,raw=f00_wind(data);full=raw;basis='grid_relative'
+        require(time==utc_datetime(row['valid_utc']),'wind valid time differs')
+        # Independent B1/ecCodes native-node controls, before crop or rotation.
+        for k,comp in enumerate(('10u','10v')):
+            for ref in row['components'][comp]['points'].values():
+                require(abs(float(raw.reshape(-1,2)[ref['flat_index'],k])-ref['native_component_m_s'])<1e-10,'native wind reference mismatch')
+        lon=np.r_[np.linspace(roi[0],roi[1],25),np.linspace(roi[0],roi[1],25),np.full(25,roi[0]),np.full(25,roi[1])]
+        lat=np.r_[np.full(25,roi[2]),np.full(25,roi[3]),np.linspace(roi[2],roi[3],25),np.linspace(roi[2],roi[3],25)]
+        xx,yy=(lon,lat) if proj is None else proj(lon,lat)
+        i0=max(0,np.searchsorted(x,min(xx))-2);i1=min(len(x),np.searchsorted(x,max(xx))+3)
+        j0=max(0,np.searchsorted(y,min(yy))-2);j1=min(len(y),np.searchsorted(y,max(yy))+3)
+        key=(i0,i1,j0,j1)
+        if geometry is None:geometry=key;grid=Rectilinear(x[i0:i1].copy(),y[j0:j1].copy(),proj)
+        require(key==geometry and np.array_equal(grid.x,x[i0:i1]) and np.array_equal(grid.y,y[j0:j1]),'wind grid changes')
+        frames.append(full[j0:j1,i0:i1].copy());times.append(time)
+    return SurfaceField('wind',tuple(times),grid,np.stack(frames),files,
+        dict(vector_basis=basis,native_variables=['UGRD','VGRD'],height_m=10,
+             spatial_method='native bilinear; HRRR rotation at query using meridian convergence',
+             in_memory_crop_indices=list(map(int,geometry)),roi_lon_lat=roi,
+             original_bytes_unchanged=True,native_reference_checks=2*2*len(files)),
+        max_gap_s=10800 if case['scenario']=='arctic_ocean' else 3600)
+
+
+def hycom_field(root, files):
+    times=[];frames=[];lon=lat=None;ice=[]
+    for row in files:
+        with Dataset('hycom.nc',memory=(root/row['local_path']).read_bytes()) as ds:
+            x=longitude(numeric(ds['lon'][:]));y=numeric(ds['lat'][:])
+            if lon is None:lon,lat=x,y
+            require(np.array_equal(x,lon) and np.array_equal(y,lat),'HYCOM grid changes')
+            times.extend(cf_times(ds['time'],row['valid_times_utc']))
+            uv=[]
+            for key,standard in (('ssu','eastward_sea_water_velocity'),('ssv','northward_sea_water_velocity')):
+                v=ds[key]
+                require(v.dimensions==('time','lat','lon') and v.units=='m/s' and v.standard_name==standard,'HYCOM mapping')
+                uv.append(numeric(v[:]))  # netCDF4 has already applied exactly one CF unpack.
+            ice_values=numeric(ds['sic'][:]);wet=np.isfinite(uv[0])&np.isfinite(uv[1])
+            require(ds['sic'].standard_name=='sea_ice_area_fraction' and ds['sic'].units=='1','HYCOM ice mapping')
+            require(np.isfinite(ice_values[wet]).all() and np.all(ice_values[wet]==0),'nonzero or unknown ice: this Leeway experiment has no ice interaction model')
+            require(np.array_equal(np.isfinite(uv[0]),np.isfinite(uv[1])),'HYCOM component masks differ')
+            frames.extend(np.stack(uv,axis=-1));ice.append(float(np.max(ice_values[wet])))
+    order=np.argsort([t.timestamp() for t in times]);times=tuple(times[i] for i in order)
+    return SurfaceField('current',times,Rectilinear(lon,lat),np.stack(frames)[order],files,
+        dict(vector_basis='geographic_east_north',native_variables=['ssu','ssv'],
+             spatial_method='bilinear on native longitude/latitude; masks retained',
+             ice_max=ice,ice_policy='zero verified on all native wet samples; no sea-ice velocity used',
+             missing_policy='NaN velocities -> unknown; never fill zero',CF_unpack_count=1),max_gap_s=3600)
+
+
+def collocate_rotate(u,v,angle,rho_wet,u_wet,v_wet):
+    """Two native faces per interior rho node; missing coastal stencils remain invalid."""
+    shape=angle.shape;require(u.shape==(*rho_wet.shape[:-2],shape[0],shape[1]-1) and
+        v.shape==(*rho_wet.shape[:-2],shape[0]-1,shape[1]),'ROMS staggered dimensions')
+    require(u_wet.shape==u.shape and v_wet.shape==v.shape and rho_wet.shape[-2:]==shape,'ROMS mask dimensions')
+    ur=.5*(u[...,1:-1,:-1]+u[...,1:-1,1:])
+    vr=.5*(v[...,:-1,1:-1]+v[...,1:,1:-1])
+    wet=rho_wet[...,1:-1,1:-1].astype(bool)
+    faces=u_wet[...,1:-1,:-1]&u_wet[...,1:-1,1:]&v_wet[...,:-1,1:-1]&v_wet[...,1:,1:-1]
+    valid=wet&faces&np.isfinite(ur)&np.isfinite(vr)
+    a=angle[1:-1,1:-1];c,s=np.cos(a),np.sin(a)
+    east=c*ur-s*vr;north=s*ur+c*vr
+    status=np.where(~wet,0,np.where(valid,1,2))
+    return np.stack((np.where(valid,east,np.nan),np.where(valid,north,np.nan),status),axis=-1)
+
+
+class TopologyTriangles:
+    """Piecewise affine on two fixed triangles per native quadrilateral; no Delaunay bridging."""
+    def __init__(self,lon,lat,projection):
+        require(lon.shape==lat.shape and lon.ndim==2 and min(lon.shape)>=2,'curvilinear geometry shape')
+        self.shape=lon.shape;self.projection=projection
+        x,y=projection(lon,lat);self.xy=np.column_stack((x.ravel(),y.ravel()))
+        ids=np.arange(lon.size).reshape(lon.shape);a=ids[:-1,:-1].ravel();b=ids[:-1,1:].ravel();c=ids[1:,1:].ravel();d=ids[1:,:-1].ravel()
+        self.tri=np.concatenate((np.column_stack((a,b,c)),np.column_stack((a,c,d))))
+        coords=self.xy[self.tri];self.origin=coords[:,0];m=np.stack((coords[:,1]-coords[:,0],coords[:,2]-coords[:,0]),axis=-1)
+        det=np.linalg.det(m);require(np.isfinite(m).all() and np.all(abs(det)>1e-6),'degenerate curvilinear triangles')
+        require(np.all(np.sign(det)==np.sign(det[0])),'folded curvilinear topology')
+        self.inverse=np.linalg.inv(m);self.tree=STRtree(polygons(coords))
+
+    def locate(self,lon,lat):
+        x,y=self.projection(lon,lat);query=np.column_stack((x,y))
+        pids,tids=self.tree.query(points(x,y),predicate='intersects')
+        chosen=np.full(len(query),len(self.tri),dtype=int);np.minimum.at(chosen,pids,tids)
+        inside=chosen<len(self.tri);safe=np.where(inside,chosen,0)
+        ab=np.einsum('nij,nj->ni',self.inverse[safe],query-self.origin[safe])
+        weights=np.column_stack((1-ab.sum(axis=1),ab))
+        weights=np.maximum(weights,0);weights/=weights.sum(axis=1)[:,None]
+        return safe,weights,inside
+
+    def sample(self,values,location):
+        chosen,w,inside=location
+        nodes=values.reshape(-1,3)[self.tri[chosen]];used=w>1e-12
+        state=nodes[:,:,2]
+        good=np.all(~used|(state==1),axis=1);dry=np.all(~used|(state==0),axis=1)
+        result=np.sum(np.where(used[:,:,None],nodes[:,:,:2],0)*w[:,:,None],axis=1)
+        status=np.where(~inside,'outside_mesh',np.where(dry,'dry',np.where(good,'ok','masked_stencil')))
+        return np.where((status=='ok')[:,None],result,np.nan),status
+
+
+def gomofs_field(root, files, case):
+    require(len(files)==1,'expected delivered time-concatenated GoMOFS file')
+    row=files[0];roi=mission_roi(case)
+    with Dataset('gomofs.nc',memory=(root/row['local_path']).read_bytes()) as ds:
+        times=cf_times(ds['ocean_time'],row['valid_times_utc'])
+        lon,lat=numeric(ds['lon_rho'][:]),numeric(ds['lat_rho'][:])
+        use=(lon>=roi[0])&(lon<=roi[1])&(lat>=roi[2])&(lat<=roi[3]);jj,ii=np.nonzero(use)
+        require(len(jj)>0,'mission ROI outside GoMOFS')
+        j0=max(0,int(jj.min())-3);j1=min(lon.shape[0],int(jj.max())+4)
+        i0=max(0,int(ii.min())-3);i1=min(lon.shape[1],int(ii.max())+4)
+        angle=numeric(ds['angle'][j0:j1,i0:i1]);require(ds['angle'].units=='radians' and np.isfinite(angle).all(),'ROMS angle')
+        require(ds['u_sur'].standard_name=='sea_water_surface_x_velocity' and ds['v_sur'].standard_name=='sea_water_surface_y_velocity','ROMS vector basis')
+        require(ds['u_sur'].dimensions==('ocean_time','eta_u','xi_u') and ds['v_sur'].dimensions==('ocean_time','eta_v','xi_v'),'ROMS variable dimensions')
+        require(ds['u_sur'].units==ds['v_sur'].units=='meter second-1','ROMS units')
+        arrays={};masks={}
+        for g,ys,xs in [('rho',slice(j0,j1),slice(i0,i1)),('u',slice(j0,j1),slice(i0,i1-1)),('v',slice(j0,j1-1),slice(i0,i1))]:
+            static=numeric(ds['mask_'+g][ys,xs]);dynamic=numeric(ds['wetdry_mask_'+g][:,ys,xs])
+            require(np.isin(static,[0,1]).all() and np.isin(dynamic,[0,1]).all(),'ROMS mask values')
+            masks[g]=(static==1)&(dynamic==1)
+            if g!='rho':arrays[g]=numeric(ds[g+'_sur'][:,ys,xs])
+        values=collocate_rotate(arrays['u'],arrays['v'],angle,masks['rho'],masks['u'],masks['v'])
+        x,y=case['mission']['csp_lon_lat'];projection=Proj(proj='aeqd',lon_0=x,lat_0=y,datum='WGS84',units='m')
+        mesh=TopologyTriangles(lon[j0+1:j1-1,i0+1:i1-1],lat[j0+1:j1-1,i0+1:i1-1],projection)
+    return SurfaceField('current',times,mesh,values,files,
+        dict(vector_basis='geographic_east_north',native_variables=['u_sur','v_sur'],
+             spatial_method='native two-face mean at rho; angle rotation at rho; native-topology triangular interpolation',
+             rotation='east=cos(angle)*u-sin(angle)*v; north=sin(angle)*u+cos(angle)*v',
+             rho_crop=[j0+1,j1-1,i0+1,i1-1],wet_policy='static AND dynamic masks on rho/u/v; mixed or unsupported stencil unknown',
+             original_parent_files_reverified_locally=False,roi_lon_lat=roi),max_gap_s=3600)
+
+
+def load_additional_forcing(root, name, *, window=None):
+    root=Path(root);case=checked_sources(root,name)
+    wind=wind_field(root,case)
+    current=hycom_field(root,case['current']['local_files']) if name=='arctic_ocean' else gomofs_field(root,case['current']['local_files'],case)
+    return HistoricalForcing(wind,current,case['requested_window_utc'] if window is None else window,'historical_real'),case

diff --git a/asar_repro/src/asar_repro/anytime_search.py b/asar_repro/src/asar_repro/anytime_search.py
new file mode 100644
index 0000000..c76f6b1
--- /dev/null
+++ b/asar_repro/src/asar_repro/anytime_search.py
@@ -0,0 +1,209 @@
+"""Paper-guided anytime search with a separate, lazy admissible pruning bound.
+
+The paper heuristic orders OPEN only. It never prunes or terminates search.
+Every path retains its own belief; no depth/vertex or exact-state merging is
+performed. Complete improving candidates are replayed before acceptance.
+Results deliberately carry no full-route epsilon certificate.
+"""
+from dataclasses import dataclass, field
+from heapq import heappop, heappush
+from itertools import count
+from math import inf, isfinite
+from time import perf_counter
+
+from .belief import initial_belief, sensor_probabilities
+from .grid import integer
+from .heuristic import Heuristic
+from .objective import score_path
+
+ATOL = 1e-10
+BOUND_MODES = ("zero", "mass_lb", "stdc_lb")
+
+
+@dataclass
+class AnytimeResult:
+    path: tuple | None
+    J: float | None
+    Pd: float | None
+    expanded: int
+    generated: int
+    pruned: int
+    peak_open: int
+    status: str
+    stop_reason: str | None
+    incumbent_source: str | None
+    guide_weight: float
+    bound_mode: str
+    theory_certified: bool = False
+    incumbent_history: list = field(default_factory=list)
+    stats: dict = field(default_factory=dict)
+    wall_s: float = 0.0
+    completion_reason: str | None = None
+
+
+def search_anytime(grid, *, start, budget, p, q, motion, initial_path=None,
+                   guide_weight=1.04, bound_mode="stdc_lb", max_expansions=None,
+                   max_seconds=None, max_open=None, trace=None):
+    """Continue past every goal; prune only with unweighted g + h_bound.
+
+    Limits cover initial/final replay, guides, lazy bounds and successor work.
+    Time is cooperative: replay a just-generated potential improvement even
+    at the deadline, then preserve it when stopping. Expanded counts actual
+    successor expansions, excluding popped nodes rejected by the bound.
+    """
+    started = perf_counter()
+    budget = integer(budget, "budget")
+    grid.coordinates(start)
+    if bound_mode not in BOUND_MODES:
+        raise ValueError("bound_mode must be zero, mass_lb or stdc_lb")
+    if not isfinite(guide_weight) or guide_weight < 1:
+        raise ValueError("guide_weight must be finite and >= 1")
+    for name, value in (("max_expansions", max_expansions), ("max_open", max_open)):
+        if value is not None:
+            integer(value, name)
+    if max_seconds is not None and (not isfinite(max_seconds) or max_seconds < 0):
+        raise ValueError("max_seconds must be finite and nonnegative")
+    deadline = inf if max_seconds is None else started + max_seconds
+    cfg = dict(start=start, budget=budget, p=p, q=q, motion=motion)
+    guide = Heuristic(grid, budget=budget, q=q, motion=motion, mode="paper_greedy")
+    bound = Heuristic(grid, budget=budget, q=q, motion=motion, mode=bound_mode)
+    sensor = sensor_probabilities(q, grid.size)
+    root_belief = initial_belief(p, motion.state_size)
+    queue, history, sequence = [], [], count()
+    expanded = generated = pruned = peak_open = 0
+    incumbent, incumbent_pd, best_path, source = inf, None, None, None
+    stats = dict(guide_calls=0, guide_wall_s=0.0, bound_calls=0, bound_wall_s=0.0,
+                 complete_candidates=0, candidate_replays=0, candidate_replay_wall_s=0.0,
+                 candidate_replay_error_J_max=0.0, candidate_replay_error_Pd_max=0.0,
+                 initial_replays=0, final_replays=0, replay_wall_s=0.0,
+                 accepted_improvements=0, popped=0, bound_pruned=0, cheap_pruned=0,
+                 max_generated_depth=0, max_expanded_depth=0,
+                 guide_used_for_pruning=False, guide_used_for_termination=False,
+                 state_merging=False, bound_is_unweighted=True,
+                 frontier_count_scope="physical queued nodes only; interrupted work is not enumerated")
+
+    def timed_out():
+        return "max_seconds" if perf_counter() >= deadline else None
+
+    def record(event, path, g, **extra):
+        if trace is not None:
+            trace(dict(event=event, vertex=path[-1], depth=len(path)-1, path=path,
+                       g=g, incumbent_J=None if best_path is None else incumbent, **extra))
+
+    def replay(path, kind):
+        tic = perf_counter()
+        result = score_path(grid, path, **cfg)
+        elapsed = perf_counter() - tic
+        stats[kind + "_replays"] += 1
+        stats["replay_wall_s"] += elapsed
+        if kind == "candidate":
+            stats["candidate_replay_wall_s"] += elapsed
+        return result
+
+    def accept(path, score, origin):
+        nonlocal incumbent, incumbent_pd, best_path, source
+        incumbent, incumbent_pd, best_path, source = score.J, score.pd_final, tuple(path), origin
+        history.append(dict(path=best_path, J=incumbent, Pd=incumbent_pd,
+                            expanded=expanded, generated=generated,
+                            elapsed_s=perf_counter()-started, source=origin))
+        record("incumbent", best_path, incumbent, source=origin)
+
+    def enqueue(path, belief, g):
+        nonlocal generated, pruned, peak_open
+        depth = len(path)-1
+        generated += int(depth > 0)
+        stats["max_generated_depth"] = max(stats["max_generated_depth"], depth)
+        if depth == budget:
+            stats["complete_candidates"] += 1
+            record("candidate", path, g)
+            # Conservative prediction guard; acceptance uses only replayed J.
+            if g < incumbent + ATOL:
+                score = replay(path, "candidate")
+                err_j, err_pd = abs(score.J-g), abs(score.pd_final-(1-float(belief.sum())))
+                if err_j > ATOL or err_pd > ATOL:
+                    raise AssertionError("complete candidate disagrees with independent replay")
+                stats["candidate_replay_error_J_max"] = max(stats["candidate_replay_error_J_max"], err_j)
+                stats["candidate_replay_error_Pd_max"] = max(stats["candidate_replay_error_Pd_max"], err_pd)
+                if score.J < incumbent - ATOL:
+                    stats["accepted_improvements"] += 1
+                    accept(path, score, "search")
+            return timed_out()  # Terminal candidates never enter OPEN.
+        if timed_out():
+            return "max_seconds"
+        if g >= incumbent + ATOL:
+            pruned += 1
+            stats["cheap_pruned"] += 1
+            record("cheap_prune", path, g)
+            return timed_out()
+        tic = perf_counter()
+        h_guide = guide(path[-1], depth, belief)
+        stats["guide_calls"] += 1
+        stats["guide_wall_s"] += perf_counter()-tic
+        priority = g + guide_weight*h_guide
+        if not isfinite(h_guide) or h_guide < -ATOL or not isfinite(priority):
+            raise ValueError("invalid or overflowing paper guide priority")
+        if timed_out():
+            return "max_seconds"
+        if max_open is not None and len(queue) >= max_open:
+            return "max_open"  # Stop the whole search; never drop a node and continue.
+        heappush(queue, (priority, next(sequence), path, belief, g))
+        peak_open = max(peak_open, len(queue))
+        record("push", path, g, h_guide=h_guide, f_guide=priority)
+        return timed_out()
+
+    if initial_path is not None:
+        initial_path = tuple(initial_path)
+        accept(initial_path, replay(initial_path, "initial"), "initial_path")
+    reason = enqueue((start,), root_belief, 0.0)
+    while queue and reason is None:
+        reason = timed_out()
+        if reason:
+            break
+        priority, _, path, belief, g = heappop(queue)
+        depth = len(path)-1
+        stats["popped"] += 1
+        record("pop", path, g, f_guide=priority)
+        reason = timed_out()
+        if reason:
+            break
+        tic = perf_counter()
+        h_bound = bound(path[-1], depth, belief)  # Lazy: never evaluate on enqueue.
+        stats["bound_calls"] += 1
+        stats["bound_wall_s"] += perf_counter()-tic
+        if not isfinite(h_bound) or h_bound < -ATOL:
+            raise ValueError("invalid admissible bound")
+        reason = timed_out()
+        if reason:
+            break
+        if g+h_bound >= incumbent+ATOL:
+            pruned += 1
+            stats["bound_pruned"] += 1
+            record("bound_prune", path, g, h_bound=h_bound, lower_bound=g+h_bound)
+            continue
+        if max_expansions is not None and expanded >= max_expansions:
+            reason = "max_expansions"
+            break
+        expanded += 1
+        stats["max_expanded_depth"] = max(stats["max_expanded_depth"], depth)
+        record("expand", path, g, h_bound=h_bound, lower_bound=g+h_bound)
+        prior = motion.propagate(belief, step=depth+1)
+        for vertex in grid.neighbors(path[-1]):
+            child = motion.sense(prior, vertex, sensor, depth+1)
+            reason = enqueue(path+(vertex,), child, g+float(child.sum()))
+            if reason:
+                break
+    if best_path is None and reason is None:
+        raise ValueError("no feasible path of the requested length")
+    if best_path is not None:
+        final = replay(best_path, "final")
+        if abs(final.J-incumbent) > ATOL or abs(final.pd_final-incumbent_pd) > ATOL:
+            raise AssertionError("final incumbent replay mismatch")
+        incumbent, incumbent_pd = final.J, final.pd_final
+    reason = reason or timed_out()
+    wall = perf_counter()-started
+    stats.update(frontier_remaining=len(queue), deadline_overshoot_s=max(0.0, started+wall-deadline))
+    return AnytimeResult(best_path, incumbent if best_path is not None else None, incumbent_pd,
+                         expanded, generated, pruned, peak_open,
+                         "budget_exceeded" if reason else "completed", reason, source,
+                         guide_weight, bound_mode, incumbent_history=history, stats=stats, wall_s=wall,
+                         completion_reason=None if reason else "frontier_exhausted_at_tolerance")

