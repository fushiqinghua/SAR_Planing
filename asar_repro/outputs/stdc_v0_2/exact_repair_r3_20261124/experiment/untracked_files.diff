+    lines+=['','## 验证','']
+    for stage,s in valid['stages'].items():lines.append('- '+stage+': '+str(s.get('test_counts',s.get('audit',{}))))
+    lines+=['','## 假设与局限','',
+        '固定历史粒子、4连通无等待、t0不探测、保留特殊格质量；固定前缀及空间走廊，终点自由。原目标仅最小化J，Pd独立评价，不改变为多目标。',
