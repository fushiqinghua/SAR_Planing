+        ('stdc_reuse','stdc_cache'), ('stdc_reuse','stdc_reference'),
+        ('stdc_reuse','paper_reference'), ('stdc_reuse','paper_reuse'),
+        ('stdc_reuse','mass_reuse')]
+    for eps in epsilons:
+        for rep in range(3):
+            group = {r['variant']:r for r in rows if r['epsilon']==eps and r['repeat']==rep}
