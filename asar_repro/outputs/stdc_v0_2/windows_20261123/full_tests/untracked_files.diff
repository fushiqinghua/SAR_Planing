+++ b/asar_repro/src/asar_repro/window_bounds.py
@@ -0,0 +1,227 @@
+"""Fixed-suffix coefficients and lower bounds for a fixed-time path window.
+
+These bounds apply to the chosen endpoint, end time and fixed suffix only.
+They do not certify global optimality of the full search-and-rescue route.
+All times are absolute frames: frame zero is before any observation.
+"""
+
+from dataclasses import dataclass
+from math import inf
+
+import numpy as np
+
+from .belief import float_array, sensor_probabilities, undetected_mass
+from .grid import GridGraph, integer
+from .motion import MatrixMotion, ParticleMotion
+
+
+WINDOW_MODES = ("zero", "mass_lb", "stdc_lb", "stdc_endpoint_lb")
+
+
+def _check_motion(grid, motion, horizon):
+    if not isinstance(motion, (MatrixMotion, ParticleMotion)):
+        raise ValueError("window bounds require MatrixMotion or ParticleMotion")
+    if grid.size != motion.size:
+        raise ValueError("motion grid size must match the search grid")
+    if isinstance(motion, ParticleMotion):
+        motion.check_horizon(horizon)
+    elif not motion._repeat and horizon > len(motion._matrices):
+        raise ValueError(f"missing P_t for step {horizon}")
+
+
+def _distances(grid, source):
+    row, col = grid.coordinates(source)
+    vertices = np.arange(grid.size, dtype=np.intp)
+    return np.abs(vertices // grid.cols - row) + np.abs(vertices % grid.cols - col)
+
+
+def _exact_mask(distances, steps, grid_size):
+    if steps == 0:
+        return distances == 0
+    if grid_size == 1:
+        return np.zeros(1, dtype=bool)  # A no-wait single vertex has no edges.
+    return (distances <= steps) & ((steps - distances) % 2 == 0)
+
+
+def exact_reachable(grid: GridGraph, source: int, steps: int) -> np.ndarray:
+    """Sorted vertex IDs after exactly ``steps`` four-neighbour, no-wait moves.
+
+    Unlike the original STDC helper, zero steps is defined and returns source.
+    A one-vertex graph has an empty reachable set at every positive step.
+    """
+    steps = integer(steps, "steps")
+    result = np.flatnonzero(_exact_mask(_distances(grid, source), steps, grid.size))
+    result.setflags(write=False)
+    return result
+
+
+@dataclass(frozen=True)
+class SuffixCoefficients:
+    """Nonnegative linear coefficients for an immutable path snapshot.
+
+    cost[d] excludes observations at or before d. Thus a complete candidate's
+    objective equals its accumulated g[d] plus cost[d] @ belief[d]. Its final
+    remaining mass is survival[d] @ belief[d]. Arrays are read-only.
+    """
+
+    cost: np.ndarray
+    survival: np.ndarray
+
+
+def suffix_coefficients(grid: GridGraph, path, *, q,
+                        motion: MatrixMotion | ParticleMotion) -> SuffixCoefficients:
+    """Build exact fixed-suffix cost and terminal-mass coefficients backwards.
+
+    With row-stochastic P_t, forward beliefs use D_t P_t.T b; its adjoint is
+    P_t D_t. This distinction is essential for non-symmetric dynamic kernels.
+    Particle weights retain their ID columns and use the supplied absolute
+    cell_ids[t]. Special bins never match a legal searched vertex.
+    """
+    path = tuple(path)
+    if not path:
+        raise ValueError("path must contain at least its starting vertex")
+    horizon = len(path) - 1
+    grid.validate_path(path, start=path[0], budget=horizon)
+    _check_motion(grid, motion, horizon)
+    sensor = sensor_probabilities(q, grid.size)
+    cost = np.zeros((horizon + 1, motion.state_size), dtype=np.float64)
+    survival = np.ones_like(cost)
+    for t in range(horizon, 0, -1):
+        vertex = path[t]
+        factors = np.ones(motion.state_size, dtype=np.float64)
+        if isinstance(motion, ParticleMotion):
+            factors[motion.cell_ids[t] == vertex] = 1.0 - sensor[vertex]
+            cost[t - 1] = factors * (1.0 + cost[t])
+            survival[t - 1] = factors * survival[t]
+        else:
+            factors[vertex] = 1.0 - sensor[vertex]
+            kernel = motion._matrices[0 if motion._repeat else t - 1]
+            cost[t - 1] = kernel @ (factors * (1.0 + cost[t]))
+            survival[t - 1] = kernel @ (factors * survival[t])
+    cost.setflags(write=False)
+    survival.setflags(write=False)
+    return SuffixCoefficients(cost=cost, survival=survival)
+
+
+class WindowHeuristic:
+    """Remaining window cost plus a fixed suffix's nonnegative terminal cost.
+
+    One instance fixes the endpoint, absolute end time, sensor and tail_cost.
+    Geometry is reused only within that instance; no belief-dependent estimate
+    is cached. If a caller changes the suffix, it must make a new instance.
+
+    In endpoint mode, every legal completion's kth vertex belongs to the
+    intersection of exact-k reachability from the current vertex and exact
+    (R-k) reachability from the fixed endpoint. Simultaneously sensing this
+    entire intersection gives a componentwise lower undetected belief. The
+    STDC mass recurrence lower-bounds each window cost, and tail_cost dotted
+    with the relaxed endpoint belief lower-bounds the unchanged suffix cost.
+    """
+
+    def __init__(self, grid: GridGraph, *, end_vertex: int, end_depth: int, q,
+                 motion: MatrixMotion | ParticleMotion, tail_cost,
+                 mode: str = "stdc_endpoint_lb"):
+        if mode not in WINDOW_MODES:
+            raise ValueError(f"unknown window heuristic: {mode}")
+        grid.coordinates(end_vertex)
+        self.grid = grid
+        self.end_vertex = int(end_vertex)
+        self.end_depth = integer(end_depth, "end_depth")
+        _check_motion(grid, motion, self.end_depth)
+        self.motion = motion
+        self.mode = mode
+        self.q = sensor_probabilities(q, grid.size).copy()
+        self.q.setflags(write=False)
+        tail = float_array(tail_cost, "tail_cost")
+        if (tail.shape != (motion.state_size,) or not np.all(np.isfinite(tail))
+                or np.any(tail < 0)):
+            raise ValueError("tail_cost must be a finite nonnegative state-sized vector")
+        self.tail_cost = tail.copy()
+        self.tail_cost.setflags(write=False)
+        self._tail_min = float(self.tail_cost.min())
+        self._end_distances = _distances(grid, self.end_vertex)
+        self._distances = {self.end_vertex: self._end_distances}
+        self._geometry = {}
+        # Avoid a division by q and retain the q=0/q=1 edge cases.
+        a = 1.0 - float(self.q.max())
+        self._mass_factors = [0.0]
+        self._mass_powers = [1.0]
+        for _ in range(self.end_depth):
+            self._mass_factors.append(a * (1.0 + self._mass_factors[-1]))
+            self._mass_powers.append(a * self._mass_powers[-1])
+
+    def _feasible(self, vertex, remaining):
+        if remaining == 0:
+            return vertex == self.end_vertex
+        if self.grid.size == 1:
+            return False
+        distance = int(self._end_distances[vertex])
+        return distance <= remaining and (remaining - distance) % 2 == 0
+
+    def _step_geometry(self, vertex, remaining, k):
+        key = (vertex, remaining if self.mode == "stdc_endpoint_lb" else None, k)
+        cached = self._geometry.get(key)
+        if cached is not None:
+            return cached
+        if vertex not in self._distances:
+            self._distances[vertex] = _distances(self.grid, vertex)
+        mask = _exact_mask(self._distances[vertex], k, self.grid.size)
+        if self.mode == "stdc_endpoint_lb":
+            mask &= _exact_mask(self._end_distances, remaining - k, self.grid.size)
+        reach = np.flatnonzero(mask)
+        # _feasible ensures a complete path exists, hence each intersection is
+        # nonempty. Treat an empty set as a model inconsistency, not zero cost.
+        if not reach.size:
+            raise ValueError("empty reachable set for a feasible window")
+        qr = self.q[reach]
+        miss = 1.0 - qr
+        factors = None
+        if isinstance(self.motion, ParticleMotion):
+            factors = np.ones(self.motion.bin_count, dtype=np.float64)
+            factors[reach] = miss
+            factors.setflags(write=False)
+        for array in (reach, qr, miss):
+            array.setflags(write=False)
+        value = (reach, qr, miss, float(qr.max()), factors)
+        self._geometry[key] = value
+        return value
+
+    def __call__(self, vertex: int, depth: int, belief) -> float:
+        self.grid.coordinates(vertex)
+        vertex = int(vertex)
+        depth = integer(depth, "depth")
+        if depth > self.end_depth:
+            raise ValueError("depth exceeds window end_depth")
+        b = undetected_mass(belief, self.motion.state_size)
+        remaining = self.end_depth - depth
+        if not self._feasible(vertex, remaining):
+            return inf
+        if remaining == 0:
+            return float(self.tail_cost @ b)
+        if self.mode == "zero":
+            return 0.0
+        mass = float(b.sum())
+        if self.mode == "mass_lb":
+            return float(mass * self._mass_factors[remaining]
+                         + self._tail_min * mass * self._mass_powers[remaining])
+
+        relaxed = b.copy()
+        no_search = b.copy()
+        ell = mass
+        total = 0.0
+        particles = isinstance(self.motion, ParticleMotion)
+        for k in range(1, remaining + 1):
+            t = depth + k
+            reach, qr, miss, qmax, factors = self._step_geometry(vertex, remaining, k)
+            if particles:
+                relaxed *= factors[self.motion.cell_ids[t]]
+            else:
+                relaxed = self.motion.propagate(relaxed, step=t)
+                relaxed[reach] *= miss
+                no_search = self.motion.propagate(no_search, step=t)
+            a = float(relaxed.sum())
+            mu = self.motion.cell_mass(no_search, t)
+            u = float(np.max(qr * mu[reach]))
+            ell = max(a, (1.0 - qmax) * ell, ell - u)
+            total += ell
+        return float(total + self.tail_cost @ relaxed)

diff --git a/asar_repro/src/asar_repro/window_search.py b/asar_repro/src/asar_repro/window_search.py
new file mode 100644
index 0000000..cf15b5b
--- /dev/null
+++ b/asar_repro/src/asar_repro/window_search.py
@@ -0,0 +1,279 @@
+"""Research-only, fixed-time endpoint-preserving route improvement.
+
+The objective/evaluator and global A^SAR remain unchanged. Local completion
+certifies neither a globally optimal route nor a global epsilon bound.
+"""
+from dataclasses import asdict, dataclass, field
+from heapq import heappop, heappush
+from itertools import count
+from math import inf, isfinite
+from time import perf_counter
+
+from .belief import sensor_probabilities
+from .grid import integer
+from .objective import score_path
+from .search import search_asar
+from .window_bounds import WINDOW_MODES, WindowHeuristic, suffix_coefficients
+
+ATOL = 1e-10
+
+
+@dataclass
+class WindowResult:
+    path: tuple
+    J: float
+    Pd: float
+    expanded: int
+    generated: int
+    pruned: int
+    peak_open: int
+    status: str
+    stop_reason: str | None
+    incumbent_source: str
+    theory_certified: bool = False
+    seed: dict = field(default_factory=dict)
+    windows: list = field(default_factory=list)
+    improvements: list = field(default_factory=list)
+    wall_s: float = 0.0
+    completion_reason: str | None = None
+    heuristic_evaluations: int = 0
+    complete_candidates: int = 0
+    accepted_replays: int = 0
+    deadline_overshoot_s: float = 0.0
+
+
+class _Budget:
+    def __init__(self, max_expansions, max_seconds, max_open):
+        self.started = perf_counter()
+        for name, value in (("max_expansions", max_expansions), ("max_open", max_open)):
+            if value is not None:
+                integer(value, name)
+        if max_seconds is not None and (not isfinite(max_seconds) or max_seconds < 0):
+            raise ValueError("max_seconds must be finite and nonnegative")
+        self.deadline = inf if max_seconds is None else self.started + max_seconds
+        self.cap = max_expansions
+        self.open_cap = max_open
+        self.expanded = self.generated = self.pruned = self.peak_open = 0
+        self.heuristic_evaluations = self.complete_candidates = self.accepted_replays = 0
+
+    def time_stop(self):
+        return "max_seconds" if perf_counter() >= self.deadline else None
+
+    def expansion_stop(self):
+        return self.time_stop() or ("max_expansions" if self.cap is not None
+                                    and self.expanded >= self.cap else None)
+
+
+def _settings(mode, lengths=None):
+    if mode not in WINDOW_MODES:
+        raise ValueError(f"unknown window mode: {mode}")
+    if lengths is not None:
+        lengths = tuple(integer(x, "window_length", minimum=1) for x in lengths)
+        if not lengths or len(set(lengths)) != len(lengths):
+            raise ValueError("window_lengths must be nonempty and unique")
+        return lengths
+
+
+def _finish(grid, cfg, path, expected, ledger, reason, source, seed, windows,
+            improvements, completion_reason):
+    # Mandatory full replay is included in wall time, even at a cooperative stop.
+    replay = score_path(grid, path, **cfg)
+    if abs(replay.J - expected.J) > ATOL or abs(replay.pd_final - expected.pd_final) > ATOL:
+        raise AssertionError("final independent replay mismatch")
+    reason = reason or ledger.time_stop()
+    wall = perf_counter() - ledger.started
+    return WindowResult(tuple(path), replay.J, replay.pd_final, ledger.expanded,
+        ledger.generated, ledger.pruned, ledger.peak_open,
+        "budget_exceeded" if reason else "completed", reason, source,
+        seed=seed, windows=windows, improvements=improvements, wall_s=wall,
+        completion_reason=None if reason else completion_reason,
+        heuristic_evaluations=ledger.heuristic_evaluations,
+        complete_candidates=ledger.complete_candidates,
+        accepted_replays=ledger.accepted_replays,
+        deadline_overshoot_s=max(0.0, ledger.started + wall - ledger.deadline))
+
+
+def _window(grid, cfg, path, a, b, mode, ledger, improvements):
+    """No state merging: every heap entry retains its full conditional belief."""
+    tic = perf_counter()
+    before = (ledger.expanded, ledger.generated, ledger.pruned)
+    original = tuple(path)
+    initial = score_path(grid, original, **cfg, record_beliefs=True)
+    current = initial
+    coeff = suffix_coefficients(grid, original, q=cfg['q'], motion=cfg['motion'])
+    estimate = WindowHeuristic(grid, end_vertex=original[b], end_depth=b,
+        q=cfg['q'], motion=cfg['motion'], tail_cost=coeff.cost[b], mode=mode)
+    sensor = sensor_probabilities(cfg['q'], grid.size)
+    prefix_g = float(initial.g[a])
+    seq = count()
+    queue = []
+    local_peak_open = 0
+    accepted_start = len(improvements)
+    reason = ledger.time_stop()
+
+    def enqueue(vertex, depth, belief, g, route):
+        nonlocal local_peak_open
+        # Match legacy A^SAR: generated materialized child states exclude roots.
+        ledger.generated += int(depth > a)
+        if depth == b:
+            if vertex != original[b]:
+                raise AssertionError("infeasible endpoint reached")
+            ledger.complete_candidates += 1
+            predicted_j = prefix_g + g + float(coeff.cost[b] @ belief)
+            predicted_pd = 1.0 - float(coeff.survival[b] @ belief)
+            if not isfinite(predicted_j) or not isfinite(predicted_pd):
+                raise AssertionError("non-finite exact suffix score")
+            # Replay possible improvements before a cooperative deadline stop;
+            # preserve every fully generated, validated improving incumbent.
+            nonlocal path, current
+            if predicted_j < current.J + ATOL:
+                candidate = original[:a] + route + original[b+1:]
+                replay = score_path(grid, candidate, **cfg)
+                err_j, err_pd = abs(replay.J-predicted_j), abs(replay.pd_final-predicted_pd)
+                if err_j > ATOL or err_pd > ATOL:
+                    raise AssertionError("exact suffix prediction disagrees with full replay")
+                if replay.J < current.J - ATOL:
+                    improvements.append(dict(a=a, b=b, old_J=current.J, J=replay.J,
+                        old_Pd=current.pd_final, Pd=replay.pd_final,
+                        prediction_error_J=err_j, prediction_error_Pd=err_pd,
+                        expanded_total=ledger.expanded, elapsed_s=perf_counter()-ledger.started,
+                        path=list(candidate), source=f"window[{a}:{b}]"))
+                    path, current = candidate, replay
+                    ledger.accepted_replays += 1
+            return ledger.time_stop()
+        if ledger.time_stop():
+            return "max_seconds"
+        ledger.heuristic_evaluations += 1
+        h = estimate(vertex, depth, belief)
+        if not isfinite(h) or h < -ATOL:
+            raise AssertionError("invalid bound on a feasible window prefix")
+        lower = prefix_g + g + h
+        if ledger.time_stop():
+            return "max_seconds"
+        # Conservative rounding guard: never prune using incumbent minus tol.
+        if lower >= current.J + ATOL:
+            ledger.pruned += 1
+            return None
+        if ledger.open_cap is not None and len(queue) >= ledger.open_cap:
+            return "max_open"
+        heappush(queue, (lower, next(seq), vertex, depth, belief, g, route))
+        ledger.peak_open = max(ledger.peak_open, len(queue))
+        local_peak_open = max(local_peak_open, len(queue))
+        return None
+
+    if reason is None:
+        reason = enqueue(original[a], a, initial.beliefs[a].copy(), 0.0, (original[a],))
+    while queue and reason is None:
+        lower, _, vertex, depth, belief, g, route = heappop(queue)
+        if lower >= current.J + ATOL:
+            ledger.pruned += 1
+            continue
+        reason = ledger.expansion_stop()
+        if reason:
+            break
+        ledger.expanded += 1
+        t = depth + 1
+        moved = cfg['motion'].propagate(belief, step=t)
+        for nxt in grid.neighbors(vertex):
+            # Common exact endpoint feasibility is independent of heuristic.
+            if not estimate._feasible(nxt, b-t):
+                ledger.pruned += 1
+                continue
+            detected = cfg['motion'].sense(moved, nxt, sensor, step=t)
+            reason = enqueue(nxt, t, detected, g+float(detected.sum()), route+(nxt,))
+            if reason:
+                break
+    reason = reason or ledger.time_stop()
+    record = dict(a=a, b=b, mode=mode, initial_J=initial.J, final_J=current.J,
+        status="budget_exceeded" if reason else "completed", stop_reason=reason,
+        expanded=ledger.expanded-before[0], generated=ledger.generated-before[1],
+        pruned=ledger.pruned-before[2], improvements=len(improvements)-accepted_start,
+        peak_open=local_peak_open, wall_s=perf_counter()-tic, neighborhood_only=True)
+    return tuple(path), current, reason, record
+
+
+def solve_window(grid, *, start, budget, p, q, motion, path, a, b,
+                 mode="stdc_endpoint_lb", max_expansions=None, max_seconds=None,
+                 max_open=None):
+    """Solve one fixed window with an exact unchanged suffix; useful for Oracle checks."""
+    ledger = _Budget(max_expansions, max_seconds, max_open)
+    _settings(mode)
+    a, b = integer(a, "a"), integer(b, "b")
+    if not 0 <= a < b <= budget:
+        raise ValueError("window must satisfy 0 <= a < b <= budget")
+    cfg = dict(start=start, budget=budget, p=p, q=q, motion=motion)
+    improvements = []
+    path, score, reason, record = _window(grid, cfg, tuple(path), a, b, mode, ledger, improvements)
+    source = improvements[-1]['source'] if improvements else "initial_path"
+    return _finish(grid, cfg, path, score, ledger, reason, source, {}, [record],
+                   improvements, "fixed_window_exhausted_at_tolerance")
+
+
+def improve_with_windows(grid, *, start, budget, p, q, motion, initial_path,
+                         epsilon=1.1, mode="stdc_endpoint_lb", window_lengths=(4, 6),
+                         seed_max_expansions=1500, max_expansions=5000,
+                         max_open=20000, max_seconds=30):
+    """Pay for a paper seed, then perform deterministic local improvement sweeps.
+
+    Seed expansion subquota is an explicit method allocation. Seed time/OPEN
+    stops remain global stops. All queues share one total expansion/time cap;
+    OPEN is the peak physical queue size across the sequential search phases.
+    Acceptance minimizes the original full J, without adding a Pd constraint.
+    """
+    ledger = _Budget(max_expansions, max_seconds, max_open)
+    lengths = _settings(mode, window_lengths)
+    seed_max_expansions = integer(seed_max_expansions, "seed_max_expansions")
+    cfg = dict(start=start, budget=budget, p=p, q=q, motion=motion)
+    path = tuple(initial_path)
+    score = score_path(grid, path, **cfg)
+    reason = ledger.time_stop()
+    source, seed, windows, improvements = "initial_path", {}, [], []
+    if reason is None:
+        seed_cap = seed_max_expansions if ledger.cap is None else min(seed_max_expansions, ledger.cap)
+        tic = perf_counter()
+        seeded = search_asar(grid, **cfg, initial_path=path, heuristic="paper_greedy",
+            epsilon=epsilon, max_expansions=seed_cap, max_open=max_open,
+            max_seconds=None if ledger.deadline == inf else max(0., ledger.deadline-perf_counter()))
+        seed = dict(**asdict(seeded), cap_kind="method_subbudget", expansion_quota=seed_cap,
+                    wall_s=perf_counter()-tic, phase_budget_exceeded=seeded.status=="budget_exceeded")
+        ledger.expanded, ledger.generated, ledger.pruned = seeded.expanded, seeded.generated, seeded.pruned
+        ledger.peak_open = seeded.peak_open
+        path = tuple(seeded.path)
+        score = score_path(grid, path, **cfg)
+        if abs(score.J-seeded.J) > ATOL:
+            raise AssertionError("seed replay mismatch")
+        source = "seed_search" if seeded.incumbent_source == "search" else "initial_path"
+        if seeded.stop_reason and seeded.stop_reason != "max_expansions":
+            reason = seeded.stop_reason
+        reason = reason or ledger.expansion_stop()
+        seed['remaining_global_expansions'] = None if ledger.cap is None else ledger.cap-ledger.expanded
+        seed['continuing_after_subquota'] = seeded.stop_reason == "max_expansions" and reason is None
+    stalled = False
+    sweep = 0
+    while reason is None:
+        changed = False
+        for length in lengths:
+            for a in range(max(0, budget-length+1)):
+                reason = ledger.expansion_stop()
+                if reason:
+                    break
+                before = len(improvements)
+                path, score, reason, row = _window(grid, cfg, path, a, a+length,
+                                                  mode, ledger, improvements)
+                row['sweep'] = sweep
+                windows.append(row)
+                if len(improvements) > before:
+                    changed = True
+                    source = improvements[-1]['source']
+                if reason:
+                    break
+            if reason:
+                break
+        if reason:
+            break
+        if not changed:
+            stalled = True
+            break
+        sweep += 1
+    return _finish(grid, cfg, path, score, ledger, reason, source, seed, windows,
+                   improvements, "local_stalled_at_tolerance" if stalled else None)

diff --git a/asar_repro/tests/test_window_bounds.py b/asar_repro/tests/test_window_bounds.py
new file mode 100644
index 0000000..6a72930
--- /dev/null
+++ b/asar_repro/tests/test_window_bounds.py
@@ -0,0 +1,287 @@
+"""Window bounds checked with independent DFS and the frozen path evaluator."""
+
+from dataclasses import replace
+import math
+
+import numpy as np
+import pytest
+
+from asar_repro.grid import GridGraph
+from asar_repro.motion import MatrixMotion, ParticleMotion
+from asar_repro.window_bounds import WindowHeuristic, exact_reachable, suffix_coefficients
+from audit_window_bounds import (
+    MODES, ToyCase, audit_case, enumerate_window_oracle, legal_window_prefixes,
+    make_random_case, replay,
+)
+
+
+def static_case(*, q=1.0):
+    return ToyCase("matrix", 0, GridGraph(2, 2), (0, 1, 3, 1), 0, 2,
+                   np.array([0.0, 0.5, 0.5, 0.0]), q,
+                   MatrixMotion.identity(4), "hand_calculated_static")
+
+
+def dynamic_case():
+    grid = GridGraph(2, 2)
+    base = np.array([[1, 2, 3, 4], [4, 1, 1, 2],
+                     [0, 2, 7, 1], [1, 0, 1, 6]], dtype=float)
+    base /= base.sum(axis=1, keepdims=True)
+    matrices = [np.roll(np.roll(base, step % 4, axis=0), (2 * step + 1) % 4, axis=1)
+                for step in range(5)]
+    return ToyCase("matrix", 1, grid, (0, 1, 3, 2, 0, 1), 1, 3,
+                   np.array([0.1, 0.2, 0.3, 0.4]),
+                   np.array([0.0, 0.25, 0.6, 1.0]),
+                   MatrixMotion.time_varying(matrices), "asymmetric_absolute_time")
+
+
+def particle_case(*, q=None):
+    # IDs deliberately differ from array positions. Last four columns retain
+    # mass in distinct special bins; observations may only act on grid cells.
+    cells = np.array([
+        [0, 1, 2, 3, 4, 5, 6, 7],
+        [1, 0, 3, 2, 4, 5, 6, 7],
+        [2, 3, 0, 1, 4, 5, 6, 7],
+        [1, 2, 3, 0, 4, 5, 6, 7],
+        [0, 1, 2, 3, 4, 5, 6, 7],
+    ])
+    motion = ParticleMotion(cells, 4, np.array([91, 17, 64, 3, 58, 2, 101, 11]))
+    sensor = np.array([0.0, 0.25, 0.78, 1.0]) if q is None else q
+    return ToyCase("particle", 2, GridGraph(2, 2), (0, 1, 3, 2, 0), 1, 3,
+                   np.array([0.1, 0.2, 0.15, 0.05, 0.1, 0.1, 0.2, 0.1]),
+                   sensor, motion, "hand_particle_special_bins")
+
+
+def assert_suffix_replays(case):
+    coefficients = suffix_coefficients(case.grid, case.reference_path,
+                                       q=case.q, motion=case.motion)
+    assert coefficients.cost.shape == (case.horizon + 1, case.motion.state_size)
+    assert coefficients.survival.shape == coefficients.cost.shape
+    assert not coefficients.cost.flags.writeable
+    assert not coefficients.survival.flags.writeable
+    np.testing.assert_array_equal(coefficients.cost[-1], 0)
+    np.testing.assert_array_equal(coefficients.survival[-1], 1)
+    assert np.all(coefficients.cost >= 0)
+    assert np.all(coefficients.survival >= 0)
+    # Point masses also check all source coordinates, avoiding a coincidental
+    # cancellation for one particular initial probability vector.
+    for initial in [case.p, *np.eye(case.motion.state_size)]:
+        score = replay(replace(case, p=initial), case.reference_path)
+        for depth in range(case.horizon + 1):
+            assert score.g[depth] + coefficients.cost[depth] @ score.beliefs[depth] == pytest.approx(score.J, abs=1e-12, rel=0)
+            assert coefficients.survival[depth] @ score.beliefs[depth] == pytest.approx(score.survival[-1], abs=1e-12, rel=0)
+    return coefficients
+
+
+def test_hand_calculated_static_suffix_and_t0():
+    case = ToyCase("matrix", 3, GridGraph(1, 3), (0, 1, 2, 1), 0, 2,
+                   np.array([0.5, 0.3, 0.2]), 1.0,
+                   MatrixMotion.identity(3), "hand_static")
+    score = replay(case, case.reference_path)
+    np.testing.assert_allclose(score.survival, [1.0, 0.7, 0.5, 0.5])
+    assert score.J == pytest.approx(1.7)
+    assert score.pd_final == pytest.approx(0.5)
+    coefficients = assert_suffix_replays(case)
+    np.testing.assert_array_equal(coefficients.cost[0], [3.0, 0.0, 1.0])
